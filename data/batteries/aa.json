  "interchange": [
    {
      "id": "14500",
      "relation": "do-not-substitute",
      "note": "A 14500 lithium-ion battery is the same width and length as an AA but runs at 3.7 V, which damages most devices built for 1.5 V batteries."
    },
    {
      "id": "er14505",
      "relation": "do-not-substitute",
      "note": "The ER14505 lithium thionyl chloride battery is AA-sized but delivers 3.6 V, which damages devices built for 1.5 V batteries."
    },
    {
      "id": "aaa",
      "relation": "does-not-fit",
      "note": "AAA batteries are also 1.5 V alkaline but are smaller, and do not work in place of AA batteries."
    },
    {
      "id": "2-3aa",
      "relation": "does-not-fit",
      "note": "A 2/3AA battery is as wide as an AA but about 22 mm shorter, so it is not a drop-in for an AA battery."
    }
  ],
  "safety": [
    "Do not mix chemistries, brands or charge states in one device.",
    "Only NiMH, NiCd, nickel-zinc and USB-rechargeable lithium-ion AA batteries are designed to be recharged; charging alkaline, zinc-carbon or lithium iron disulfide AA batteries can cause leakage or rupture.",
    "Nickel-zinc batteries (1.6 V) and Oxyride batteries (1.7 V initial) start above 1.5 V and can mislead battery gauges."
  ],
  "notes": "The most widely used consumer battery size. The size letter predates IEC; IEC names the size 6 and prefixes a chemistry letter. JIS UM-3 names the zinc-carbon battery and AM-3 the alkaline battery.",
