---
import '../styles/global.css';
import Search from '../components/Search.astro';
import Mark from '../components/Mark.astro';
import { paid } from '../lib/buy';

export interface Props {
  title?: string;
  description?: string;
  jsonld?: object | object[];
  wide?: boolean;
  noindex?: boolean;
}

const {
  title = 'batteries.fyi: every consumer battery, measured and cited',
  description = 'Specifications, 3D models, dimensions and cross-reference codes for every consumer battery size, from AA to CR2032 to 18650. Sourced from IEC standards and manufacturer datasheets.',
  jsonld,
  noindex = false,
} = Astro.props;

const nav = [
  { href: '/batteries', label: 'Batteries' },
  { href: '/devices', label: 'Devices' },
  { href: '/compare', label: 'Compare' },
  { href: '/identify', label: 'Identify' },
  { href: '/tools', label: 'Tools' },
  { href: '/reference', label: 'Reference' },
];
// build.format 'file' puts .html in the pathname at build; public URLs never have it.
const path = Astro.url.pathname.replace(/(\/index)?\.html$/, '') || '/';
const active = (href: string) => path === href || path.startsWith(href + '/');
const ld = jsonld ? (Array.isArray(jsonld) ? jsonld : [jsonld]) : [];
const canonical = new URL(path, Astro.site).href.replace(/\/$/, path === '/' ? '/' : '');
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="canonical" href={canonical} />
    <meta name="robots" content={noindex ? 'noindex' : 'index, follow'} />
    <meta name="theme-color" content="#f8f7f2" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#0f1113" media="(prefers-color-scheme: dark)" />
    <link rel="preload" as="font" type="font/woff2" href="/fonts/ibm-plex-mono-400.woff2" crossorigin />
    <link rel="preload" as="font" type="font/woff2" href="/fonts/ibm-plex-mono-600.woff2" crossorigin />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content="batteries.fyi" />
    <meta property="og:image" content="https://batteries.fyi/og-image.webp" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content="https://batteries.fyi/og-image.webp" />
    <link rel="alternate" type="application/json" href="/api/batteries.json" title="batteries.fyi open data" />
    <script is:inline>
      try {
        const t = localStorage.getItem('theme');
        if (t === 'light' || t === 'dark') document.documentElement.dataset.theme = t;
      } catch (e) {}
    </script>
    <script async src="https://www.googletagmanager.com/gtag/js?id=G-KWF27YQNP4"></script>
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag() { dataLayer.push(arguments); }
      gtag('js', new Date());
      gtag('config', 'G-KWF27YQNP4');
      // What people do here that an answer engine cannot do for them: buy,
      // download a model, open AR. GA4's enhanced measurement misses all three.
      document.addEventListener('click', function (e) {
        var a = e.target && e.target.closest ? e.target.closest('a') : null;
        if (!a) return;
        var path = location.pathname;
        if (a.dataset.buy) gtag('event', 'buy_click', { battery: a.dataset.buy, retailer: a.dataset.retailer, page_type: a.dataset.ctx, page_path: path });
        else if (a.hasAttribute('download') && a.pathname.indexOf('/models/') === 0) gtag('event', 'model_download', { file: a.pathname.slice(8), page_path: path });
        else if (a.rel === 'ar' || a.href.indexOf('intent://arvr') === 0) gtag('event', 'ar_launch', { page_path: path });
      }, true);
    </script>
    {ld.map((o) => <script type="application/ld+json" set:html={JSON.stringify(o)} />)}
    <slot name="head" />
  </head>

  <body class="min-h-screen flex flex-col">
    <a href="#main" class="sr-only focus:not-sr-only focus:absolute focus:top-3 focus:left-3 z-50 btn">Skip to content</a>
    <header class="sticky top-0 z-40 border-b border-line-2 bg-bg">
      <div class="wrap flex items-center gap-4 h-14">
        <a href="/" class="flex items-center gap-2.5 shrink-0" aria-label="batteries.fyi home">
          <Mark class="w-[32px] h-[32px]" />
          <span class="text-[0.8rem]"><span class="font-normal">batteries</span><span class="font-semibold">.fyi</span></span>
        </a>

        <nav class="hidden md:flex items-stretch self-stretch gap-0.5 text-[0.58rem] font-medium uppercase tracking-[0.08em]" aria-label="Main">
          {nav.map((n) => (
            <a href={n.href} class:list={['flex items-center px-2.5 border-b-2 -mb-px transition-colors', active(n.href) ? 'text-ink border-accent' : 'text-ink-2 border-transparent hover:text-ink hover:border-line-2']} aria-current={active(n.href) ? 'page' : undefined}>{n.label}</a>
          ))}
        </nav>

        <div class="ml-auto flex items-center gap-2">
          <button type="button" data-search-open class="hidden sm:flex items-center gap-2 h-9 pl-3 pr-2 w-56 lg:w-72 rounded-lg border border-line-2 bg-surface text-muted text-[0.68rem] hover:border-accent transition-colors" aria-label="Search batteries">
            <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="11" cy="11" r="7" /><path d="m21 21-4.3-4.3" /></svg>
            <span>Search 1,000+ codes</span>
            <span class="ml-auto kbd">/</span>
          </button>
          <button type="button" data-search-open class="sm:hidden w-9 h-9 flex items-center justify-center rounded-lg border border-line-2 bg-surface" aria-label="Search batteries">
            <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="11" cy="11" r="7" /><path d="m21 21-4.3-4.3" /></svg>
          </button>
          <button type="button" id="theme-toggle" class="w-9 h-9 flex items-center justify-center rounded-lg border border-line-2 bg-surface text-ink-2 hover:text-ink" aria-label="Toggle color theme" title="Toggle color theme">
            <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="9" /><path d="M12 3v18" /><path d="M12 3a9 9 0 0 1 0 18" fill="currentColor" /></svg>
          </button>
          <button type="button" id="mobile-menu-button" class="md:hidden w-9 h-9 flex items-center justify-center rounded-lg border border-line-2 bg-surface" aria-controls="mobile-menu" aria-expanded="false" aria-label="Open navigation menu">
            <svg id="hamburger-icon" class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M4 6h16M4 12h16M4 18h16" /></svg>
            <svg id="close-icon" class="w-5 h-5 hidden" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M18 6 6 18M6 6l12 12" /></svg>
          </button>
        </div>
      </div>
      <div id="mobile-menu" class="hidden md:hidden border-t border-line bg-bg">
        <nav class="wrap py-2 flex flex-col text-[0.8rem]" aria-label="Mobile">
          {nav.map((n) => <a href={n.href} class="py-2.5 border-b border-line last:border-0">{n.label}</a>)}
          <a href="/data" class="py-2.5">Open data</a>
        </nav>
      </div>
    </header>

    <main id="main" class="flex-1">
      <slot />
    </main>

    <footer class="border-t border-line mt-16 bg-surface-2/50">
      <div class="wrap py-10 grid gap-8 sm:grid-cols-2 lg:grid-cols-5 text-[0.68rem]">
        <div class="lg:col-span-2 max-w-sm">
          <a href="/" class="inline-flex items-center gap-2 font-semibold text-ink mb-2"><Mark class="w-[16px] h-[16px]" />batteries.fyi</a>
          <p class="text-muted leading-relaxed">Specifications, dimensions, cross-reference codes and 3D models for consumer batteries, sourced from IEC standards and manufacturer datasheets. Open data, MIT licensed.</p>
        </div>
        <div>
          <p class="eyebrow mb-2">Batteries</p>
          <ul class="space-y-1.5 text-ink-2">
            <li><a class="hover:text-ink" href="/household">Household</a></li>
            <li><a class="hover:text-ink" href="/coin-cells">Coin cells</a></li>
            <li><a class="hover:text-ink" href="/button-cells">Button cells</a></li>
            <li><a class="hover:text-ink" href="/lithium-ion">Lithium-ion</a></li>
            <li><a class="hover:text-ink" href="/equivalents">Equivalents table</a></li>
            <li><a class="hover:text-ink" href="/devices">What battery does it take?</a></li>
          </ul>
        </div>
        <div>
          <p class="eyebrow mb-2">Tools</p>
          <ul class="space-y-1.5 text-ink-2">
            <li><a class="hover:text-ink" href="/compare">Compare sizes</a></li>
            <li><a class="hover:text-ink" href="/identify">Identify by measurement</a></li>
            <li><a class="hover:text-ink" href="/decode">Decode a code</a></li>
            <li><a class="hover:text-ink" href="/actual-size">Actual size</a></li>
            <li><a class="hover:text-ink" href="/calculators">Calculators</a></li>
          </ul>
        </div>
        <div>
          <p class="eyebrow mb-2">About</p>
          <ul class="space-y-1.5 text-ink-2">
            <li><a class="hover:text-ink" href="/about">About</a></li>
            <li><a class="hover:text-ink" href="/data">Open data and models</a></li>
            <li><a class="hover:text-ink" href="/sources">Sources</a></li>
            <li><a class="hover:text-ink" href="/glossary">Glossary</a></li>
            <li><a class="hover:text-ink" href="/about#funding">How it is paid for</a></li>
          </ul>
        </div>
      </div>
      <div class="wrap pb-8 text-[0.62rem] text-muted">
        {paid && <p class="text-center mb-4">As an Amazon Associate, batteries.fyi earns from qualifying purchases. No listing or value on this site depends on it.</p>}
        <div class="flex flex-wrap justify-center gap-2 items-center mb-5">
          <span>See also:</span>
          <a href="https://cables.fyi" class="hover:text-ink">Cables</a>
          <span aria-hidden="true">·</span>
          <a href="https://fasteners.fyi" class="hover:text-ink">Fasteners</a>
        </div>
        <div class="relative flex items-center justify-between border-t border-line pt-5">
          <span>&copy; {new Date().getFullYear()} Centricle LLC &middot; batteries.fyi</span>
          <a href="https://centricle.com" title="made by ksmith" aria-label="made by ksmith" class="absolute left-1/2 -translate-x-1/2">
            <img src="https://centricle.com/brand/avatar-sm.jpg" alt="" width="28" height="28" class="w-7 h-7 rounded-full" loading="lazy" />
          </a>
          <a href="/data" class="hover:text-ink">Open data (MIT)</a>
        </div>
      </div>
    </footer>

    <Search />

    <script>
      // Theme: auto -> dark -> light -> auto.
      const tbtn = document.getElementById('theme-toggle');
      tbtn?.addEventListener('click', () => {
        const root = document.documentElement;
        const sysDark = matchMedia('(prefers-color-scheme: dark)').matches;
        const cur = root.dataset.theme ?? (sysDark ? 'dark' : 'light');
        const next = cur === 'dark' ? 'light' : 'dark';
        root.dataset.theme = next;
        try { localStorage.setItem('theme', next); } catch (e) {}
        window.dispatchEvent(new CustomEvent('themechange'));
      });

      // Mobile menu (fleet pattern: Escape, click-outside, icon swap, focus).
      const button = document.getElementById('mobile-menu-button');
      const menu = document.getElementById('mobile-menu');
      const ham = document.getElementById('hamburger-icon');
      const close = document.getElementById('close-icon');
      let open = false;
      const toggle = () => {
        open = !open;
        menu?.classList.toggle('hidden', !open);
        button?.setAttribute('aria-expanded', String(open));
        button?.setAttribute('aria-label', open ? 'Close navigation menu' : 'Open navigation menu');
        ham?.classList.toggle('hidden', open);
        close?.classList.toggle('hidden', !open);
        if (open) (menu?.querySelector('a') as HTMLElement | null)?.focus();
        else button?.focus();
      };
      button?.addEventListener('click', toggle);
      document.addEventListener('keydown', (e) => { if (e.key === 'Escape' && open) toggle(); });
      document.addEventListener('click', (e) => {
        if (open && menu && button && !menu.contains(e.target as Node) && !button.contains(e.target as Node)) toggle();
      });
    </script>
  </body>
</html>
