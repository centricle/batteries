---
import '../styles/global.css';
import Search from '../components/Search.astro';
import Mark from '../components/Mark.astro';
import { paid } from '../lib/buy';
import { ogImage } from '../lib/og';

export interface Props {
  title?: string;
  description?: string;
  jsonld?: object | object[];
  wide?: boolean;
  noindex?: boolean;
}

const {
  title = 'Battery sizes, names and replacements | batteries.fyi',
  description = "Look up any household, coin or button battery by the name printed on it or the device it goes in. Sizes, other names, what else fits and what uses it, checked against the makers’ own datasheets.",
  jsonld,
  noindex = false,
} = Astro.props;

const nav = [
  { href: '/batteries', label: 'Batteries' },
  { href: '/devices', label: 'Devices' },
  { href: '/identify', label: 'Identify' },
  { href: '/compare', label: 'Compare' },
  { href: '/reference', label: 'Guides' },
];

const footer = [
  {
    head: 'Batteries',
    links: [
      { href: '/household', label: 'Household' },
      { href: '/coin-cells', label: 'Coin' },
      { href: '/button-cells', label: 'Button' },
      { href: '/hearing-aid', label: 'Hearing aid' },
      { href: '/lithium-ion', label: 'Rechargeable lithium-ion' },
      { href: '/batteries', label: 'All batteries' },
    ],
  },
  {
    head: 'Find one',
    links: [
      { href: '/devices', label: 'By device' },
      { href: '/identify', label: 'Identify a battery' },
      { href: '/actual-size', label: 'Actual size' },
      { href: '/compare', label: 'Compare sizes' },
      { href: '/equivalents', label: 'Other names' },
      { href: '/tools', label: 'All tools' },
    ],
  },
  {
    head: 'Guides',
    links: [
      { href: '/reference/button-battery-ingestion', label: 'If a battery is swallowed' },
      { href: '/reference/air-travel', label: 'Flying with batteries' },
      { href: '/reference/leakage', label: 'When a battery leaks' },
      { href: '/reference/recycling-and-disposal', label: 'Throwing batteries away' },
      { href: '/reference', label: 'All guides' },
    ],
  },
  {
    head: 'About',
    links: [
      { href: '/about', label: 'About' },
      { href: '/sources', label: 'Sources' },
      { href: '/data', label: 'Data and 3D models' },
      { href: '/glossary', label: 'Glossary' },
      { href: '/about#funding', label: 'How it is paid for' },
    ],
  },
];
// build.format 'file' puts .html in the pathname at build; public URLs never have it.
const path = Astro.url.pathname.replace(/(\/index)?\.html$/, '') || '/';
const active = (href: string) => path === href || path.startsWith(href + '/');
const ld = jsonld ? (Array.isArray(jsonld) ? jsonld : [jsonld]) : [];
const canonical = new URL(path, Astro.site).href.replace(/\/$/, path === '/' ? '/' : '');
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="canonical" href={canonical} />
    <meta name="robots" content={noindex ? 'noindex' : 'index, follow'} />
    <!-- The --bg of each theme in src/styles/global.css, as hex. -->
    <meta name="theme-color" content="#f8f5f0" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#0f1113" media="(prefers-color-scheme: dark)" />
    <link rel="preload" as="font" type="font/woff2" href="/fonts/ibm-plex-mono-400.woff2" crossorigin />
    <link rel="preload" as="font" type="font/woff2" href="/fonts/ibm-plex-mono-600.woff2" crossorigin />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content="batteries.fyi" />
    <meta property="og:image" content={ogImage} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <link rel="alternate" type="application/json" href="/api/batteries.json" title="batteries.fyi open data" />
    <script is:inline>
      try {
        const t = localStorage.getItem('theme');
        if (t === 'light' || t === 'dark') document.documentElement.dataset.theme = t;
      } catch (e) {}
    </script>
    <script async src="https://www.googletagmanager.com/gtag/js?id=G-KWF27YQNP4"></script>
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag() { dataLayer.push(arguments); }
      gtag('js', new Date());
      gtag('config', 'G-KWF27YQNP4');
      // What people do here that an answer engine cannot do for them: buy,
      // download a model, open AR. GA4's enhanced measurement misses all three.
      document.addEventListener('click', function (e) {
        var a = e.target && e.target.closest ? e.target.closest('a') : null;
        if (!a) return;
        var path = location.pathname;
        if (a.dataset.buy) gtag('event', 'buy_click', { battery: a.dataset.buy, retailer: a.dataset.retailer, page_type: a.dataset.ctx, page_path: path });
        else if (a.hasAttribute('download') && a.pathname.indexOf('/models/') === 0) gtag('event', 'model_download', { file: a.pathname.slice(8), page_path: path });
        else if (a.rel === 'ar' || a.href.indexOf('intent://arvr') === 0) gtag('event', 'ar_launch', { page_path: path });
      }, true);
    </script>
    {ld.map((o) => <script type="application/ld+json" set:html={JSON.stringify(o)} />)}
    <slot name="head" />
  </head>

  <body class="min-h-screen flex flex-col">
    <a href="#main" class="sr-only focus:not-sr-only focus:absolute focus:top-3 focus:left-3 z-50 btn">Skip to content</a>
    <header class="sticky top-0 z-40 border-b border-line-2 bg-bg">
      <div class="wrap flex items-center gap-2.5 sm:gap-3 h-14">
        <a href="/" class="flex items-center gap-1.5 sm:gap-2 shrink-0 min-h-9" aria-label="batteries.fyi home">
          <Mark class="w-[36px] h-[36px]" />
          <span class="font-mono text-base sm:text-lg"><span class="font-semibold">batteries</span><span class="font-normal">.fyi</span></span>
        </a>

        <nav class="hidden lg:flex items-stretch self-stretch ml-2 text-sm font-medium" aria-label="Main">
          {nav.map((n) => (
            <a href={n.href} class:list={['flex items-center px-2.5 border-b-[3px] -mb-px transition-colors', active(n.href) ? 'text-ink border-accent-ink' : 'text-ink-2 border-transparent hover:text-ink hover:border-line-2']} aria-current={active(n.href) ? 'page' : undefined}>{n.label}</a>
          ))}
        </nav>

        <div class="ml-auto flex items-center gap-1.5 sm:gap-2">
          <button type="button" data-search-open class="btn hidden sm:inline-flex">
            <svg class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="11" cy="11" r="7" /><path d="m21 21-4.3-4.3" /></svg>
            Search
          </button>
          <button type="button" data-search-open class="btn sm:hidden w-9 h-9 p-0" aria-label="Search">
            <svg class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="11" cy="11" r="7" /><path d="m21 21-4.3-4.3" /></svg>
          </button>
          <button type="button" id="mobile-menu-button" class="btn lg:hidden h-9 min-w-9 p-0 sm:px-3" aria-controls="mobile-menu" aria-expanded="false" aria-label="Open the menu">
            <svg id="hamburger-icon" class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M4 6h16M4 12h16M4 18h16" /></svg>
            <svg id="close-icon" class="w-5 h-5 hidden" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M18 6 6 18M6 6l12 12" /></svg>
            <span class="hidden sm:inline" aria-hidden="true">Menu</span>
          </button>
        </div>
      </div>
      <div id="mobile-menu" class="hidden lg:hidden border-t border-line bg-bg">
        <nav class="wrap py-1 flex flex-col text-base" aria-label="Menu">
          {nav.map((n) => (
            <a href={n.href} class:list={['flex items-center min-h-11 border-b border-line last:border-0', active(n.href) ? 'font-semibold text-ink' : 'text-ink-2']} aria-current={active(n.href) ? 'page' : undefined}>{n.label}</a>
          ))}
        </nav>
      </div>
    </header>

    <main id="main" class="flex-1">
      <slot />
    </main>

    <footer class="border-t border-line-2 mt-16 bg-surface-2">
      {/* Two columns of links even on a phone: the labels are short, and one column made the footer taller than a screen. */}
      <div class="wrap py-8 sm:py-10 grid grid-cols-2 gap-x-6 gap-y-6 sm:gap-y-8 lg:grid-cols-6 text-sm">
        <div class="col-span-2 max-w-sm">
          <a href="/" class="inline-flex items-center gap-2 min-h-8 font-mono font-semibold text-base text-ink mb-2"><Mark class="w-[28px] h-[28px]" />batteries.fyi</a>
          <p class="text-ink-2">Battery sizes, names and what fits what, checked against makers’ datasheets and published standards. Free to use.</p>
        </div>
        {footer.map((col) => (
          <div>
            <h2 class="label mb-1.5">{col.head}</h2>
            <ul>
              {col.links.map((l) => (
                <li><a class="footer-link" href={l.href}>{l.label}</a></li>
              ))}
            </ul>
          </div>
        ))}
      </div>
      <div class="wrap pb-8 text-sm text-ink-2">
        {paid && <p class="mb-4">As an Amazon Associate, batteries.fyi earns from qualifying purchases. No listing or value on this site depends on it.</p>}
        <div class="flex flex-wrap items-center justify-between gap-3 mb-5">
          <p>See also <a class="link tap" href="https://cables.fyi">cables.fyi</a> and <a class="link tap" href="https://fasteners.fyi">fasteners.fyi</a>.</p>
          <button type="button" class="btn btn-sm" data-theme-toggle>
            <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="9" /><path d="M12 3v18" /><path d="M12 3a9 9 0 0 1 0 18" fill="currentColor" /></svg>
            <span data-theme-label>Dark mode</span>
          </button>
        </div>
        <div class="relative flex flex-col sm:flex-row items-center justify-between gap-3 border-t border-line pt-5 text-xs text-muted">
          <span>&copy; {new Date().getFullYear()} Centricle LLC &middot; batteries.fyi</span>
          <a href="https://centricle.com" title="made by ksmith" aria-label="made by ksmith" class="inline-flex items-center justify-center min-w-8 min-h-8 sm:absolute sm:left-1/2 sm:-translate-x-1/2">
            <img src="https://centricle.com/brand/avatar-sm.jpg" alt="" width="28" height="28" class="w-7 h-7 rounded-full" loading="lazy" />
          </a>
          <a href="/data" class="footer-link">Free to use (MIT license)</a>
        </div>
      </div>
    </footer>

    <Search />

    <style>
      /* Footer links: quietly underlined, tall enough to tap. A label that
         wraps in a phone column keeps its lines close, so it reads as one link. */
      .footer-link {
        display: inline-flex; align-items: center; min-height: 2rem; line-height: 1.3;
        text-decoration: underline; text-decoration-thickness: 1px; text-underline-offset: 0.18em;
        text-decoration-color: var(--line-2);
      }
      .footer-link:hover { color: var(--ink); text-decoration-color: currentColor; }
    </style>

    <script>
      // Theme: follows the system until someone picks; the button flips
      // between light and dark and says which one it will switch to.
      const root = document.documentElement;
      const current = () => root.dataset.theme ?? (matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light');
      const labelTheme = () => {
        const next = current() === 'dark' ? 'Light mode' : 'Dark mode';
        document.querySelectorAll('[data-theme-label]').forEach((el) => (el.textContent = next));
      };
      labelTheme();
      matchMedia('(prefers-color-scheme: dark)').addEventListener('change', labelTheme);
      document.querySelectorAll('[data-theme-toggle]').forEach((b) =>
        b.addEventListener('click', () => {
          const next = current() === 'dark' ? 'light' : 'dark';
          root.dataset.theme = next;
          try { localStorage.setItem('theme', next); } catch (e) {}
          labelTheme();
          window.dispatchEvent(new CustomEvent('themechange'));
        }),
      );

      // Menu (fleet pattern: Escape, click-outside, icon swap, focus).
      const button = document.getElementById('mobile-menu-button');
      const menu = document.getElementById('mobile-menu');
      const ham = document.getElementById('hamburger-icon');
      const close = document.getElementById('close-icon');
      let open = false;
      const toggle = () => {
        open = !open;
        menu?.classList.toggle('hidden', !open);
        button?.setAttribute('aria-expanded', String(open));
        button?.setAttribute('aria-label', open ? 'Close the menu' : 'Open the menu');
        ham?.classList.toggle('hidden', open);
        close?.classList.toggle('hidden', !open);
        if (open) (menu?.querySelector('a') as HTMLElement | null)?.focus();
        else button?.focus();
      };
      button?.addEventListener('click', toggle);
      document.addEventListener('keydown', (e) => { if (e.key === 'Escape' && open) toggle(); });
      document.addEventListener('click', (e) => {
        if (open && menu && button && !menu.contains(e.target as Node) && !button.contains(e.target as Node)) toggle();
      });
    </script>
  </body>
</html>
