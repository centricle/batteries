---
import BaseLayout from '../layouts/BaseLayout.astro';
import { allSources, batteryById } from '../lib/data';
const list = allSources();
const byPublisher = new Map<string, typeof list>();
for (const s of list) {
  if (!byPublisher.has(s.publisher)) byPublisher.set(s.publisher, []);
  byPublisher.get(s.publisher)!.push(s);
}
const groups = [...byPublisher].sort((a, b) => b[1].length - a[1].length || a[0].localeCompare(b[0]));
const kinds = list.reduce((m, s) => m.set(s.kind, (m.get(s.kind) ?? 0) + 1), new Map<string, number>());
---

<BaseLayout title="Sources: every datasheet and standard cited | batteries.fyi" description={`The ${list.length} sources behind batteries.fyi: IEC and ANSI standards, manufacturer datasheets, catalogs and references, with the entries each one supports.`}>
  <section class="wrap pt-8 max-w-5xl">
    <p class="eyebrow">Bibliography</p>
    <h1 class="text-[2rem] font-semibold tracking-tight mt-1">Sources</h1>
    <p class="mt-2 text-[0.8rem] text-ink-2 max-w-2xl">{list.length} distinct sources from {byPublisher.size} publishers, each with the date it was read and the entries it supports. Manufacturer datasheets are preferred; where a manufacturer's own link was dead, the copy that was read is linked and the entry says so.</p>
    <p class="mt-3 flex flex-wrap gap-1.5">{[...kinds].map(([k, n]) => <span class="chip">{k} <span class="text-muted">{n}</span></span>)}</p>
  </section>
  <section class="wrap mt-8 max-w-5xl space-y-8">
    {groups.map(([pub, items]) => (
      <div>
        <h2 class="text-[0.85rem] font-semibold mb-2">{pub} <span class="text-muted font-normal text-[0.65rem]">{items.length}</span></h2>
        <ul class="card divide-y divide-[var(--line)]">
          {items.map((s) => (
            <li class="p-3 text-[0.68rem]">
              {s.url ? <a class="link" href={s.url} rel="nofollow noopener" target="_blank">{s.title}</a> : <span>{s.title}</span>}
              <span class="text-muted"> · {s.kind} · accessed {s.accessed}</span>
              <span class="block mt-1 text-[0.6rem] text-muted">
                Supports:{' '}
                {s.usedBy.slice(0, 24).map((id, i) => {
                  const b = id.startsWith('chemistry/') ? null : batteryById(id);
                  return <><a class="hover:text-ink underline decoration-dotted" href={`/${id}`}>{b?.name ?? id.replace('chemistry/', '')}</a>{i < Math.min(s.usedBy.length, 24) - 1 ? ', ' : ''}</>;
                })}
                {s.usedBy.length > 24 && ` and ${s.usedBy.length - 24} more`}
              </span>
            </li>
          ))}
        </ul>
      </div>
    ))}
  </section>
</BaseLayout>
