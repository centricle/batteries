---
import fs from 'node:fs';
import path from 'node:path';
import BaseLayout from '../layouts/BaseLayout.astro';
import { batteries, searchIndex, stats } from '../lib/data';
import { BUILTIN, mergeTables, decode, type Tables, type Role } from '../lib/decode';

// Letter and size tables: data/iec-system.json when another pass has written
// it, else the built-in IEC 60086-1 summary in src/lib/decode.ts.
const iecPath = path.join(process.cwd(), 'data/iec-system.json');
let tables: Tables = BUILTIN;
if (fs.existsSync(iecPath)) {
  try {
    tables = mergeTables(JSON.parse(fs.readFileSync(iecPath, 'utf8')));
  } catch {
    tables = BUILTIN;
  }
}

// Every name for every battery: [name, system, battery id, chemistry].
const rows: [string, string, string, string][] = [];
for (const b of batteries()) {
  for (const c of b.codes) rows.push([c.code, c.system, b.id, c.chemistry ?? '']);
  for (const a of [b.name, ...b.aliases]) rows.push([a, 'Name', b.id, '']);
}
const s = stats();
const examples = ['LR6', 'CR2032', 'SR626SW', '6LR61', 'INR18650', 'HR03', 'PR44', '2CR5'];
const initial = decode('CR2032', tables)!;
const accessed = '2026-11-22';

// Tile colors and plain labels for each part of a name. The client script
// below repeats these two maps; keep them in step.
const ROLE_CLASS: Record<Role, string> = {
  series: 'bg-warn-soft border-warn',
  chem: 'bg-accent-soft border-accent',
  shape: 'bg-ok-soft border-ok',
  size: 'bg-surface-3 border-line-2',
  suffix: 'bg-surface-2 border-line-2 border-dashed',
  parallel: 'bg-surface-2 border-line-2 border-dashed',
  prefix: 'bg-warn-soft border-warn border-dashed',
  model: 'bg-surface-2 border-line-2 border-dashed',
  name: 'bg-surface-3 border-line-2',
  voltage: 'bg-warn-soft border-warn',
};
const ROLE_NAME: Record<Role, string> = {
  series: 'How many inside',
  chem: 'Kind',
  shape: 'Shape',
  size: 'Size',
  suffix: 'Ending',
  parallel: 'Side by side',
  prefix: 'Maker prefix',
  model: 'Model number',
  name: 'Name',
  voltage: 'Voltage',
};
const systemLabel = (x: string) => x.replace(/Manufacturer/g, 'Maker').replace('(primary)', '(single-use)');

const chemRows = Object.entries(tables.chem).map(([k, v]) => ({ k, ...v }));
const legacyRound = ['R03', 'R1', 'R6', 'R12', 'R14', 'R20', 'R23', 'R25', 'R40'].filter((k) => tables.legacy[k]).map((k) => ({ k, ...tables.legacy[k] }));
const legacyButton = Object.entries(tables.legacy).filter(([k, v]) => k.startsWith('R') && v.name === 'Button').map(([k, v]) => ({ k, ...v }));
const diam = Object.entries(tables.diameter).sort((a, b) => +a[0] - +b[0]);

const jsonld = {
  '@context': 'https://schema.org',
  '@type': 'WebApplication',
  name: 'What the letters and numbers on a battery mean',
  url: 'https://batteries.fyi/decode',
  applicationCategory: 'UtilitiesApplication',
  operatingSystem: 'Any',
  browserRequirements: 'Requires JavaScript',
  isAccessibleForFree: true,
  description: 'Explains the IEC 60086, IEC 61951, IEC 61960 and ANSI C18 battery names letter by letter, and finds which battery a maker number belongs to.',
};
---

<BaseLayout title="What the letters and numbers on a battery mean: LR6, CR2032, SR626SW | batteries.fyi" description="Type the name printed on a battery to see what each letter and number means: the kind, the shape and the size, under the IEC and ANSI naming systems, and which battery a maker number belongs to." jsonld={jsonld}>
  <section class="wrap pt-8">
    <h1 class="text-2xl sm:text-3xl font-semibold">What the letters and numbers mean</h1>
    <p class="lede measure mt-3">Type the name printed on your battery to see what each part of it means.</p>
    <p class="mt-2 text-base text-ink-2 measure">Most names are built from parts. In CR2032, C means lithium, R means round, 20 is how wide it is in millimeters, and 32 is how thick it is in tenths of a millimeter (3.2mm). Some names, like 377, are a maker's own number and say nothing about the size. For those, the page looks the name up among the {s.codes.toLocaleString('en-US')} other names on this site.</p>
  </section>

  <section class="wrap mt-6">
    <div class="card p-4 sm:p-5">
      <form id="dc-form" class="max-w-xl" role="search" action="/decode">
        <label for="dc-code" class="label block mb-1">Name on the battery</label>
        <div class="flex flex-col sm:flex-row gap-2">
          <input id="dc-code" name="code" class="input font-mono text-lg h-12" placeholder="LR6, CR2032, 377, INR18650" autocomplete="off" autocapitalize="characters" spellcheck="false" value="CR2032" />
          <button type="submit" class="btn btn-primary h-12 px-5">Explain</button>
        </div>
      </form>
      <div class="mt-4 flex flex-wrap items-center gap-2">
        <span class="label mr-1">Try one:</span>
        {examples.map((c) => <a href={`/decode?code=${c}`} class="chip" data-code={c}>{c}</a>)}
      </div>

      <div id="dc-out" class="mt-6" aria-live="polite">
        <div class="flex flex-wrap items-baseline gap-x-3 gap-y-1">
          <h2 class="font-mono text-2xl font-semibold" id="dc-title">{initial.input}</h2>
          <span class="chip" id="dc-system">{systemLabel(initial.system)}</span>
        </div>
        <p class="mt-2 text-lg text-ink measure" id="dc-summary">{initial.summary}</p>
        <div class="mt-4" id="dc-tiles">
          <ol class="flex flex-wrap gap-3" aria-label={`Parts of ${initial.input}`}>
            {initial.segments.map((sg) => (
              <li class="flex flex-col min-w-[6rem] max-w-[17rem] flex-1">
                <span class={`block border px-3 py-2 text-center font-mono text-2xl font-semibold text-ink ${ROLE_CLASS[sg.role]}`}>{sg.text}</span>
                <span class="mt-2 label">{ROLE_NAME[sg.role]}</span>
                <span class="text-base font-semibold text-ink leading-snug">{sg.title}</span>
                <span class="mt-1 text-sm text-ink-2 leading-snug">{sg.meaning}</span>
              </li>
            ))}
          </ol>
        </div>
        <div class="mt-4 space-y-2" id="dc-extra"></div>
        <div class="mt-5" id="dc-lookup"></div>
      </div>
    </div>
  </section>

  <section class="wrap mt-12">
    <h2 class="section-title">The naming systems in detail</h2>
    <p class="text-base text-ink-2 measure">For anyone who wants the full tables behind the explanations above.</p>
  </section>

  <section class="wrap mt-6 grid gap-8 lg:grid-cols-2 [&>*]:min-w-0">
    <div>
      <h2 class="section-title" id="iec-60086">Single-use batteries (IEC 60086)</h2>
      <p class="text-base text-ink-2">The pattern is <span class="mono">[how many inside] [kind] [shape] [size] [ending] [-rows side by side]</span>. For example, a 9V battery named <span class="mono">6LR61</span> has six small cells inside (6), is alkaline (L) and round (R), size 61, so 6 × 1.5V = 9V.</p>
      <h3 class="text-lg font-semibold mt-5 mb-2">Kind letters</h3>
      <div class="card table-scroll">
        <table class="table">
          <thead><tr><th>Letter</th><th>Kind (chemistry)</th><th class="n">Volts</th></tr></thead>
          <tbody>
            {chemRows.map((r) => (
              <tr><td class="mono font-semibold">{r.k || '(none)'}</td><td>{r.name}{r.withdrawn ? ' (withdrawn)' : ''}</td><td class="n">{r.v ? `${r.v}V` : ''}</td></tr>
            ))}
            {Object.entries(tables.recharge).map(([k, r]) => (
              <tr><td class="mono font-semibold">{k}</td><td>{r.name}, IEC 61951</td><td class="n">{r.v ? `${r.v}V` : ''}</td></tr>
            ))}
          </tbody>
        </table>
      </div>
      <h3 class="text-lg font-semibold mt-6 mb-2">Shape letters</h3>
      <ul class="text-base text-ink-2 space-y-1">
        {Object.entries(tables.shape).map(([k, v]) => <li><span class="mono font-semibold text-ink">{k}</span>: {v.name}. {v.note}</li>)}
      </ul>
    </div>
    <div>
      <h2 class="section-title" id="sizes">Size numbers</h2>
      <p class="text-base text-ink-2">One or two digits are an older size number kept from earlier editions of the standard: R6 is AA, R03 is AAA. Three or more digits are a measurement: how wide in millimeters, then how tall in tenths of a millimeter. <span class="mono">2032</span> is 20mm by 3.2mm. <span class="mono">17345</span> is 17mm by 34.5mm. Three digits use a one-digit width number: <span class="mono">626</span> is 6.8mm by 2.6mm.</p>
      <h3 class="text-lg font-semibold mt-5 mb-2">Older size numbers, round batteries</h3>
      <div class="card table-scroll">
        <table class="table">
          <thead><tr><th>Number</th><th>Name</th><th class="n">Across × long</th></tr></thead>
          <tbody>
            {legacyRound.map((r) => <tr><td class="mono font-semibold">{r.k}</td><td>{r.name}</td><td class="n">{r.d && r.h ? `${r.d} × ${r.h}mm` : ''}</td></tr>)}
          </tbody>
        </table>
      </div>
      <details class="mt-3 card p-3">
        <summary class="cursor-pointer min-h-8 py-1 text-base font-semibold">Older size numbers, button batteries ({legacyButton.length})</summary>
        <div class="table-scroll mt-2">
          <table class="table">
            <thead><tr><th>Number</th><th class="n">Across × thick</th><th>Example</th></tr></thead>
            <tbody>
              {legacyButton.map((r) => <tr><td class="mono font-semibold">{r.k}</td><td class="n">{r.d} × {r.h}mm</td><td class="mono">LR{r.k.slice(1)}, SR{r.k.slice(1)}</td></tr>)}
            </tbody>
          </table>
        </div>
      </details>
      <h3 class="text-lg font-semibold mt-6 mb-2">Width numbers</h3>
      <p class="text-base text-ink-2">Where a name uses one of these width numbers, the digits stand for the largest allowed width rather than the width cut to whole millimeters.</p>
      <div class="mt-2 flex flex-wrap gap-2">
        {diam.map(([k, v]) => <span class="chip">{k} is {v}mm</span>)}
      </div>
      <h3 class="text-lg font-semibold mt-6 mb-2">Endings</h3>
      <ul class="text-base text-ink-2 space-y-1">
        <li><span class="mono font-semibold text-ink">W</span>: meets IEC 60086-3, the watch battery standard.</li>
        <li><span class="mono font-semibold text-ink">SW</span>, <span class="mono font-semibold text-ink">W</span>: as makers use them, the low-drain and high-drain silver oxide batteries of the same size.</li>
        <li><span class="mono font-semibold text-ink">X</span>, <span class="mono font-semibold text-ink">Y</span>: the style of terminal, or a variant (4LR25X, 4LR25Y).</li>
        <li><span class="mono font-semibold text-ink">-2</span>: two rows side by side inside (4LR25-2).</li>
      </ul>
    </div>
  </section>

  <section class="wrap mt-10 grid gap-8 lg:grid-cols-2 [&>*]:min-w-0">
    <div>
      <h2 class="section-title" id="iec-61960">Rechargeable lithium-ion (IEC 61960)</h2>
      <p class="text-base text-ink-2">The pattern is <span class="mono">[how many inside] [negative side] [positive side] [shape] [size]</span>. In <span class="mono">INR18650</span>, I means lithium-ion, N means a nickel-based positive side, R means round, 18 is how wide in millimeters and 650 is how long in tenths of a millimeter (65.0mm). The standard itself writes the largest sizes with a slash (ICR19/66); the five-digit form is the one makers print. A bare <span class="mono">18650</span> names only the size.</p>
      <div class="card table-scroll mt-3">
        <table class="table">
          <thead><tr><th>Letter</th><th>Positive side</th><th>What it usually means</th></tr></thead>
          <tbody>
            {Object.entries(tables.liCathode).map(([k, v]) => <tr><td class="mono font-semibold">{k}</td><td>{v.name.replace(' positive electrode', '')}</td><td class="text-ink-2">{v.note ?? ''}</td></tr>)}
          </tbody>
        </table>
      </div>
      <p class="mt-2 text-sm text-ink-2">ICR, IMR, INR and IFR are the forms printed on batteries. NCR (Panasonic), UR (Panasonic, formerly Sanyo) and US (Sony, now Murata) are maker prefixes, not IEC letters.</p>
    </div>
    <div>
      <h2 class="section-title" id="ansi">US names (ANSI C18)</h2>
      <p class="text-base text-ink-2">ANSI names are a size number followed by letters for the kind. The number is assigned, not measured: 15 is AA, 24 is AAA, 1604 is 9V, and lithium coin batteries are in the 5000s (5004LC is the CR2032).</p>
      <div class="card table-scroll mt-3">
        <table class="table">
          <thead><tr><th>Ending</th><th>Kind</th><th>IEC letter</th></tr></thead>
          <tbody>
            {Object.entries(tables.ansiSuffix).filter(([k]) => k).map(([k, v]) => <tr><td class="mono font-semibold">{k}</td><td>{v.name}</td><td class="mono">{v.iec || '(none)'}</td></tr>)}
          </tbody>
        </table>
      </div>
      <p class="mt-2 text-sm text-ink-2">No ending means carbon-zinc. Size numbers: {Object.entries(tables.ansiSize).map(([k, v]) => `${k} is ${v}`).join(', ')}.</p>
    </div>
  </section>

  <section class="wrap mt-10">
    <h2 class="section-title" id="how">How it works</h2>
    <div class="prose">
      <p>The page tries each naming system in turn: names with their own rules (CR123A, CR2, CR-P2, CR-V3, 2CR5), common names (AA, 9V), IEC 61960 lithium-ion names, known maker prefixes (LIR, ML, NCR, AG), fractional sizes (CR1/3N), IEC 60086 and IEC 61951 names, then ANSI C18 names and bare size digits. The first rule that fits gives the breakdown. Separately, the name is looked up in this site's list of every name for each battery and who assigns it. When the two disagree, for example a number that fits the ANSI pattern but is listed only as a maker number, the page says so.</p>
      <p>A size read from a name is the largest allowed size or a rounded one, not the exact size. Each battery's page has its measured size and the allowed range.</p>
      <h3>Sources</h3>
      <ul>
        <li>IEC 60086-1, Primary batteries, Part 1: General (kind letters, shape letters, size numbers). IEC 61951-1 and 61951-2 (NiCd and NiMH). IEC 61960 (lithium-ion). ANSI C18.1 (sizes and endings of single-use batteries). As summarized in the next two references; the standards are not freely published.</li>
        <li><a href="https://en.wikipedia.org/wiki/Battery_nomenclature">Battery nomenclature</a>, Wikipedia, accessed {accessed}.</li>
        <li><a href="https://en.wikipedia.org/wiki/List_of_battery_sizes">List of battery sizes</a>, Wikipedia, accessed {accessed} (older button size numbers and sizes).</li>
        <li>Maker numbers: <a href="/equivalents">other names for every battery</a>, built from the sources listed on each battery's page.</li>
        {tables.source !== 'built-in' && <li>Letter and size tables: <span class="mono">{tables.source}</span> in the batteries.fyi data.</li>}
      </ul>
    </div>
  </section>

  <script type="application/json" id="dc-tables" set:html={JSON.stringify(tables)} />
  <script type="application/json" id="dc-rows" set:html={JSON.stringify(rows)} />
  <script type="application/json" id="dc-index" set:html={JSON.stringify(searchIndex())} />
</BaseLayout>

<script>
  import { decode, esc, clean, type Decoded, type Tables, type Role } from '../lib/decode';
  import { rank, norm, type Entry } from '../lib/search';

  const tables: Tables = JSON.parse(document.getElementById('dc-tables')!.textContent!);
  const rows: [string, string, string, string][] = JSON.parse(document.getElementById('dc-rows')!.textContent!);
  const index: Entry[] = JSON.parse(document.getElementById('dc-index')!.textContent!);
  const byId = new Map(index.map((e) => [e.id, e]));
  const byCode = new Map<string, [string, string, string, string][]>();
  for (const r of rows) {
    const k = norm(r[0]);
    if (!k) continue;
    if (!byCode.has(k)) byCode.set(k, []);
    byCode.get(k)!.push(r);
  }

  // Same two maps as the page frontmatter; keep them in step.
  const ROLE_CLASS: Record<Role, string> = {
    series: 'bg-warn-soft border-warn',
    chem: 'bg-accent-soft border-accent',
    shape: 'bg-ok-soft border-ok',
    size: 'bg-surface-3 border-line-2',
    suffix: 'bg-surface-2 border-line-2 border-dashed',
    parallel: 'bg-surface-2 border-line-2 border-dashed',
    prefix: 'bg-warn-soft border-warn border-dashed',
    model: 'bg-surface-2 border-line-2 border-dashed',
    name: 'bg-surface-3 border-line-2',
    voltage: 'bg-warn-soft border-warn',
  };
  const ROLE_NAME: Record<Role, string> = {
    series: 'How many inside',
    chem: 'Kind',
    shape: 'Shape',
    size: 'Size',
    suffix: 'Ending',
    parallel: 'Side by side',
    prefix: 'Maker prefix',
    model: 'Model number',
    name: 'Name',
    voltage: 'Voltage',
  };
  const systemLabel = (x: string) => x.replace(/Manufacturer/g, 'Maker').replace('(primary)', '(single-use)');
  const tilesHTML = (d: Decoded) =>
    `<ol class="flex flex-wrap gap-3" aria-label="Parts of ${esc(d.input)}">${d.segments
      .map((s) => `<li class="flex flex-col min-w-[6rem] max-w-[17rem] flex-1">
        <span class="block border px-3 py-2 text-center font-mono text-2xl font-semibold text-ink ${ROLE_CLASS[s.role]}">${esc(s.text)}</span>
        <span class="mt-2 label">${esc(ROLE_NAME[s.role])}</span>
        <span class="text-base font-semibold text-ink leading-snug">${esc(s.title)}</span>
        <span class="mt-1 text-sm text-ink-2 leading-snug">${esc(s.meaning)}</span>
      </li>`)
      .join('')}</ol>`;

  const form = document.getElementById('dc-form') as HTMLFormElement;
  const input = document.getElementById('dc-code') as HTMLInputElement;
  const out = document.getElementById('dc-out')!;
  const title = document.getElementById('dc-title')!;
  const system = document.getElementById('dc-system')!;
  const summary = document.getElementById('dc-summary')!;
  const tiles = document.getElementById('dc-tiles')!;
  const extra = document.getElementById('dc-extra')!;
  const lookup = document.getElementById('dc-lookup')!;
  const fmt = (n: number) => Number(n.toFixed(2)).toLocaleString('en-US', { maximumFractionDigits: 2 });
  /** Nearest 1/16 in: "13/16 in", "1 3/8 in". */
  const inFrac = (mm: number) => {
    const s = Math.round((mm / 25.4) * 16);
    if (s === 0) return 'under 1/16 in';
    const whole = Math.floor(s / 16);
    let num = s % 16, den = 16;
    while (num && num % 2 === 0) { num /= 2; den /= 2; }
    return `${whole || ''}${whole && num ? ' ' : ''}${num ? `${num}/${den}` : ''} in`;
  };
  const vList = (v: string) => v.split(/\s*\/\s*|,\s*/).filter(Boolean);
  const orList = (xs: string[]) => (xs.length < 2 ? xs.join('') : `${xs.slice(0, -1).join(', ')} or ${xs[xs.length - 1]}`);
  const STD = new Set(['IEC', 'ANSI', 'JIS', 'NEDA', 'Military']);

  function render(raw: string, sync = true) {
    const code = clean(raw);
    if (sync) history.replaceState(null, '', code ? `?code=${encodeURIComponent(code)}` : location.pathname);
    if (!code) {
      out.hidden = true;
      return;
    }
    out.hidden = false;
    const hits = byCode.get(norm(code)) ?? [];
    const liIon = hits.some((h) => byId.get(h[2])?.c === 'Lithium-ion');
    let d: Decoded | null = decode(code, tables, { liIon });

    // A listed maker number with no systematic reading.
    if (!d && hits.length) {
      const systems = [...new Set(hits.map((h) => h[1]))];
      d = {
        input: code,
        system: 'Maker number',
        segments: [{ text: code, role: 'model', title: 'Maker or catalog number', meaning: `Used by ${systems.join(', ')}. A catalog number says nothing about the size or the kind.` }],
        summary: `${code} is a maker's number. It tells you which battery it is only through a list like the one below.`,
        notes: [],
      };
    }

    title.textContent = code;
    if (!d) {
      system.textContent = 'Not recognized';
      summary.textContent = `This page does not know “${code}”. It does not follow the IEC or ANSI naming patterns, and it is not among the ${rows.length.toLocaleString('en-US')} names on this site.`;
      tiles.innerHTML = '';
      extra.innerHTML = '';
      const near = rank(index, code, 5);
      lookup.innerHTML = `<p class="text-base text-ink-2">Try <a class="link" href="/search?q=${encodeURIComponent(code)}">searching for ${esc(code)}</a>, or <a class="link" href="/identify">identify the battery by its size</a>.</p>${near.length ? `<p class="mt-4 label">Closest names</p><ul class="mt-1 flex flex-wrap gap-2">${near.map(({ e }) => `<li><a class="chip" href="/${e.id}">${esc(e.n)}</a></li>`).join('')}</ul>` : ''}`;
      return;
    }

    system.textContent = systemLabel(d.system);
    summary.textContent = d.summary;
    tiles.innerHTML = tilesHTML(d);

    const bits: string[] = [];
    if (d.voltage && d.voltage.cells > 1) bits.push(`<p class="text-base"><span class="font-semibold">Voltage:</span> <span class="mono">${d.voltage.cells} × ${fmt(d.voltage.per)}V = ${fmt(d.voltage.total)}V</span></p>`);
    if (d.dims?.d && d.dims?.h) {
      const disc = d.dims.h < d.dims.d;
      const q = new URLSearchParams({ shape: disc ? 'disc' : 'cylinder', d: String(d.dims.d), h: String(d.dims.h) });
      bits.push(`<p class="text-base"><span class="font-semibold">Size from the name:</span> <span class="mono">${fmt(d.dims.d)} × ${fmt(d.dims.h)}mm</span> (about ${inFrac(d.dims.d)} by ${inFrac(d.dims.h)})${d.dims.approx ? ', roughly' : ''}. <a class="link" href="/identify?${q}">Find batteries of this size</a></p>`);
    }
    for (const n of d.notes) bits.push(`<p class="text-sm text-ink-2">${esc(n)}</p>`);
    const std = d.system.startsWith('IEC') ? 'IEC' : d.system.startsWith('ANSI') ? 'ANSI' : null;
    if (std && hits.length && !hits.some((h) => h[1] === std)) {
      const systems = [...new Set(hits.map((h) => h[1]))].filter((x) => x !== 'Name');
      const coreHit = d.core ? (byCode.get(norm(d.core)) ?? []).some((h) => h[1] === std) : false;
      if (coreHit) bits.push(`<p class="callout info">${std} lists the name ${esc(d.core!)}. The ending is added by makers${systems.length ? ` (${esc(systems.join(', '))})` : ''}.</p>`);
      else if (systems.length) bits.push(`<p class="callout warn">This site lists ${esc(code)} as a name used by ${esc(systems.join(', '))}, not as an ${std} name. The reading above follows the ${std} pattern only.</p>`);
    }
    if (d.partial) bits.push(`<p class="callout info">Part of this name does not match a rule this page knows. The breakdown shows what could be read.</p>`);
    extra.innerHTML = bits.join('');

    // Which battery the name belongs to.
    if (hits.length) {
      const groups = new Map<string, string[]>();
      for (const h of hits) {
        if (!groups.has(h[2])) groups.set(h[2], []);
        if (!groups.get(h[2])!.includes(h[1])) groups.get(h[2])!.push(h[1]);
      }
      lookup.innerHTML = `<h3 class="text-lg font-semibold">Which battery this is</h3><ul class="mt-2 grid gap-3 sm:grid-cols-2">${[...groups]
        .map(([id, systems]) => {
          const e = byId.get(id);
          if (!e) return '';
          const named = systems.includes('Name') && norm(e.n) !== norm(code);
          const sys = systems.filter((x) => x !== 'Name').map((x) => (STD.has(x) ? `${x} (a standard)` : x));
          const listed = sys.length ? `${esc(code)} is the name used by ${esc(sys.join(', '))}.${named ? ' It is also a common name for this battery.' : ''}` : `${esc(code)} is a common name for this battery.`;
          const others = e.k.filter((k) => norm(k) !== norm(code)).slice(0, 6);
          return `<li><a href="/${e.id}" class="tile card block p-4 h-full">
            <span class="flex items-center gap-2"><span class="dot" style="background:${esc(e.col)}"></span><span class="font-mono font-semibold text-lg">${esc(e.n)}</span></span>
            <span class="block mt-1 text-sm text-ink-2">${esc(e.c)}, ${esc(e.s)}, ${esc(orList(vList(e.v)))}V</span>
            <span class="block mt-1 text-base text-ink">${listed}</span>
            ${others.length ? `<span class="block mt-1 text-sm text-ink-2">Also sold as ${esc(others.join(', '))}</span>` : ''}
          </a></li>`;
        })
        .join('')}</ul>`;
    } else {
      const near = rank(index, code, 4).filter((r) => r.score >= 300);
      lookup.innerHTML = `<p class="text-base text-ink-2">${esc(code)} is not listed on this site under that exact name.${near.length ? ' Batteries with a similar name:' : ''} <a class="link" href="/search?q=${encodeURIComponent(code)}">Search for it</a></p>${near.length ? `<ul class="mt-2 flex flex-wrap gap-2">${near.map(({ e, why }) => `<li><a class="chip" href="/${e.id}">${esc(e.n)}${why ? ` <span class="text-ink-2">(${esc(why)})</span>` : ''}</a></li>`).join('')}</ul>` : ''}`;
    }
  }

  form.addEventListener('submit', (e) => {
    e.preventDefault();
    render(input.value);
  });
  let t: number | undefined;
  input.addEventListener('input', () => {
    clearTimeout(t);
    t = window.setTimeout(() => render(input.value), 150);
  });
  document.querySelectorAll<HTMLAnchorElement>('[data-code]').forEach((a) =>
    a.addEventListener('click', (e) => {
      e.preventDefault();
      input.value = a.dataset.code!;
      render(input.value);
      input.focus();
    }),
  );
  const q = new URLSearchParams(location.search).get('code');
  if (q) input.value = q;
  render(input.value, !!q);
</script>
