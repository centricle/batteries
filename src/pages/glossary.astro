---
import BaseLayout from '../layouts/BaseLayout.astro';
import fs from 'node:fs';
import path from 'node:path';

type Term = { term: string; slug: string; definition: string; see_also?: string[] };
const file = path.join(process.cwd(), 'data/glossary.json');
const raw = fs.existsSync(file) ? JSON.parse(fs.readFileSync(file, 'utf8')) : [];
const terms: Term[] = (Array.isArray(raw) ? raw : raw.terms ?? []).sort((a: Term, b: Term) => a.term.localeCompare(b.term, 'en', { sensitivity: 'base' }));
const bySlug = new Map(terms.map((t) => [t.slug, t]));
const letters = [...new Set(terms.map((t) => t.term[0].toUpperCase()))];
const jsonld = {
  '@context': 'https://schema.org',
  '@type': 'DefinedTermSet',
  name: 'Battery glossary',
  url: 'https://batteries.fyi/glossary',
  hasDefinedTerm: terms.map((t) => ({ '@type': 'DefinedTerm', name: t.term, description: t.definition, url: `https://batteries.fyi/glossary#${t.slug}` })),
};
---

<BaseLayout title="Battery glossary: mAh, C-rate, cutoff voltage and more | batteries.fyi" description={`Plain definitions of ${terms.length} battery terms: capacity, C-rate, nominal and cutoff voltage, self-discharge, protection circuits, battery sizes and standards.`} jsonld={jsonld}>
  <section class="wrap pt-8 max-w-3xl">
    <h1 class="text-2xl sm:text-3xl font-semibold tracking-tight">Glossary</h1>
    <p class="lede measure mt-3">The technical words on battery pages and in datasheets, each with a short explanation. There are {terms.length} of them.</p>
    <nav class="mt-5 flex flex-wrap gap-1.5" aria-label="Jump to a letter">{letters.map((l) => <a href={`#letter-${l}`} class="chip inline-flex items-center justify-center min-h-8 min-w-8 text-sm">{l}</a>)}</nav>
  </section>
  <div class="wrap mt-8 max-w-3xl space-y-8">
    {letters.map((l) => (
      <section aria-labelledby={`letter-${l}`}>
        <h2 id={`letter-${l}`} class="section-title scroll-mt-20">{l}</h2>
        <dl class="space-y-5">
          {terms.filter((t) => t.term[0].toUpperCase() === l).map((t) => (
            <div id={t.slug} class="scroll-mt-20">
              <dt class="font-semibold text-lg">{t.term}</dt>
              <dd class="font-sans text-base text-ink-2 mt-1 measure">{t.definition}
                {t.see_also?.length ? <span class="block text-sm text-ink-2 mt-1">See also: {t.see_also.filter((s) => bySlug.has(s)).map((s, i, a) => <><a class="link" href={`#${s}`}>{bySlug.get(s)!.term}</a>{i < a.length - 1 ? ', ' : ''}</>)}</span> : null}
              </dd>
            </div>
          ))}
        </dl>
      </section>
    ))}
  </div>
</BaseLayout>
