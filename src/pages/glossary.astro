---
import BaseLayout from '../layouts/BaseLayout.astro';
import fs from 'node:fs';
import path from 'node:path';

type Term = { term: string; slug: string; definition: string; see_also?: string[] };
const file = path.join(process.cwd(), 'data/glossary.json');
const raw = fs.existsSync(file) ? JSON.parse(fs.readFileSync(file, 'utf8')) : [];
const terms: Term[] = (Array.isArray(raw) ? raw : raw.terms ?? []).sort((a: Term, b: Term) => a.term.localeCompare(b.term, 'en', { sensitivity: 'base' }));
const bySlug = new Map(terms.map((t) => [t.slug, t]));
const letters = [...new Set(terms.map((t) => t.term[0].toUpperCase()))];
const jsonld = {
  '@context': 'https://schema.org',
  '@type': 'DefinedTermSet',
  name: 'Battery glossary',
  url: 'https://batteries.fyi/glossary',
  hasDefinedTerm: terms.map((t) => ({ '@type': 'DefinedTerm', name: t.term, description: t.definition, url: `https://batteries.fyi/glossary#${t.slug}` })),
};
---

<BaseLayout title="Battery glossary: mAh, C-rate, cutoff voltage and more | batteries.fyi" description={`Plain definitions of ${terms.length} battery terms: capacity, C-rate, nominal and cutoff voltage, self-discharge, protection circuits, cell formats and standards.`} jsonld={jsonld}>
  <section class="wrap pt-8 max-w-3xl">
    <p class="eyebrow">Reference</p>
    <h1 class="text-[2rem] font-semibold tracking-tight mt-1">Glossary</h1>
    <p class="mt-2 text-[0.8rem] text-ink-2">{terms.length} terms used across the specifications, defined plainly.</p>
    <nav class="mt-4 flex flex-wrap gap-1 text-[0.65rem]" aria-label="Letters">{letters.map((l) => <a href={`#letter-${l}`} class="chip">{l}</a>)}</nav>
  </section>
  <section class="wrap mt-6 max-w-3xl">
    <dl class="space-y-5">
      {letters.map((l) => (
        <>
          <h2 id={`letter-${l}`} class="eyebrow pt-4 border-t border-line scroll-mt-20">{l}</h2>
          {terms.filter((t) => t.term[0].toUpperCase() === l).map((t) => (
            <div id={t.slug} class="scroll-mt-20">
              <dt class="font-semibold text-[0.85rem]">{t.term}</dt>
              <dd class="text-[0.75rem] text-ink-2 mt-0.5">{t.definition}
                {t.see_also?.length ? <span class="block text-[0.62rem] text-muted mt-1">See also: {t.see_also.filter((s) => bySlug.has(s)).map((s, i, a) => <><a class="link" href={`#${s}`}>{bySlug.get(s)!.term}</a>{i < a.length - 1 ? ', ' : ''}</>)}</span> : null}
              </dd>
            </div>
          ))}
        </>
      ))}
    </dl>
  </section>
</BaseLayout>
