---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Silhouette from '../../components/Silhouette.astro';
import Sources from '../../components/Sources.astro';
import { marked } from 'marked';
import { batteries, chemistries, chem, CHEM_FALLBACK, fmt, sizeLabel, type Battery } from '../../lib/data';

export function getStaticPaths() {
  const ids = new Set([...chemistries().map((c) => c.id), ...batteries().flatMap((b) => b.variants.map((v) => v.chemistry))]);
  return [...ids].filter((id) => CHEM_FALLBACK[id]).map((id) => ({ params: { id } }));
}
const { id } = Astro.params as { id: string };
const c = chemistries().find((x) => x.id === id);
const meta = chem(id);
// plain_name and plain are optional; this page builds with or without them.
const p = (c ?? {}) as { plain_name?: string; plain?: string };
const name = p.plain_name ?? meta.name;
const techName = name !== meta.name ? meta.name : '';
const lede = p.plain ?? c?.summary;
const STATUS: Record<string, string> = { legacy: 'Older kind, still sold', obsolete: 'No longer made' };
const status = c ? STATUS[c.status] : undefined;
const using = batteries().filter((b) => b.variants.some((v) => v.chemistry === id));
const scale = (list: Battery[]) => Math.max(...list.map((b) => (b.form === 'disc' ? b.dimensions.diameter!.nominal : b.dimensions.height.nominal)));
// The body is the technical write-up. It sits under its own h2 here, so its
// own h2s step down to h3.
const body = c ? (await marked.parse(c.body)).replace(/<(\/?)h2\b/g, '<$1h3') : '';
const range = (r: [number, number], unit: string) => `${fmt(r[0])} to ${fmt(r[1])} ${unit}`;
const longDate = (iso: string) => new Date(`${iso}T00:00:00Z`).toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric', timeZone: 'UTC' });
const facts: [string, string][] = c
  ? ([
      ['Voltage (nominal)', `${fmt(c.voltage.nominal)} V`],
      ['Voltage with nothing connected (open-circuit)', c.voltage.open_circuit ? range(c.voltage.open_circuit, 'V') : ''],
      ['Voltage when used up (cutoff)', c.voltage.cutoff ? `${fmt(c.voltage.cutoff)} V` : ''],
      ['Charging voltage (maximum)', c.voltage.charge_max ? `${fmt(c.voltage.charge_max)} V` : ''],
      ['Energy per kilogram (Wh/kg)', c.energy_density_wh_kg ? range(c.energy_density_wh_kg, 'Wh/kg') : ''],
      ['Energy per liter (Wh/L)', c.energy_density_wh_l ? range(c.energy_density_wh_l, 'Wh/L') : ''],
      ['Rechargeable', c.rechargeable ? 'Yes' : 'No'],
      ['Letter in battery names (IEC)', c.iec_letter ?? 'None'],
      ['Negative side (anode)', c.anode ?? ''],
      ['Positive side (cathode)', c.cathode ?? ''],
      ['Paste or liquid inside (electrolyte)', c.electrolyte ?? ''],
      ['Charge lost in storage (self-discharge)', c.self_discharge ?? ''],
      ['Working temperature', c.temperature_c?.operating ? `${c.temperature_c.operating[0]} to ${c.temperature_c.operating[1]} °C` : ''],
    ] as [string, string][]).filter(([, v]) => v)
  : [];
const jsonld = c && {
  '@context': 'https://schema.org',
  '@type': 'TechArticle',
  headline: `${name} batteries`,
  ...(techName ? { alternativeHeadline: `${techName} batteries` } : {}),
  description: lede,
  dateModified: c.updated,
  url: `https://batteries.fyi/chemistry/${id}`,
  citation: c.sources.map((s) => ({ '@type': 'CreativeWork', name: s.title, publisher: s.publisher, url: s.url })),
};
---

<BaseLayout title={`${name} batteries: voltage, strengths and sizes | batteries.fyi`} description={lede ?? `${name} batteries in the batteries.fyi database.`} jsonld={jsonld || undefined}>
  <div class="wrap pt-5"><nav class="text-sm text-ink-2" aria-label="Breadcrumb"><a href="/chemistry" class="link">Kinds of battery</a> / <span>{name}</span></nav></div>
  <section class="wrap pt-4 grid gap-8 lg:grid-cols-[1fr_22rem]">
    <div class="min-w-0">
      <h1 class="text-2xl sm:text-3xl font-semibold tracking-tight leading-tight flex items-center gap-3"><span class="dot" style={`background:${meta.color}`} aria-hidden="true"></span>{name}</h1>
      {techName && <p class="mt-2 text-base text-ink-2">Technical name: {techName}</p>}
      {status && <p class="mt-2 text-base font-semibold">{status}</p>}
      {lede && <p class="lede measure mt-3">{lede}</p>}
      {c && (
        <p class="mt-3 text-base measure">{c.rechargeable ? 'Rechargeable' : 'Single-use'}, {fmt(c.voltage.nominal)} volts. {using.length === 0 ? 'No size on this site is listed in this kind yet.' : <><a class="link" href="#sizes">{using.length === 1 ? 'One size' : `${using.length} sizes`} on this site</a> {using.length === 1 ? 'comes' : 'come'} in this kind.</>}</p>
      )}
      {c && (c.strengths.length > 0 || c.limitations.length > 0) && (
        <div class="grid gap-4 sm:grid-cols-2 mt-8 max-w-[40rem]">
          {c.strengths.length > 0 && <div class="callout ok"><p class="label mb-1">Strengths</p><ul class="list-disc pl-5 space-y-1 font-sans text-base">{c.strengths.map((x) => <li>{x}</li>)}</ul></div>}
          {c.limitations.length > 0 && <div class="callout warn"><p class="label mb-1">Limitations</p><ul class="list-disc pl-5 space-y-1 font-sans text-base">{c.limitations.map((x) => <li>{x}</li>)}</ul></div>}
        </div>
      )}
      {c && c.safety.length > 0 && (
        <div class="mt-8 max-w-[40rem]"><h2 class="section-title">Safety</h2><ul class="list-disc pl-5 font-sans text-base text-ink-2 space-y-1">{c.safety.map((x) => <li>{x}</li>)}</ul></div>
      )}
    </div>
    <aside class="min-w-0">
      {facts.length > 0 && (
        <div class="lg:sticky lg:top-20">
          <h2 class="section-title">Specifications</h2>
          <div class="card overflow-hidden">
            <table class="table"><tbody>{facts.map(([k, v]) => <tr><td class="font-sans font-semibold text-ink-2 w-1/2">{k}</td><td class="tabular">{v}</td></tr>)}</tbody></table>
          </div>
        </div>
      )}
    </aside>
  </section>

  <section id="sizes" class="wrap mt-12 scroll-mt-20">
    <h2 class="section-title">Sizes that come in this kind <span class="text-muted font-normal text-sm">{using.length}</span></h2>
    <ul class="grid gap-2 grid-cols-2 sm:grid-cols-3 md:grid-cols-4 lg:grid-cols-6">
      {using.map((b) => {
        const v = b.variants.find((x) => x.chemistry === id)!;
        return (
          <li><a href={`/${b.id}`} class="tile flex flex-col items-center p-2 h-full">
            <div class="h-14 w-full flex items-end justify-center mb-1"><Silhouette battery={b} scaleTo={scale(using)} class="max-w-full" /></div>
            <span class="text-sm font-semibold">{b.name}</span>
            <span class="text-sm text-ink-2 tabular">{fmt(v.voltage.nominal)} V</span>
            <span class="text-sm text-muted tabular">{sizeLabel(b, false)}</span>
          </a></li>
        );
      })}
    </ul>
  </section>

  {c && (
    <section class="wrap mt-12" aria-labelledby="detail-title">
      <h2 id="detail-title" class="section-title">Technical details</h2>
      <div class="prose text-base">
        {p.plain && <p>{c.summary}</p>}
        <Fragment set:html={body} />
      </div>
    </section>
  )}

  {c && (
    <section class="wrap mt-12 max-w-4xl">
      <h2 class="section-title">Sources</h2>
      <Sources sources={c.sources} />
    </section>
  )}
</BaseLayout>
