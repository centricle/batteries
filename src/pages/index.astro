---
import BaseLayout from '../layouts/BaseLayout.astro';
import Viewer from '../components/Viewer.astro';
import Silhouette from '../components/Silhouette.astro';
import { batteries, batteryById, CATEGORY_META, stats, deviceById, devices, deviceTitle, DEVICE_CATEGORY_META, type Device } from '../lib/data';
import { pairs } from '../lib/pairs';

const s = stats();
// Devices people most often ask about, then whatever else exists, to eight.
const featured = ['apple-airtag', 'toyota-rav4-smart-key', 'tesla-model-y-key-fob', 'liftmaster-893max', 'garmin-hrm-dual', 'google-nest-protect-battery', 'honda-cr-v-2025-smart-entry-remote', 'samsung-galaxy-smarttag2']
  .map((id) => deviceById(id))
  .filter((d): d is Device => !!d);
for (const d of devices()) if (featured.length < 8 && !featured.includes(d)) featured.push(d);
const deviceCount = devices().length;
const pick = (ids: string[]) => ids.map((id) => batteryById(id)).filter(Boolean) as ReturnType<typeof batteries>;
const lineup = pick(['d', 'c', 'aa', 'aaa', 'aaaa', '9v', '21700', '18650', 'cr123a', 'cr2032', 'lr44', '312']);
const common = pick(['aa', 'aaa', 'cr2032', 'cr2025', 'cr2016', 'lr44', 'sr626sw', '9v', 'cr123a', '18650', '21700', 'cr2', '312', 'cr1220', 'c', 'd', 'a23', 'cr2450']);
const popularPairs = ['cr2032-vs-cr2025', 'cr2032-vs-cr2016', '18650-vs-21700', 'cr123a-vs-16340', 'aa-vs-14500', 'aa-vs-aaa', 'lr43-vs-lr44', 'lr44-vs-675', 'cr2025-vs-cr2016', '18650-vs-20700']
  .map((slug) => pairs().get(slug) ?? pairs().get(slug.split('-vs-').reverse().join('-vs-')))
  .filter(Boolean);
const tools = [
  { href: '/compare', title: 'Compare in 3D', body: 'Line up any sizes at true scale and read the differences.' },
  { href: '/identify', title: 'Identify by measurement', body: 'Enter diameter and height from calipers or a ruler. Get the closest matches.' },
  { href: '/decode', title: 'Decode a code', body: 'LR6, SR626SW, INR18650, 6LR61. Each letter and number explained.' },
  { href: '/equivalents', title: 'Equivalents table', body: 'Every code, every brand number, one table. 377 = SR626SW = AG4.' },
  { href: '/actual-size', title: 'Actual size', body: 'Calibrate your screen with a card, then hold the battery up to it.' },
  { href: '/calculators', title: 'Calculators', body: 'Runtime, watt-hours, series and parallel packs, airline limits.' },
];
const catRep: Record<string, string> = { household: 'aa', 'li-ion': '18650', coin: 'cr2032', button: 'lr44', 'hearing-aid': '312', photo: 'cr123a', specialty: 'lantern-6v' };
const jsonld = [
  { '@context': 'https://schema.org', '@type': 'WebSite', name: 'batteries.fyi', url: 'https://batteries.fyi/', potentialAction: { '@type': 'SearchAction', target: 'https://batteries.fyi/search?q={query}', 'query-input': 'required name=query' } },
  { '@context': 'https://schema.org', '@type': 'Dataset', name: 'batteries.fyi consumer battery specifications', description: `Dimensions, chemistries, voltages, capacities and cross-reference codes for ${s.batteries} consumer battery sizes, with sources.`, url: 'https://batteries.fyi/data', license: 'https://opensource.org/licenses/MIT', creator: { '@type': 'Organization', name: 'Centricle LLC' }, distribution: [{ '@type': 'DataDownload', encodingFormat: 'application/json', contentUrl: 'https://batteries.fyi/api/batteries.json' }, { '@type': 'DataDownload', encodingFormat: 'text/csv', contentUrl: 'https://batteries.fyi/api/batteries.csv' }] },
];
---

<BaseLayout jsonld={jsonld}>
  <section class="relative overflow-hidden border-b border-line">
    <div class="absolute inset-0 grid-paper opacity-70 pointer-events-none" aria-hidden="true"></div>
    <div class="wrap relative pt-10 sm:pt-14 pb-6">
      <p class="eyebrow">The consumer battery reference</p>
      <h1 class="mt-2 text-[1.9rem] sm:text-[2.6rem] font-medium tracking-[-0.025em] leading-[1.05] max-w-3xl">Every battery, measured and cited.</h1>
      <p class="mt-4 text-[0.85rem] sm:text-[0.95rem] text-ink-2 max-w-2xl">Dimensions with tolerances, every chemistry, every brand and standard code, and a true-scale 3D model for {s.batteries} battery sizes. Each value traces to an IEC standard or a manufacturer datasheet.</p>
      <form action="/search" class="mt-6 max-w-xl relative" role="search" id="hero-search">
        <label for="hero-q" class="sr-only">Search batteries</label>
        <svg class="w-5 h-5 absolute left-3.5 top-1/2 -translate-y-1/2 text-muted pointer-events-none" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="11" cy="11" r="7" /><path d="m21 21-4.3-4.3" /></svg>
        <input id="hero-q" name="q" class="input h-14 pl-11 text-[0.95rem] shadow-sm" placeholder="377, CR2032, 18650, 20 x 3.2, AirTag, RAV4 key" autocomplete="off" />
      </form>
      <div class="mt-3 flex flex-wrap gap-1.5 max-w-3xl">
        {common.map((b) => <a href={`/${b.id}`} class="chip font-medium text-[0.66rem] py-1 px-2.5 bg-surface/80">{b.name}</a>)}
      </div>
    </div>
    <div class="wrap relative pb-8">
      <Viewer batteries={lineup} mode="lineup" height="min(26rem, 70vw)" controls={false} class="border-0 bg-transparent" />
      <p class="text-[0.6rem] text-muted mt-1"><span class="font-mono text-ink-2 uppercase tracking-[0.08em] mr-2">Fig. 1</span>To scale, from the D cell to the size 312 hearing aid cell. Drag to orbit. Labels link to each entry.</p>
    </div>
  </section>

  <section class="wrap mt-10 specs grid-cols-2 md:grid-cols-4">
    {[
      [s.batteries, 'battery sizes'],
      [s.codes, 'cross-reference codes'],
      [s.variants, 'chemistry variants'],
      [s.sources, 'cited sources'],
    ].map(([n, label]) => (
      <div class="spec"><span class="v">{Number(n).toLocaleString('en-US')}</span><span class="s">{label}</span></div>
    ))}
  </section>

  {featured.length > 0 && (
    <section class="wrap mt-12">
      <div class="flex items-baseline justify-between mb-4">
        <h2 class="section-title mb-0">What battery does it take?</h2>
        <a href="/devices" class="link text-[0.7rem]">All {deviceCount} devices</a>
      </div>
      <ul class="grid gap-2 grid-cols-1 sm:grid-cols-2 lg:grid-cols-4">
        {featured.map((d) => {
          const b = batteryById(d.battery)!;
          return (
            <li><a href={`/devices/${d.id}`} class="card flex items-center gap-3 p-3 h-full hover:border-accent transition-colors">
              <span class="min-w-0">
                <span class="block text-[0.75rem] font-semibold text-ink truncate">{deviceTitle(d)}</span>
                <span class="block text-[0.6rem] text-muted">{DEVICE_CATEGORY_META[d.category].one}</span>
              </span>
              <span class="chip ml-auto shrink-0">{d.count > 1 ? `${d.count} × ` : ''}{d.code ?? b.name}</span>
            </a></li>
          );
        })}
      </ul>
      <p class="mt-2 text-[0.62rem] text-muted">Each answer quotes the device maker's manual or support page.</p>
    </section>
  )}

  <section class="wrap mt-12">
    <div class="flex items-baseline justify-between mb-4">
      <h2 class="section-title mb-0">Browse by type</h2>
      <a href="/batteries" class="link text-[0.7rem]">All {s.batteries} sizes</a>
    </div>
    <ul class="grid gap-3 sm:grid-cols-2 lg:grid-cols-4">
      {CATEGORY_META.map((c) => {
        const rep = batteryById(catRep[c.id]);
        const n = batteries().filter((b) => b.category === c.id).length;
        return (
          <li>
            <a href={`/${c.slug}`} class="card group flex gap-4 p-4 h-full hover:border-accent transition-colors">
              <div class="w-16 h-20 shrink-0 flex items-end justify-center">{rep && <Silhouette battery={rep} class="max-h-full max-w-full" />}</div>
              <div class="min-w-0">
                <span class="flex items-baseline gap-2"><span class="font-semibold text-[0.85rem] group-hover:text-accent-ink">{c.name}</span><span class="text-[0.6rem] text-muted">{n}</span></span>
                <p class="text-[0.65rem] text-muted mt-1 leading-snug">{c.description}</p>
              </div>
            </a>
          </li>
        );
      })}
      <li>
        <a href="/equivalents" class="card group flex flex-col justify-center p-4 h-full hover:border-accent transition-colors bg-accent-soft border-accent/30">
          <span class="font-semibold text-[0.85rem] text-accent-ink">Equivalents table</span>
          <p class="text-[0.65rem] text-ink-2 mt-1 leading-snug">All {s.codes.toLocaleString('en-US')} codes on one page, searchable.</p>
        </a>
      </li>
    </ul>
  </section>

  {popularPairs.length > 0 && (
    <section class="wrap mt-12">
      <h2 class="section-title">Head to head</h2>
      <ul class="flex flex-wrap gap-2">
        {popularPairs.map((p) => <li><a href={`/compare/${p!.slug}`} class="chip text-[0.72rem] py-1.5 px-3 hover:border-accent hover:text-accent-ink">{p!.a.name} vs {p!.b.name}</a></li>)}
        <li><a href="/compare#all-pairs" class="chip text-[0.72rem] py-1.5 px-3 text-muted hover:text-ink">All {pairs().size} comparisons</a></li>
      </ul>
    </section>
  )}

  <section class="wrap mt-12">
    <h2 class="section-title">Tools</h2>
    <ul class="grid gap-3 sm:grid-cols-2 lg:grid-cols-3">
      {tools.map((t) => (
        <li><a href={t.href} class="card block p-4 h-full hover:border-accent transition-colors group">
          <span class="font-semibold text-[0.85rem] group-hover:text-accent-ink">{t.title} <span aria-hidden="true">→</span></span>
          <p class="text-[0.68rem] text-muted mt-1">{t.body}</p>
        </a></li>
      ))}
    </ul>
  </section>

  <section class="wrap mt-12 grid gap-6 lg:grid-cols-2">
    <div class="card p-5">
      <h2 class="text-[0.95rem] font-semibold">How the data is built</h2>
      <ul class="mt-3 space-y-2 text-[0.72rem] text-ink-2">
        <li><strong class="text-ink">One entry per physical size.</strong> AA alkaline, AA lithium and AA NiMH are variants of one size, so their codes and dimensions live together.</li>
        <li><strong class="text-ink">No number without a source.</strong> Every value lists the datasheet or standard it came from and the date it was read. Unpublished values stay blank.</li>
        <li><strong class="text-ink">Models from measurements.</strong> Each 3D model, drawing and silhouette is generated from the same dimensions the table shows.</li>
        <li><strong class="text-ink">Open.</strong> The whole dataset and every model are downloadable under the MIT license.</li>
      </ul>
      <a href="/data" class="btn mt-4">Open data and models</a>
    </div>
    <div class="card p-5">
      <h2 class="text-[0.95rem] font-semibold">Reference</h2>
      <ul class="mt-3 grid gap-1.5 text-[0.72rem]">
        <li><a class="link" href="/reference/battery-naming">How battery names and codes work</a></li>
        <li><a class="link" href="/reference/air-travel">Lithium batteries on airplanes</a></li>
        <li><a class="link" href="/reference/button-battery-ingestion">Swallowed coin and button cells</a></li>
        <li><a class="link" href="/reference/capacity-explained">What mAh and Wh mean, and why capacity varies</a></li>
        <li><a class="link" href="/reference/rechargeable-vs-disposable">Rechargeable and disposable, compared</a></li>
        <li><a class="link" href="/chemistry">Battery chemistries</a></li>
        <li><a class="link" href="/glossary">Glossary</a></li>
      </ul>
    </div>
  </section>
</BaseLayout>

<script>
  // The hero field hands off to the command palette as soon as someone types.
  const f = document.getElementById('hero-q') as HTMLInputElement | null;
  f?.addEventListener('input', () => {
    const open = document.querySelector('[data-search-open]') as HTMLElement | null;
    const v = f.value;
    open?.click();
    const si = document.getElementById('search-input') as HTMLInputElement | null;
    if (si) {
      si.value = v;
      si.dispatchEvent(new Event('input'));
    }
    f.value = '';
  });
</script>
