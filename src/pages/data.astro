---
import BaseLayout from '../layouts/BaseLayout.astro';
import { stats, batteries } from '../lib/data';
const s = stats();
const sample = batteries().find((b) => b.id === 'cr2032') ?? batteries()[0];
const files = [
  { href: '/api/batteries.json', name: 'batteries.json', body: 'The full dataset: every battery and every kind, exactly as checked when the site was built.' },
  { href: '/api/batteries.csv', name: 'batteries.csv', body: 'One row for each size in each kind, for spreadsheets.' },
  { href: '/api/codes.json', name: 'codes.json', body: 'Every other name, each matched to its battery.' },
  { href: `/api/batteries/${sample.id}.json`, name: '/api/batteries/{id}.json', body: 'One battery per file, at the same id as its page.' },
  { href: '/api/search-index.json', name: 'search-index.json', body: 'The compact index the site search uses.' },
];
const jsonld = {
  '@context': 'https://schema.org',
  '@type': 'Dataset',
  name: 'batteries.fyi consumer battery specifications',
  description: `Sizes, kinds, voltages, capacities, other names and 3D models for ${s.batteries} consumer battery sizes, each value with its source.`,
  url: 'https://batteries.fyi/data',
  license: 'https://opensource.org/licenses/MIT',
  isAccessibleForFree: true,
  creator: { '@type': 'Organization', name: 'Centricle LLC', url: 'https://centricle.com' },
  variableMeasured: ['diameter', 'height', 'nominal voltage', 'capacity', 'weight', 'operating temperature'],
  distribution: [
    { '@type': 'DataDownload', encodingFormat: 'application/json', contentUrl: 'https://batteries.fyi/api/batteries.json' },
    { '@type': 'DataDownload', encodingFormat: 'text/csv', contentUrl: 'https://batteries.fyi/api/batteries.csv' },
  ],
};
---

<BaseLayout title="Battery data and 3D models to download | batteries.fyi" description={`Download the batteries.fyi data (${s.batteries} sizes, ${s.codes.toLocaleString('en-US')} other names) as JSON or CSV, and a GLB and STL model of every battery. MIT licensed.`} jsonld={jsonld}>
  <section class="wrap pt-8 max-w-4xl">
    <h1 class="text-2xl sm:text-3xl font-semibold tracking-tight">Data and 3D models</h1>
    <p class="lede measure mt-3">Everything on this site comes from one folder of files, one for each battery size. You can download the data, the 3D models and the code and use them for anything, under the MIT license. A link back is appreciated.</p>
    <p class="mt-3 text-base measure">This page is for people who build things with the data: engineers, hobbyists and developers. Each file is checked against a fixed format (a schema) every time the site is built.</p>
  </section>

  <section class="wrap mt-8 max-w-4xl">
    <h2 class="section-title">Downloads</h2>
    <ul class="card divide-y divide-[var(--line)]">
      {files.map((f) => (
        <li class="p-4 flex flex-wrap items-baseline gap-x-4 gap-y-1">
          <a href={f.href} class="link mono text-base">{f.name}</a>
          <span class="font-sans text-base text-ink-2">{f.body}</span>
        </li>
      ))}
    </ul>
  </section>

  <section class="wrap mt-10 max-w-4xl">
    <h2 class="section-title">3D models</h2>
    <p class="text-base text-ink-2">Every battery has three model files, made from its listed (nominal) dimensions by the same code that draws the model on its page:</p>
    <ul class="mt-3 space-y-2 font-sans text-base text-ink-2">
      <li><strong class="text-ink">GLB</strong> (<span class="mono">/models/&#123;id&#125;.glb</span>): glTF 2.0 binary with PBR materials, true scale in meters, Y up. Opens in Blender, three.js, model viewers and AR Quick Look converters.</li>
      <li><strong class="text-ink">STL</strong> (<span class="mono">/models/&#123;id&#125;.stl</span>): binary, millimeters, Z up. For CAD, enclosure design and battery holder prints. Each part is a closed shell; slicers merge them.</li>
      <li><strong class="text-ink">USDZ</strong> (<span class="mono">/models/&#123;id&#125;.usdz</span>): for AR Quick Look on iPhone and iPad. Battery pages offer "View in AR at actual size" on phones, which places the model on a surface at its real size.</li>
    </ul>
    <p class="mt-3 callout info">Models use the nominal dimensions. For a press fit, design to the maximum dimensions in the battery's tolerance table, not the model.</p>
  </section>

  <section class="wrap mt-10 max-w-4xl">
    <h2 class="section-title">How the files are organized</h2>
    <p class="text-base text-ink-2">Each battery file is one physical size, with a <span class="mono">variants</span> list holding one entry for each kind it is made in. Every IEC, ANSI, JIS and maker name lives in one <span class="mono">codes</span> list. Every number traces to an entry in <span class="mono">sources</span>, and dimensions and variants list which sources support them. The field reference is <a class="link" href="https://github.com/centricle/batteries/blob/main/data/SCHEMA.md">SCHEMA.md</a>; the validator is <a class="link" href="https://github.com/centricle/batteries/blob/main/src/lib/schema.mjs">schema.mjs</a>.</p>
    <details class="card mt-4 p-4">
      <summary class="cursor-pointer text-sm font-semibold py-1.5">Example: {sample.name}</summary>
      <pre class="mt-3 text-xs leading-snug overflow-x-auto max-h-[28rem]"><code>{JSON.stringify(sample, null, 2)}</code></pre>
    </details>
  </section>

  <section class="wrap mt-10 max-w-4xl">
    <h2 class="section-title">Sending a correction</h2>
    <p class="text-base text-ink-2">The repository is <a class="link" href="https://github.com/centricle/batteries">centricle/batteries</a>. A correction is an edit to one JSON file with a source that supports it: a maker's datasheet, a standard, or a distributor listing that reproduces one. Run <span class="mono">npm run validate</span> before opening a pull request; the build refuses data that fails the schema.</p>
  </section>
</BaseLayout>
