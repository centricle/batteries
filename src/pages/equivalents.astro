---
import BaseLayout from '../layouts/BaseLayout.astro';
import { batteries, categoryById, fmt, sizeLabel, voltages, stats } from '../lib/data';

const list = batteries();
const s = stats();
const rows = list.map((b) => ({
  b,
  iec: [...new Set(b.codes.filter((c) => c.system === 'IEC').map((c) => c.code))],
  ansi: [...new Set(b.codes.filter((c) => c.system === 'ANSI' || c.system === 'NEDA').map((c) => c.code))],
  other: b.codes.filter((c) => !['IEC', 'ANSI', 'NEDA'].includes(c.system)),
}));
const orList = (xs: string[]) => (xs.length < 2 ? xs.join('') : `${xs.slice(0, -1).join(', ')} or ${xs[xs.length - 1]}`);
const jsonld = {
  '@context': 'https://schema.org',
  '@type': 'Dataset',
  name: 'Other names for every battery size',
  description: `Every IEC, ANSI, JIS and brand name for ${s.batteries} consumer battery sizes, mapped to one physical size each.`,
  url: 'https://batteries.fyi/equivalents',
  license: 'https://opensource.org/licenses/MIT',
  distribution: [{ '@type': 'DataDownload', encodingFormat: 'application/json', contentUrl: 'https://batteries.fyi/api/codes.json' }],
};
---

<BaseLayout title="Battery equivalents: other names for every battery | batteries.fyi" description={`Every name a battery is sold under, on one page: ${s.codes.toLocaleString('en-US')} standard and brand names for ${s.batteries} sizes. A 377 is an SR626SW, an LR44 is also sold as AG13, 357 and A76, and an LR6 is an AA.`} jsonld={jsonld}>
  <section class="wrap pt-8">
    <h1 class="text-2xl sm:text-3xl font-semibold">Other names for every battery</h1>
    <p class="lede measure mt-3">A 377, an SR626SW and an AG4 are the same battery. Makers and standards give one size many names, and this table puts them together.</p>
    <p class="mt-2 text-base text-ink-2 measure">Each row is one size. Names in the same row fit the same holder. Some names also tell you the kind: an LR44 is alkaline and an SR44 is silver oxide. The kind can matter in some devices, so check the battery's page before you swap one for another.</p>
    <div class="mt-5 max-w-md">
      <label for="eq-filter" class="label block mb-1">Find a name</label>
      <input id="eq-filter" class="input" placeholder="377, AG13, MN1500" autocomplete="off" />
      <p id="eq-count" class="mt-1 text-sm text-ink-2" aria-live="polite"></p>
    </div>
  </section>
  <section class="wrap mt-5">
    <div class="card table-scroll">
      <table class="table min-w-[48rem]">
        <thead><tr><th>Battery</th><th>Type</th><th class="n">Size (mm)</th><th class="n">Volts</th><th>Standard name (IEC)</th><th>US standard (ANSI)</th><th>Maker and other names</th></tr></thead>
        <tbody id="eq-body">
          {rows.map(({ b, iec, ansi, other }) => (
            <tr data-k={[b.name, b.id, ...b.aliases, ...b.codes.map((c) => c.code)].join('|').toLowerCase().replace(/[^a-z0-9.|]/g, '')}>
              <td class="font-semibold whitespace-nowrap"><a href={`/${b.id}`} class="link">{b.name}</a></td>
              <td class="whitespace-nowrap text-ink-2">{categoryById[b.category].short}</td>
              <td class="n whitespace-nowrap">{sizeLabel(b, false)}</td>
              <td class="n whitespace-nowrap">{orList(voltages(b).map((v) => fmt(v, 2)))}</td>
              <td class="mono">{iec.join(', ')}</td>
              <td class="mono">{ansi.join(', ')}</td>
              <td class="text-ink-2">
                {other.map((c, i) => <span class="whitespace-nowrap">{c.system} <span class="mono text-ink">{c.code}</span>{i < other.length - 1 || b.aliases.length ? ', ' : ''}</span>)}
                {b.aliases.length > 0 && <span>{b.aliases.join(', ')}</span>}
              </td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
    <p class="mt-3 text-sm text-ink-2 measure">The same list is free to download as <a class="link" href="/api/codes.json">JSON</a> and <a class="link" href="/api/batteries.csv">CSV</a>. The sources for every name are on each battery's page.</p>
  </section>
</BaseLayout>

<script>
  const input = document.getElementById('eq-filter') as HTMLInputElement;
  const rows = [...document.querySelectorAll<HTMLTableRowElement>('#eq-body tr')];
  const count = document.getElementById('eq-count')!;
  const apply = () => {
    const q = input.value.toLowerCase().replace(/[^a-z0-9.]/g, '');
    let n = 0;
    for (const r of rows) {
      const hit = !q || r.dataset.k!.split('|').some((k) => k.includes(q));
      r.hidden = !hit;
      if (hit) n++;
    }
    count.textContent = q ? (n ? `${n} size${n === 1 ? '' : 's'} match.` : 'No size has that name. Check the spelling, or try fewer letters.') : '';
    const u = new URL(location.href);
    if (input.value) u.searchParams.set('q', input.value); else u.searchParams.delete('q');
    history.replaceState(null, '', u);
  };
  input.value = new URLSearchParams(location.search).get('q') ?? '';
  input.addEventListener('input', apply);
  apply();
</script>
