---
// Every size, grouped by type, the most common first in each group.
import BaseLayout from '../layouts/BaseLayout.astro';
import Silhouette from '../components/Silhouette.astro';
import { batteries, CATEGORY_META } from '../lib/data';
import { byCommon, list as listWords, tileFacts } from '../lib/plain';

const all = batteries();
const groups = CATEGORY_META.map((c) => ({ c, list: all.filter((b) => b.category === c.id).sort(byCommon) })).filter((g) => g.list.length);
const typeNames = CATEGORY_META.map((c) => c.name.toLowerCase());
---

<BaseLayout title={`All ${all.length} battery sizes | batteries.fyi`} description={`Every battery size on batteries.fyi, ${all.length} in all, grouped by type: ${listWords(typeNames)}.`}>
  <section class="wrap pt-8">
    <h1 class="text-2xl sm:text-3xl font-semibold">All battery sizes</h1>
    <p class="lede measure mt-3">Every size on the site is here, {all.length} in all, grouped by type with the most common first. Choose one to see its size, other names and what else fits.</p>
    <nav class="mt-5" aria-label="Jump to a type">
      <ul class="flex flex-wrap gap-2">
        {groups.map(({ c, list }) => <li><a href={`#${c.slug}`} class="chip link">{c.name} ({list.length})</a></li>)}
      </ul>
    </nav>
  </section>
  {groups.map(({ c, list }) => {
    const scale = Math.max(...list.map((b) => (b.form === 'disc' ? b.dimensions.diameter!.nominal : b.dimensions.height.nominal)));
    return (
      <section class="wrap mt-12 scroll-mt-20" id={c.slug}>
        <h2 class="section-title">{c.name}</h2>
        <p class="lede measure mb-4">{c.description}</p>
        <ul class="grid gap-3 grid-cols-1 min-[26rem]:grid-cols-2 sm:grid-cols-3 lg:grid-cols-4 xl:grid-cols-5">
          {list.map((b) => {
            const f = tileFacts(b);
            return (
              <li>
                <a href={`/${b.id}`} class="tile card group flex flex-col h-full p-4">
                  <span class="h-20 w-full flex items-end justify-center mb-2"><Silhouette battery={b} scaleTo={scale} class="max-w-full" /></span>
                  <span class="font-mono font-semibold text-lg text-ink group-hover:underline">{b.name}</span>
                  <span class="mt-1 font-sans text-sm text-ink-2">{f.size}</span>
                  <span class="font-sans text-sm text-ink-2">{f.volts}</span>
                  {f.names.length > 0 && <span class="mt-1 font-sans text-sm text-ink-2">Also called {listWords(f.names)}</span>}
                </a>
              </li>
            );
          })}
        </ul>
        <p class="mt-3 text-base"><a href={`/${c.slug}`} class="link">See all {list.length} side by side</a></p>
      </section>
    );
  })}
</BaseLayout>
