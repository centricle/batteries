---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

// The URL stays /reference; a visitor reads "Guides".
const items = (await getCollection('reference')).sort((a, b) => (a.data.order ?? 99) - (b.data.order ?? 99) || a.data.title.localeCompare(b.data.title));
const SAFETY = new Set(['button-battery-ingestion', 'leakage', 'air-travel', 'recycling-and-disposal', 'shelf-life-and-storage', 'lithium-ion-safety']);
const groups = [
  { id: 'safety', title: 'Safety and care', items: items.filter((e) => SAFETY.has(e.id)) },
  { id: 'reading', title: 'Reading and comparing batteries', items: items.filter((e) => !SAFETY.has(e.id)) },
].filter((g) => g.items.length);
---

<BaseLayout title="Battery guides: swallowed batteries, leaks, flying, disposal and names | batteries.fyi" description="What to do if a battery is swallowed or leaks, how to fly with batteries and throw them away, how to store them, and what the letters and numbers on a battery mean. Each guide lists its sources.">
  <section class="wrap pt-8 max-w-4xl">
    <h1 class="text-2xl sm:text-3xl font-semibold tracking-tight">Guides</h1>
    <p class="lede measure mt-3">What to do when a battery is swallowed, leaks or has to fly with you, and how to read what is printed on one. Each guide lists the sources it is based on.</p>
    <p class="mt-3 text-base measure">Words you do not know are explained in the <a class="link" href="/glossary">glossary</a>. Each <a class="link" href="/chemistry">kind of battery</a> has its own page.</p>
  </section>
  {groups.map((g) => (
    <section class="wrap mt-10 max-w-4xl" aria-labelledby={`group-${g.id}`}>
      <h2 id={`group-${g.id}`} class="section-title">{g.title}</h2>
      <ul class="grid gap-3 sm:grid-cols-2">
        {g.items.map((e) => (
          <li><a href={`/reference/${e.id}`} class="tile block h-full">
            <span class="block font-semibold text-lg">{e.data.title}</span>
            <span class="block font-sans text-base text-ink-2 mt-1">{e.data.description}</span>
          </a></li>
        ))}
      </ul>
    </section>
  ))}
</BaseLayout>
