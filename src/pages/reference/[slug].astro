---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Silhouette from '../../components/Silhouette.astro';
import { getCollection, render } from 'astro:content';
import { batteryById } from '../../lib/data';

export async function getStaticPaths() {
  const items = await getCollection('reference');
  return items.map((e) => ({ params: { slug: e.id }, props: { entry: e } }));
}
const { entry } = Astro.props;
const { Content, headings } = await render(entry);
const d = entry.data;
const related = (d.related ?? []).map((id) => batteryById(id)).filter(Boolean);
const iso = (x?: Date) => (x ? x.toISOString().slice(0, 10) : '');
const url = `https://batteries.fyi/reference/${entry.id}`;
const jsonld = {
  '@context': 'https://schema.org',
  '@type': 'TechArticle',
  headline: d.title,
  description: d.description,
  dateModified: iso(d.updated),
  url,
  publisher: { '@type': 'Organization', name: 'batteries.fyi', url: 'https://batteries.fyi' },
  citation: d.sources.map((s) => ({ '@type': 'CreativeWork', name: s.title, publisher: s.publisher, url: s.url })),
};
---

<BaseLayout title={`${d.title} | batteries.fyi`} description={d.description} jsonld={jsonld}>
  <div class="wrap pt-5"><nav class="text-[0.65rem] text-muted" aria-label="Breadcrumb"><a href="/reference" class="hover:text-ink">Reference</a> / <span class="text-ink-2">{d.title}</span></nav></div>
  <div class="wrap pt-4 grid gap-10 lg:grid-cols-[1fr_15rem]">
    <article class="min-w-0">
      <h1 class="text-[2rem] font-[750] tracking-tight leading-tight max-w-3xl">{d.title}</h1>
      <p class="mt-2 text-[0.65rem] text-muted">Updated {iso(d.updated)} · {d.sources.length} sources</p>
      <div class="prose mt-6"><Content /></div>
      <section class="mt-12 max-w-[40rem]">
        <h2 class="section-title">Sources</h2>
        <ol class="space-y-2 text-[0.68rem]">
          {d.sources.map((s, i) => (
            <li class="flex gap-3"><span class="text-muted tabular w-5 text-right shrink-0">{i + 1}.</span><span><span class="text-ink-2">{s.publisher}.</span> {s.url ? <a class="link" href={s.url} rel="nofollow noopener" target="_blank">{s.title}</a> : s.title}{s.accessed && <span class="text-muted">. Accessed {iso(s.accessed)}.</span>}</span></li>
          ))}
        </ol>
      </section>
    </article>
    <aside class="hidden lg:block">
      <div class="sticky top-20 space-y-6">
        {headings.filter((h) => h.depth === 2).length > 2 && (
          <nav aria-label="On this page">
            <p class="eyebrow mb-2">On this page</p>
            <ul class="space-y-1.5 text-[0.65rem]">
              {headings.filter((h) => h.depth === 2).map((h) => <li><a href={`#${h.slug}`} class="text-ink-2 hover:text-accent-ink">{h.text}</a></li>)}
            </ul>
          </nav>
        )}
        {related.length > 0 && (
          <div>
            <p class="eyebrow mb-2">Related sizes</p>
            <ul class="grid grid-cols-3 gap-2">
              {related.map((b) => (
                <li><a href={`/${b!.id}`} class="card flex flex-col items-center p-2 hover:border-accent">
                  <div class="h-12 w-full flex items-end justify-center"><Silhouette battery={b!} class="max-h-full max-w-full" /></div>
                  <span class="text-[0.58rem] font-semibold mt-1">{b!.name}</span>
                </a></li>
              ))}
            </ul>
          </div>
        )}
      </div>
    </aside>
  </div>
</BaseLayout>
