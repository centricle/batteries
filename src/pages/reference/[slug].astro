---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Silhouette from '../../components/Silhouette.astro';
import Sources from '../../components/Sources.astro';
import { getCollection, render } from 'astro:content';
import { batteryById } from '../../lib/data';

export async function getStaticPaths() {
  const items = await getCollection('reference');
  return items.map((e) => ({ params: { slug: e.id }, props: { entry: e } }));
}
const { entry } = Astro.props;
const { Content, headings } = await render(entry);
const d = entry.data;
const related = (d.related ?? []).map((id) => batteryById(id)).filter(Boolean);
const iso = (x?: Date) => (x ? x.toISOString().slice(0, 10) : '');
const long = (x?: Date) => (x ? x.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric', timeZone: 'UTC' }) : '');
const h2s = headings.filter((h) => h.depth === 2);
const url = `https://batteries.fyi/reference/${entry.id}`;
const jsonld = {
  '@context': 'https://schema.org',
  '@type': 'TechArticle',
  headline: d.title,
  description: d.description,
  dateModified: iso(d.updated),
  url,
  publisher: { '@type': 'Organization', name: 'batteries.fyi', url: 'https://batteries.fyi' },
  citation: d.sources.map((s) => ({ '@type': 'CreativeWork', name: s.title, publisher: s.publisher, url: s.url })),
};
---

<BaseLayout title={`${d.title} | batteries.fyi`} description={d.description} jsonld={jsonld}>
  <div class="wrap pt-5"><nav class="text-sm text-ink-2" aria-label="Breadcrumb"><a href="/reference" class="link">Guides</a> / <span>{d.title}</span></nav></div>
  <div class="wrap pt-4 grid gap-10 lg:grid-cols-[1fr_15rem]">
    <article class="min-w-0">
      <h1 class="text-2xl sm:text-3xl font-semibold tracking-tight leading-tight max-w-3xl">{d.title}</h1>
      <p class="mt-2 text-sm text-muted">Updated {long(d.updated)}. Based on <a class="link" href="#sources">{d.sources.length} sources</a>.</p>
      <div class="prose text-base mt-6"><Content /></div>
      <section id="sources" class="mt-12 max-w-[40rem] scroll-mt-20" aria-labelledby="sources-title">
        <h2 id="sources-title" class="section-title">Sources</h2>
        <Sources sources={d.sources} />
      </section>
    </article>
    <aside class="min-w-0">
      <div class="lg:sticky lg:top-20 space-y-6">
        {h2s.length > 2 && (
          <nav aria-label="On this page" class="hidden lg:block">
            <p class="label mb-2">On this page</p>
            <ul class="space-y-1 text-sm">
              {h2s.map((h) => <li><a href={`#${h.slug}`} class="link inline-flex min-h-8 items-center">{h.text}</a></li>)}
            </ul>
          </nav>
        )}
        {related.length > 0 && (
          <div>
            <p class="label mb-2">Sizes in this guide</p>
            <ul class="grid grid-cols-3 sm:grid-cols-6 lg:grid-cols-3 gap-2">
              {related.map((b) => (
                <li><a href={`/${b!.id}`} class="tile flex flex-col items-center p-2 h-full">
                  <div class="h-12 w-full flex items-end justify-center"><Silhouette battery={b!} class="max-h-full max-w-full" /></div>
                  <span class="text-sm font-semibold mt-1">{b!.name}</span>
                </a></li>
              ))}
            </ul>
          </div>
        )}
      </div>
    </aside>
  </div>
</BaseLayout>
