---
// One page per device: the answer first, then the maker's quote that says so,
// then what else fits, read from the battery's own interchange data.
import BaseLayout from '../../layouts/BaseLayout.astro';
import Silhouette from '../../components/Silhouette.astro';
import Buy from '../../components/Buy.astro';
import { REL_META } from '../../lib/pairs';
import { art, longDate, otherNames, plainSize } from '../../lib/plain';
import {
  batteries, batteryById, deviceTitle, devices, devicesFor, DEVICE_CATEGORY_META, fmt,
  type Battery, type Device,
} from '../../lib/data';

export function getStaticPaths() {
  return devices().map((d) => ({ params: { id: d.id }, props: { device: d } }));
}

interface Props { device: Device }
const { device: d } = Astro.props;
const b = batteryById(d.battery)!;
const cat = DEVICE_CATEGORY_META[d.category];
const title = deviceTitle(d);
const code = d.code ?? b.name;

// Plain-word helpers, local to this page. The shared ones (a or an, the size
// sentence, dates) come from src/lib/plain.ts.
const WORDS = ['no', 'one', 'two', 'three', 'four', 'five', 'six', 'seven', 'eight', 'nine', 'ten'];
const countWord = (n: number) => WORDS[n] ?? String(n);
const orList = (xs: string[]) => (xs.length < 2 ? xs.join('') : `${xs.slice(0, -1).join(', ')} or ${xs[xs.length - 1]}`);
const plainVolts = (x: Battery) => {
  const list = (re: boolean) => [...new Set(x.variants.filter((v) => v.rechargeable === re).map((v) => v.voltage.nominal))].sort((p, q) => p - q).map((n) => fmt(n));
  const once = list(false), again = list(true);
  if (once.length && again.length) return `Single-use ones are ${orList(once)} volts and rechargeable ones are ${orList(again)} volts.`;
  if (again.length) return `It is rechargeable, ${orList(again)} volts.`;
  return `It is ${orList(once)} volts.`;
};

const yearsWords = d.years ? (d.years.endsWith('-') ? `from ${d.years.slice(0, -1)} on` : d.years.includes('-') ? d.years.replace('-', ' to ') : d.years) : '';
const answer = `The ${title} takes ${countWord(d.count)} ${code} ${d.count === 1 ? 'battery' : 'batteries'}.`;
// The device's note, when there is one, already explains a maker name that differs from the page name.
const sameNote = code !== b.name && !d.note ? `${code} is one of the names for the ${b.name} size.` : '';
// Only names for the same battery that a shopper finds on a pack (plain.ts
// otherNames). The full code list also holds names for other kinds in the same
// case (LIR2032 is 3.6 V and does not work where a CR2032 does), so it is not
// what "Also sold as" may show.
const names = otherNames(b).filter((c) => c !== code);

// What else fits: entries declared on this battery, plus reverse entries only
// where the relation reads the same both ways (equivalent, same size). A
// "fits, with a catch" declared on another battery describes this one going
// into that one's holder, which is the opposite of what a reader here needs.
const SYMMETRIC = new Set(['equivalent', 'same-size']);
const fits = [
  ...b.interchange.map((r) => ({ ...r, other: batteryById(r.id) })),
  ...batteries()
    .filter((x) => x.id !== b.id && !b.interchange.some((r) => r.id === x.id))
    .flatMap((x) => x.interchange.filter((r) => r.id === b.id && SYMMETRIC.has(r.relation)).map((r) => ({ id: x.id, relation: r.relation, note: r.note, other: x as Battery | undefined }))),
].filter((r): r is typeof r & { other: Battery } => !!r.other && !!REL_META[r.relation]);

const sameBattery = devicesFor(b.id).filter((x) => x.id !== d.id).slice(0, 12);
const sameCategory = devices().filter((x) => x.category === d.category && x.id !== d.id && x.battery !== d.battery).slice(0, 12);
const url = `https://batteries.fyi/devices/${d.id}`;
const q = `What battery does the ${title} take?`;
const a = [
  answer,
  `${d.source.publisher} says so in ${d.source.title}.`,
  sameNote,
  d.note ?? '',
  names.length ? `The ${b.name} is also sold as ${names.slice(0, 5).join(', ')}.` : '',
].filter(Boolean).join(' ');

const jsonld = [
  { '@context': 'https://schema.org', '@type': 'FAQPage', mainEntity: [{ '@type': 'Question', name: q, acceptedAnswer: { '@type': 'Answer', text: a } }] },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Devices', item: 'https://batteries.fyi/devices' },
      { '@type': 'ListItem', position: 2, name: cat.name, item: `https://batteries.fyi/devices#${d.category}` },
      { '@type': 'ListItem', position: 3, name: title, item: url },
    ],
  },
  {
    '@context': 'https://schema.org',
    '@type': 'WebPage',
    url,
    name: q,
    dateModified: d.source.accessed,
    citation: { '@type': 'CreativeWork', name: d.source.title, publisher: d.source.publisher, url: d.source.url },
  },
];
---

<BaseLayout title={`${title} battery: ${d.count > 1 ? `${d.count} × ` : ''}${code} | batteries.fyi`} description={a.slice(0, 300)} jsonld={jsonld}>
  <div class="wrap pt-5 max-w-4xl">
    <nav aria-label="Breadcrumb" class="text-sm text-ink-2 flex flex-wrap items-center gap-x-2">
      <a href="/devices" class="link">Devices</a><span aria-hidden="true">/</span>
      <a href={`/devices#${d.category}`} class="link">{cat.name}</a><span aria-hidden="true">/</span>
      <span aria-current="page">{title}</span>
    </nav>
  </div>

  <section class="wrap pt-4 pb-6 max-w-4xl">
    <h1 class="text-2xl sm:text-3xl font-semibold">{q}</h1>
    <p class="mt-4 text-xl text-ink measure" data-answer>{answer}</p>
    {(d.models || yearsWords) && (
      <dl class="mt-3 grid grid-cols-[auto_1fr] gap-x-4 gap-y-1 text-base">
        {d.models && <><dt class="label">Model</dt><dd>{d.models}</dd></>}
        {yearsWords && <><dt class="label">Years</dt><dd>{yearsWords}</dd></>}
      </dl>
    )}
    {(sameNote || d.note) && <p class="mt-3 text-base text-ink-2 measure">{sameNote}{sameNote && d.note ? ' ' : ''}{d.note}</p>}

    <figure class="mt-5 callout">
      <blockquote class="text-base text-ink">“{d.source.quote}”</blockquote>
      <figcaption class="mt-2 text-sm text-ink-2">
        {d.source.publisher}, <a class="link" href={d.source.url} rel="nofollow noopener" target="_blank">{d.source.title}</a>. Checked {longDate(d.source.accessed)}.
      </figcaption>
    </figure>

    <div class="mt-6 card p-5 grid gap-5 sm:grid-cols-[auto_1fr] items-center">
      <a href={`/${b.id}`} class="flex items-center justify-center w-28 h-28 bg-surface-2 border border-line" aria-label={`${b.name} battery page`}>
        <Silhouette battery={b} class="max-w-[5.5rem] max-h-[5.5rem]" />
      </a>
      <div class="min-w-0">
        <p class="font-mono text-3xl font-semibold leading-none"><a href={`/${b.id}`} class="link">{b.name}</a></p>
        <p class="mt-3 text-base text-ink-2">{art(b.name) === 'an' ? 'An' : 'A'} {b.name} is {plainSize(b)}. {plainVolts(b)}</p>
        {names.length > 0 && (
          <div class="mt-3">
            <p class="label mb-1">Also sold as</p>
            <div class="flex flex-wrap gap-2">
              {names.map((c) => <span class="chip">{c}</span>)}
              <a href={`/${b.id}#codes`} class="chip">All names</a>
            </div>
          </div>
        )}
      </div>
    </div>

    <Buy battery={b} context="device" class="mt-5" />
  </section>

  <div class="wrap max-w-4xl space-y-10 pb-6">
    <section id="fits">
      <h2 class="section-title">Will another battery work instead?</h2>
      {fits.length > 0 ? (
        <>
          <p class="text-base text-ink-2 measure mb-4">Batteries that are sometimes used in place of {art(b.name)} {b.name}, and whether they work. If your device maker says something different, follow the maker.</p>
          <div class="grid gap-3 sm:grid-cols-2">
            {fits.map((r) => (
              <div class:list={['callout', REL_META[r.relation].cls]}>
                <p class="text-lg font-semibold text-ink">{REL_META[r.relation].label}: <a class="link" href={`/${r.other.id}`}>{r.other.name}</a></p>
                <p class="mt-1 text-base text-ink-2">{r.note}</p>
              </div>
            ))}
          </div>
        </>
      ) : (
        <p class="text-base text-ink-2 measure">No other battery is listed as working in place of {art(b.name)} {b.name}. Use the battery your device maker names.</p>
      )}
    </section>

    <section>
      <h2 class="section-title">More about the {b.name}</h2>
      <div class="flex flex-wrap gap-3">
        <a href={`/${b.id}`} class="btn btn-primary">Open the {b.name} battery page</a>
        <a href={`/actual-size?ids=${b.id}`} class="btn">See it at actual size</a>
      </div>
    </section>

    {sameBattery.length > 0 && (
      <section>
        <h2 class="section-title">Other devices that take {art(b.name)} {b.name}</h2>
        <ul class="flex flex-wrap gap-2">
          {sameBattery.map((x) => <li><a class="chip whitespace-normal" href={`/devices/${x.id}`}>{deviceTitle(x)}</a></li>)}
        </ul>
      </section>
    )}
    {sameCategory.length > 0 && (
      <section>
        <h2 class="section-title">Other {cat.name.toLowerCase()}</h2>
        <ul class="grid gap-2 grid-cols-1 sm:grid-cols-2 text-base">
          {sameCategory.map((x) => (
            <li class="min-w-0"><a class="flex gap-3 min-w-0 min-h-8 items-center" href={`/devices/${x.id}`}><span class="link truncate min-w-0">{deviceTitle(x)}</span><span class="ml-auto text-ink-2 font-mono text-sm shrink-0">{x.count > 1 ? `${x.count} × ` : ''}{x.code ?? batteryById(x.battery)!.name}</span></a></li>
          ))}
        </ul>
      </section>
    )}
    <section class="card p-5 text-sm text-ink-2">
      <h2 class="text-lg font-semibold mb-2 text-ink">Where this comes from</h2>
      <p>Device entries quote the device maker only: the owner's manual, support page or spec sheet shown above. If a maker changes the battery in a later model, that model gets its own entry. Corrections with a maker source are welcome on <a class="link" href={`https://github.com/centricle/batteries/blob/main/data/devices/${d.id}.json`}>GitHub</a>, where <a class="link" href={`https://github.com/centricle/batteries/commits/main/data/devices/${d.id}.json`}>every change to this entry</a> is public.</p>
    </section>
  </div>
</BaseLayout>
