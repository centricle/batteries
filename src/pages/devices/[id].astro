---
// One page per device: the answer first, then the quote that proves it.
import BaseLayout from '../../layouts/BaseLayout.astro';
import Silhouette from '../../components/Silhouette.astro';
import Buy from '../../components/Buy.astro';
import {
  batteryById, deviceAnswer, deviceTitle, devices, devicesFor, DEVICE_CATEGORY_META, fmt, sizeLabel, voltages, volts,
  type Device,
} from '../../lib/data';

export function getStaticPaths() {
  return devices().map((d) => ({ params: { id: d.id }, props: { device: d } }));
}

interface Props { device: Device }
const { device: d } = Astro.props;
const b = batteryById(d.battery)!;
const cat = DEVICE_CATEGORY_META[d.category];
const title = deviceTitle(d);
const code = d.code ?? b.name;
const answer = deviceAnswer(d);
const years = d.years ? (d.years.endsWith('-') ? `${d.years.slice(0, -1)} on` : d.years.replace('-', '–')) : '';
const codes = [...new Set(b.codes.map((c) => c.code))].filter((c) => c !== b.name).slice(0, 10);
const sameBattery = devicesFor(b.id).filter((x) => x.id !== d.id).slice(0, 12);
const sameCategory = devices().filter((x) => x.category === d.category && x.id !== d.id && x.battery !== d.battery).slice(0, 12);
const url = `https://batteries.fyi/devices/${d.id}`;
const q = `What battery does the ${title} take?`;
const a = `${answer}${codes.length ? ` The ${b.name} is also sold as ${codes.slice(0, 5).join(', ')}.` : ''}${d.note ? ` ${d.note}` : ''}`;

const jsonld = [
  { '@context': 'https://schema.org', '@type': 'FAQPage', mainEntity: [{ '@type': 'Question', name: q, acceptedAnswer: { '@type': 'Answer', text: a } }] },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Devices', item: 'https://batteries.fyi/devices' },
      { '@type': 'ListItem', position: 2, name: cat.name, item: `https://batteries.fyi/devices#${d.category}` },
      { '@type': 'ListItem', position: 3, name: title, item: url },
    ],
  },
  {
    '@context': 'https://schema.org',
    '@type': 'WebPage',
    url,
    name: q,
    dateModified: d.source.accessed,
    citation: { '@type': 'CreativeWork', name: d.source.title, publisher: d.source.publisher, url: d.source.url },
  },
];
---

<BaseLayout title={`${title} battery: ${d.count > 1 ? `${d.count} × ` : ''}${code} | batteries.fyi`} description={a.slice(0, 300)} jsonld={jsonld}>
  <div class="wrap pt-5">
    <nav aria-label="Breadcrumb" class="text-[0.65rem] text-muted flex items-center gap-1.5">
      <a href="/devices" class="hover:text-ink">Devices</a><span aria-hidden="true">/</span>
      <a href={`/devices#${d.category}`} class="hover:text-ink">{cat.name}</a><span aria-hidden="true">/</span>
      <span class="text-ink-2" aria-current="page">{title}</span>
    </nav>
  </div>

  <section class="wrap pt-4 pb-6 max-w-4xl">
    <p class="eyebrow">{d.maker} {cat.one}{d.models ? ` · ${d.models}` : ''}{years ? ` · ${years}` : ''}</p>
    <h1 class="mt-1 text-[1.9rem] sm:text-[2.3rem] font-[750] tracking-tight leading-tight">{q}</h1>

    <div class="mt-5 card p-5 grid gap-5 sm:grid-cols-[auto_1fr] items-center">
      <a href={`/${b.id}`} class="flex items-center justify-center w-28 h-28 rounded-xl bg-surface-2 border border-line" aria-label={`${b.name} battery page`}>
        <Silhouette battery={b} class="max-w-[5.5rem] max-h-[5.5rem]" />
      </a>
      <div class="min-w-0">
        <p class="text-[2.2rem] font-[750] tracking-tight leading-none tabular">{d.count > 1 && <span class="text-ink-2">{d.count} × </span>}<a href={`/${b.id}`} class="hover:text-accent-ink">{code}</a></p>
        <p class="mt-1 text-[0.75rem] text-ink-2 tabular">{code !== b.name && <>{b.name} size · </>}{sizeLabel(b)} · {voltages(b).map((v) => volts(v)).join(' / ')}</p>
        <p class="mt-3 text-[0.8rem] text-ink-2 leading-relaxed" data-answer>{answer}{d.note && <> {d.note}</>}</p>
      </div>
    </div>

    <figure class="mt-4 callout">
      <blockquote class="text-[0.75rem] text-ink">“{d.source.quote}”</blockquote>
      <figcaption class="mt-1 text-[0.62rem] text-muted">
        {d.source.publisher}, <a class="link" href={d.source.url} rel="nofollow noopener" target="_blank">{d.source.title}</a>. Accessed {d.source.accessed}.
      </figcaption>
    </figure>

    <Buy battery={b} context="device" class="mt-5" />

    {codes.length > 0 && (
      <div class="mt-6">
        <p class="eyebrow mb-2">The {b.name} is also sold as</p>
        <div class="flex flex-wrap gap-1.5">
          {codes.map((c) => <span class="chip">{c}</span>)}
          <a href={`/${b.id}#codes`} class="chip">All codes</a>
        </div>
      </div>
    )}

    <div class="mt-6 flex flex-wrap gap-2">
      <a href={`/${b.id}`} class="btn">{b.name} specifications</a>
      <a href={`/actual-size?ids=${b.id}`} class="btn">{b.name} at actual size</a>
      <a href={`/${b.id}#interchange`} class="btn">What can replace it</a>
    </div>
  </section>

  <div class="wrap max-w-4xl mt-6 space-y-10 pb-6">
    {sameBattery.length > 0 && (
      <section>
        <h2 class="section-title">Other devices that take a {b.name}</h2>
        <ul class="flex flex-wrap gap-2">
          {sameBattery.map((x) => <li><a class="chip font-sans text-[0.68rem] py-1 px-2.5 hover:border-accent" href={`/devices/${x.id}`}>{deviceTitle(x)}</a></li>)}
        </ul>
      </section>
    )}
    {sameCategory.length > 0 && (
      <section>
        <h2 class="section-title">Other {cat.name.toLowerCase()}</h2>
        <ul class="grid gap-1.5 grid-cols-1 sm:grid-cols-2 text-[0.72rem]">
          {sameCategory.map((x) => (
            <li class="min-w-0"><a class="flex gap-2 min-w-0 hover:text-accent-ink" href={`/devices/${x.id}`}><span class="truncate min-w-0">{deviceTitle(x)}</span><span class="ml-auto text-muted tabular shrink-0">{x.count > 1 ? `${x.count} × ` : ''}{batteryById(x.battery)!.name}</span></a></li>
          ))}
        </ul>
      </section>
    )}
    <section class="card p-5 text-[0.68rem] text-ink-2">
      <h2 class="text-[0.85rem] font-semibold mb-1 text-ink">How this is sourced</h2>
      <p>Device entries cite the device maker only: the owner’s manual, support page or spec sheet, quoted above. If a maker changes the battery in a later model, that model gets its own entry. Corrections with a maker source are welcome on <a class="link" href={`https://github.com/centricle/batteries/blob/main/data/devices/${d.id}.json`}>GitHub</a>.</p>
    </section>
  </div>
</BaseLayout>
