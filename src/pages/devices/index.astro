---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { batteryById, deviceTitle, devices, DEVICE_CATEGORY_META, DEVICE_CATEGORY_ORDER } from '../../lib/data';

const all = devices();
// Each group's id is its DEVICE_CATEGORY_META key, so the home page can link to /devices#car-key.
const groups = DEVICE_CATEGORY_ORDER.map((c) => ({ id: c, meta: DEVICE_CATEGORY_META[c], list: all.filter((d) => d.category === c) })).filter((g) => g.list.length);
const makers = new Set(all.map((d) => d.maker)).size;
const yrs = (y?: string) => (y ? (y.endsWith('-') ? `${y.slice(0, -1)} on` : y.replace('-', ' to ')) : '');
const jsonld = {
  '@context': 'https://schema.org',
  '@type': 'ItemList',
  name: 'Which battery each device takes',
  numberOfItems: all.length,
  itemListElement: all.map((d, i) => ({ '@type': 'ListItem', position: i + 1, name: `${deviceTitle(d)}: ${d.count > 1 ? `${d.count} × ` : ''}${batteryById(d.battery)!.name}`, url: `https://batteries.fyi/devices/${d.id}` })),
};
---

<BaseLayout title="What battery does it take? Devices and their batteries | batteries.fyi" description={`Which battery ${all.length} devices take, from car key fobs to AirTags, each quoted from the device maker's own manual or support page.`} jsonld={jsonld}>
  <section class="wrap pt-8 max-w-5xl">
    <h1 class="text-2xl sm:text-3xl font-semibold">What battery does it take?</h1>
    <p class="lede measure mt-3">Find your device below to see which battery its maker says it takes. Type the name of your device in the box to shorten the list.</p>
    <p class="mt-2 text-sm text-muted measure">{all.length} devices from {makers} makers. Car key fobs are listed by model and year, because the same model can change batteries between years.</p>
    <form class="mt-5 max-w-md" role="search" onsubmit="return false">
      <label for="dq" class="label block mb-1">Find your device</label>
      <input id="dq" class="input" placeholder="RAV4, AirTag, smoke alarm" autocomplete="off" />
    </form>
    <nav class="mt-5 flex flex-wrap gap-2" aria-label="Kinds of device">
      {groups.map((g) => <a href={`#${g.id}`} class="chip whitespace-normal">{g.meta.name} <span class="text-muted">({g.list.length})</span></a>)}
    </nav>
  </section>

  <div class="wrap max-w-5xl mt-8 space-y-10" id="device-groups">
    <p id="dnone" class="text-base text-ink-2" hidden>No device matches that. Try the name printed on the battery in <a class="link" href="/search">search</a>, or <a class="link" href="/identify">measure the battery</a>.</p>
    {groups.map((g) => (
      <section id={g.id} data-group class="scroll-mt-20">
        <h2 class="section-title">{g.meta.name}</h2>
        <div class="table-scroll card">
          <table class="table">
            <thead><tr><th scope="col">Device</th><th scope="col">Battery</th><th scope="col" class="n">How many</th><th scope="col" class="hidden sm:table-cell">Maker's source</th></tr></thead>
            <tbody>
              {g.list.map((d) => {
                const b = batteryById(d.battery)!;
                return (
                  <tr data-row data-hay={`${d.maker} ${d.name} ${d.models ?? ''} ${b.name} ${d.code ?? ''} ${g.meta.name} ${g.meta.one}`.toLowerCase()}>
                    <td><a class="link" href={`/devices/${d.id}`}>{deviceTitle(d)}</a>{d.years && <span class="text-muted"> ({yrs(d.years)})</span>}</td>
                    <td class="whitespace-nowrap"><a class="link" href={`/${b.id}`}>{d.code ?? b.name}</a></td>
                    <td class="n">{d.count}</td>
                    <td class="hidden sm:table-cell text-ink-2">{d.source.publisher}</td>
                  </tr>
                );
              })}
            </tbody>
          </table>
        </div>
      </section>
    ))}
    <p class="text-sm text-ink-2 measure">Every entry quotes the device maker's own manual, support page or spec sheet, never a store or a forum. A device whose maker does not say which battery it takes is not listed. The list is free to download as <a class="link" href="/api/devices.json">JSON</a>.</p>
  </div>
</BaseLayout>

<script>
  const q = document.getElementById('dq') as HTMLInputElement;
  const none = document.getElementById('dnone')!;
  const rows = [...document.querySelectorAll<HTMLElement>('[data-row]')];
  const groups = [...document.querySelectorAll<HTMLElement>('[data-group]')];
  q.addEventListener('input', () => {
    const w = q.value.toLowerCase().split(/\s+/).filter(Boolean);
    for (const r of rows) r.hidden = !w.every((x) => r.dataset.hay!.includes(x));
    for (const g of groups) g.hidden = !g.querySelector('[data-row]:not([hidden])');
    none.hidden = groups.some((g) => !g.hidden);
  });
</script>
