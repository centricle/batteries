---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Viewer from '../../components/Viewer.astro';
import Silhouette from '../../components/Silhouette.astro';
import { pairs, verdict, faqs, REL_META, type Pair } from '../../lib/pairs';
import { primaryVariant, capacityLabel, chemistryGroups, sizeLabel, fmt, categoryById, codesBySystem, type Battery } from '../../lib/data';

export function getStaticPaths() {
  return [...pairs().values()].map((p) => ({ params: { pair: p.slug }, props: { p } }));
}
const { p } = Astro.props as { p: Pair };
const { a, b } = p;
const both = [a, b];
// Side profiles share one scale, chosen so the tallest fits the box height and the
// widest fits its column (flat discs are wide, not tall).
const BOX = { w: 176, h: 144 };
const scaleTo = Math.max(...both.map((x) => {
  const d = x.dimensions;
  const w = d.diameter?.nominal ?? d.width?.nominal ?? 0;
  return Math.max(d.height.nominal, (w * BOX.h) / BOX.w);
}));
const lines = verdict(p);
const qa = faqs(p);

const dimRows = (x: Battery) => {
  const d = x.dimensions;
  return {
    diameter: d.diameter ? `${fmt(d.diameter.nominal)} mm` : '',
    width: d.width ? `${fmt(d.width.nominal)} mm` : '',
    depth: d.depth ? `${fmt(d.depth.nominal)} mm` : '',
    height: `${fmt(d.height.nominal)} mm`,
  };
};
const dA = dimRows(a), dB = dimRows(b);
const vA = primaryVariant(a), vB = primaryVariant(b);
const codes = (x: Battery) => [...new Set(codesBySystem(x).filter(([sys]) => ['IEC', 'ANSI', 'JIS'].includes(sys)).flatMap(([, cs]) => cs.map((c) => c.code)))].join(', ');
const rows: [string, string, string][] = (
  [
    ['Type', categoryById[a.category]?.name ?? a.category, categoryById[b.category]?.name ?? b.category],
    ['Size', sizeLabel(a), sizeLabel(b)],
    ['Diameter', dA.diameter, dB.diameter],
    ['Width', dA.width, dB.width],
    ['Depth', dA.depth, dB.depth],
    [a.form === 'disc' && b.form === 'disc' ? 'Thickness' : 'Height', dA.height, dB.height],
    ['Chemistries', chemistryGroups(a).map((g) => g.chem.short).join(', '), chemistryGroups(b).map((g) => g.chem.short).join(', ')],
    ['Nominal voltage', [...new Set(a.variants.map((v) => `${fmt(v.voltage.nominal)} V`))].join(' / '), [...new Set(b.variants.map((v) => `${fmt(v.voltage.nominal)} V`))].join(' / ')],
    ['Typical capacity', capacityLabel(vA) ? `${capacityLabel(vA)} (${chemistryGroups(a)[0].chem.short})` : '', capacityLabel(vB) ? `${capacityLabel(vB)} (${chemistryGroups(b)[0].chem.short})` : ''],
    ['Weight', vA.weight_g ? `${fmt(vA.weight_g)} g` : '', vB.weight_g ? `${fmt(vB.weight_g)} g` : ''],
    ['Standard codes', codes(a), codes(b)],
    ['Status', a.status[0].toUpperCase() + a.status.slice(1), b.status[0].toUpperCase() + b.status.slice(1)],
  ] as [string, string, string][]
).filter(([, x, y]) => x || y);

const title = `${a.name} vs ${b.name}: size, voltage and interchangeability | batteries.fyi`;
const description = lines.slice(0, 2).join(' ').slice(0, 300);
const url = `https://batteries.fyi/compare/${p.slug}`;
const jsonld = [
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: qa.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })),
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Compare', item: 'https://batteries.fyi/compare' },
      { '@type': 'ListItem', position: 2, name: `${a.name} vs ${b.name}`, item: url },
    ],
  },
];
---

<BaseLayout title={title} description={description} jsonld={jsonld}>
  <div class="wrap pt-5"><nav class="text-[0.65rem] text-muted" aria-label="Breadcrumb"><a href="/compare" class="hover:text-ink">Compare</a> / <span class="text-ink-2">{a.name} vs {b.name}</span></nav></div>
  <section class="wrap pt-4 grid gap-8 lg:grid-cols-[1fr_1fr] items-start">
    <div class="min-w-0">
      <p class="eyebrow">Head to head</p>
      <h1 class="text-[2.2rem] font-semibold tracking-tight leading-tight mt-1"><a href={`/${a.id}`} class="hover:text-accent-ink">{a.name}</a> <span class="text-muted font-[450]">vs</span> <a href={`/${b.id}`} class="hover:text-accent-ink">{b.name}</a></h1>
      <div class="mt-4 space-y-2 text-[0.82rem] text-ink-2 max-w-xl">{lines.map((l) => <p>{l}</p>)}</div>
      {p.relations.map((r) => (
        <div class:list={['callout mt-4', REL_META[r.relation].cls]}>
          <p class="eyebrow mb-1">{REL_META[r.relation].label}: {r.to.name} in place of {r.from.name}</p>
          <p>{r.note}</p>
        </div>
      ))}
      <div class="card mt-6 p-5 flex items-end justify-center gap-6 sm:gap-10 h-56">
        {both.map((x) => (
          <a href={`/${x.id}`} class="group flex flex-col items-center gap-2 h-full justify-end flex-1 min-w-0 max-w-44">
            <div class="h-36 w-full flex items-end justify-center"><Silhouette battery={x} scaleTo={scaleTo} view="front" class="max-w-full" /></div>
            <span class="text-[0.75rem] font-semibold group-hover:text-accent-ink">{x.name}</span>
            <span class="text-[0.58rem] text-muted tabular">{sizeLabel(x)}</span>
          </a>
        ))}
      </div>
      <p class="text-[0.58rem] text-muted mt-1.5">Side profiles drawn to the same scale.</p>
    </div>
    <div class="min-w-0 lg:sticky lg:top-20">
      <Viewer batteries={both} mode="lineup" height="24rem" />
    </div>
  </section>

  <section class="wrap mt-10">
    <h2 class="section-title">Side by side</h2>
    <div class="card table-scroll">
      <table class="table">
        <thead><tr><th></th><th><a href={`/${a.id}`} class="hover:text-accent-ink">{a.name}</a></th><th><a href={`/${b.id}`} class="hover:text-accent-ink">{b.name}</a></th></tr></thead>
        <tbody>{rows.map(([k, x, y]) => <tr><td class="text-ink-2 font-medium">{k}</td><td class:list={['tabular', x !== y && x && y && 'font-semibold']}>{x || '—'}</td><td class:list={['tabular', x !== y && x && y && 'font-semibold']}>{y || '—'}</td></tr>)}</tbody>
      </table>
    </div>
    <p class="text-[0.6rem] text-muted mt-2">Nominal dimensions. Tolerances, every chemistry and the sources for each value are on the <a class="link" href={`/${a.id}`}>{a.name}</a> and <a class="link" href={`/${b.id}`}>{b.name}</a> pages. Capacities are rated by each maker at its own load and cutoff, so they compare only roughly.</p>
    <p class="mt-4"><a class="btn btn-sm" href={`/compare?ids=${a.id},${b.id}`}>Add more sizes to this comparison</a></p>
  </section>
</BaseLayout>
