---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { pairs } from '../../lib/pairs';
import { CATEGORY_META, batteries, modelSpec, searchIndex, primaryVariant, capacityLabel, chemistryGroups, chemistryById, chem, sizeLabel, voltages, fmt, categoryById } from '../../lib/data';

const kindName = (id: string) => {
  const c = chemistryById(id) as { plain_name?: string } | undefined;
  return c?.plain_name ?? chem(id).name;
};
const orList = (xs: string[]) => (xs.length < 2 ? xs.join('') : `${xs.slice(0, -1).join(', ')} or ${xs[xs.length - 1]}`);
/** Nearest 1/16 in, no unit: "2", "9/16", "1 3/8". */
const frac = (mm: number) => {
  const s = Math.round((mm / 25.4) * 16);
  if (s === 0) return '1/16';
  const whole = Math.floor(s / 16);
  let num = s % 16, den = 16;
  while (num && num % 2 === 0) { num /= 2; den /= 2; }
  return `${whole || ''}${whole && num ? ' ' : ''}${num ? `${num}/${den}` : ''}`;
};
const sizeBoth = (b: ReturnType<typeof batteries>[number]) => {
  const d = b.dimensions;
  const sides = d.diameter && !d.width ? [d.diameter.nominal, d.height.nominal] : [d.width!.nominal, d.depth!.nominal, d.height.nominal];
  return `${sizeLabel(b)} (about ${sides.map((x) => `${frac(x)}″`).join(' × ')})`;
};

const all = batteries();
const specs = Object.fromEntries(all.map((b) => [b.id, modelSpec(b)]));
const facts = Object.fromEntries(
  all.map((b) => {
    const pv = primaryVariant(b);
    return [
      b.id,
      {
        name: b.name,
        cat: categoryById[b.category].short,
        size: sizeBoth(b),
        volts: `${orList(voltages(b).map((v) => fmt(v, 2)))}V`,
        cap: capacityLabel(pv),
        weight: pv.weight_g ? `${fmt(pv.weight_g)}g` : '',
        kinds: chemistryGroups(b).map((g) => kindName(g.chem.id)).join(', '),
        names: [...new Set(b.codes.map((c) => c.code))].filter((c) => c !== b.name).slice(0, 5).join(', '),
        d: b.dimensions.diameter?.nominal ?? null,
        h: b.dimensions.height.nominal,
        w: b.dimensions.width?.nominal ?? null,
        p: b.dimensions.depth?.nominal ?? null,
        form: b.form,
      },
    ];
  }),
);
const presets = [
  { label: 'Household sizes', ids: 'd,c,aa,aaa,aaaa,n,9v' },
  { label: 'Rechargeable lithium-ion', ids: '32650,26650,21700,20700,18650,18350,14500,10440' },
  { label: 'AA and 14500', ids: 'aa,14500,er14505' },
  { label: 'CR123A and 16340', ids: 'cr123a,16340,cr2' },
  { label: '20mm coin batteries', ids: 'cr2032,cr2025,cr2016,cr2012' },
  { label: 'Watch batteries', ids: 'lr44,sr1130sw,sr927sw,lr41,sr626sw,sr621sw' },
  { label: 'Hearing aid sizes', ids: '675,13,312,10,5' },
  { label: 'Camera batteries', ids: 'cr-v3,2cr5,cr-p2,cr123a,cr2' },
];
const pairGroups = CATEGORY_META.map((c) => ({
  c,
  list: [...pairs().values()].filter((p) => p.a.category === c.id).sort((x, y) => x.slug.localeCompare(y.slug, 'en', { numeric: true })),
})).filter((g) => g.list.length);
---

<BaseLayout title="Compare battery sizes side by side, to scale | batteries.fyi" description="Put any batteries side by side at their real sizes, in 3D: AA and AAA, CR2032 and CR2025, 18650 and 21700. Size, voltage and capacity compared in a table.">
  <section class="wrap pt-8">
    <h1 class="text-2xl sm:text-3xl font-semibold">Compare battery sizes</h1>
    <p class="lede measure mt-3">See batteries side by side at their real sizes. Add a battery by its name, or pick one of the sets below.</p>
    <p class="mt-2 text-base text-ink-2 measure">Coin and button batteries stand on edge, so you can see how thick they are next to the others. The page address keeps your choices, so you can share it.</p>

    <div class="mt-5 flex flex-wrap items-center gap-2" id="picked" aria-live="polite"></div>
    <div class="mt-4 relative max-w-md">
      <label for="cmp-add" class="label block mb-1">Add a battery</label>
      <input id="cmp-add" class="input" placeholder="Type a name, like CR2032 or AA" autocomplete="off" role="combobox" aria-expanded="false" aria-controls="cmp-list" />
      <ul id="cmp-list" class="card absolute z-20 left-0 right-0 mt-1 max-h-80 overflow-y-auto hidden" role="listbox" aria-label="Matching batteries"></ul>
    </div>
    <p class="label mt-5 mb-2">Or pick a set</p>
    <div class="flex flex-wrap gap-2">
      {presets.map((p) => <button type="button" class="btn btn-sm" data-preset={p.ids}>{p.label}</button>)}
    </div>
  </section>

  <section class="wrap mt-6">
    <div id="stage" class="relative overflow-hidden border border-line viewer-stage" style="height:min(30rem,80vw)">
      <div class="viewer-labels absolute inset-0 pointer-events-none" aria-hidden="true"></div>
      <div class="absolute top-2 left-3 text-sm text-ink-2 pointer-events-none">Small squares are 1mm, large squares 10mm</div>
      <p id="nogl" class="hidden absolute inset-0 flex items-center justify-center p-4 text-center text-base text-ink-2">This browser cannot show the 3D view. The table below still compares the sizes.</p>
    </div>
    <p class="sr-only">A 3D view of the chosen batteries side by side. The table below lists the same sizes.</p>
  </section>

  <section class="wrap mt-8">
    <h2 class="section-title">The differences</h2>
    <div class="card table-scroll"><table class="table min-w-[36rem]" id="cmp-table"></table></div>
    <p class="mt-2 text-sm text-ink-2 measure">Sizes are in millimeters, with inches after: across by long for round batteries, and wide by deep by tall for the rest. The last row compares each battery with the first one in the list.</p>
  </section>

  <script type="application/json" id="cmp-specs" set:html={JSON.stringify(specs)} />
  <script type="application/json" id="cmp-facts" set:html={JSON.stringify(facts)} />
  <script type="application/json" id="cmp-index" set:html={JSON.stringify(searchIndex())} />
  <section class="wrap mt-14" id="all-pairs">
    <h2 class="section-title">Batteries people mix up</h2>
    <p class="text-base text-ink-2 mb-4 measure">Each page puts two batteries side by side and says whether one works in place of the other. They are grouped by the first battery's type.</p>
    <div class="grid gap-3 md:grid-cols-2 items-start">
      {pairGroups.map((g) => (
        <details class="card p-4">
          <summary class="cursor-pointer min-h-8 py-1 text-base font-semibold font-mono">
            {g.c.name} <span class="ml-2 text-ink-2 font-normal text-sm">{g.list.length} pages</span>
          </summary>
          <ul class="flex flex-wrap gap-2 mt-3">
            {g.list.map((p) => <li><a href={`/compare/${p.slug}`} class="chip whitespace-normal">{p.a.name} vs {p.b.name}</a></li>)}
          </ul>
        </details>
      ))}
    </div>
  </section>
</BaseLayout>

<style>
  .viewer-stage { background: var(--stage); }
  /* Lineup labels: mono 600 at text-sm (0.9rem), at least 2rem tall. */
  :global(.viewer-label) { position: absolute; transform: translate(-50%, 0); display: inline-flex; align-items: center; min-height: 2rem; font-family: var(--font-mono); font-size: 0.9rem; font-weight: 600; color: var(--ink); background: color-mix(in oklch, var(--surface) 88%, transparent); border: 1px solid var(--line-2); padding: 0 0.5rem; white-space: nowrap; pointer-events: auto; text-decoration: underline; text-underline-offset: 0.2em; }
  :global(#cmp-list li[aria-selected="true"]) { background: var(--accent-soft); }
</style>

<script>
  import { rank, type Entry } from '../../lib/search';
  const specs = JSON.parse(document.getElementById('cmp-specs')!.textContent!);
  const facts = JSON.parse(document.getElementById('cmp-facts')!.textContent!);
  const index: Entry[] = JSON.parse(document.getElementById('cmp-index')!.textContent!);
  const stage = document.getElementById('stage')!;
  const labelsEl = stage.querySelector('.viewer-labels') as HTMLElement;
  const picked = document.getElementById('picked')!;
  const add = document.getElementById('cmp-add') as HTMLInputElement;
  const list = document.getElementById('cmp-list')!;
  const table = document.getElementById('cmp-table')!;

  // The page scrolls over the 3D stage. The wheel reaches the model (to zoom)
  // only with Ctrl or Cmd held, which is also what a trackpad pinch sends.
  stage.addEventListener('wheel', (e) => { if (!e.ctrlKey && !e.metaKey) e.stopPropagation(); }, { capture: true });

  const params = new URLSearchParams(location.search);
  let ids = (params.get('ids') ?? 'd,c,aa,aaa,9v,18650,cr2032').split(',').filter((id) => specs[id]);
  let api: any = null;
  let host: HTMLElement | null = null;
  let mount: any = null;
  const hasGL = !!document.createElement('canvas').getContext('webgl2');
  if (!hasGL) document.getElementById('nogl')!.classList.remove('hidden');

  const esc = (s: string) => String(s).replace(/[&<>"]/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' })[c]!);

  async function draw() {
    history.replaceState(null, '', ids.length ? `?ids=${ids.join(',')}` : location.pathname);
    picked.innerHTML = ids.length
      ? ids.map((id) => `<span class="chip text-sm pr-0"><a href="/${id}" class="link font-semibold">${esc(facts[id].name)}</a><button type="button" data-remove="${id}" class="w-8 h-8 inline-flex items-center justify-center hover:bg-surface-2" aria-label="Remove ${esc(facts[id].name)}">×</button></span>`).join('')
      : '<span class="text-base text-ink-2">Nothing chosen yet. Add a battery or pick a set.</span>';
    renderTable();
    if (!hasGL) return;
    api?.dispose();
    host?.remove();
    labelsEl.innerHTML = '';
    if (!ids.length) return;
    mount ??= (await import('../../lib/viewer')).mountViewer;
    host = document.createElement('div');
    host.className = 'absolute inset-0';
    stage.prepend(host);
    const els = new Map<string, HTMLAnchorElement>();
    api = mount(host, ids.map((id) => specs[id]), {
      mode: 'lineup',
      onLabels: (ls: any[]) => {
        for (const l of ls) {
          let a = els.get(l.id);
          if (!a) {
            a = document.createElement('a');
            a.className = 'viewer-label';
            a.href = `/${l.id}`;
            a.textContent = l.name;
            labelsEl.appendChild(a);
            els.set(l.id, a);
          }
          a.style.left = `${l.x}px`;
          a.style.top = `${l.y}px`;
          a.style.display = l.visible ? '' : 'none';
        }
      },
    });
  }

  const n2 = (x: number) => Number(Math.abs(x).toFixed(2));
  function difference(f: any, base: any) {
    if (f === base) return 'The first one';
    const a = base.d ?? base.w, b = f.d ?? f.w;
    const dd = b - a, dh = f.h - base.h;
    const discs = f.form === 'disc' && base.form === 'disc';
    const across = Math.abs(dd) < 0.05 ? 'same width' : `${n2(dd)}mm ${dd > 0 ? 'wider' : 'narrower'}`;
    const long = Math.abs(dh) < 0.05 ? (discs ? 'same thickness' : 'same length') : `${n2(dh)}mm ${dh > 0 ? (discs ? 'thicker' : 'longer') : discs ? 'thinner' : 'shorter'}`;
    return `${across}, ${long}`;
  }

  function renderTable() {
    if (!ids.length) { table.innerHTML = ''; return; }
    const rows: [string, (f: any) => string][] = [
      ['Type', (f) => f.cat],
      ['Size', (f) => f.size],
      ['Voltage', (f) => f.volts],
      ['Typical capacity', (f) => f.cap || '—'],
      ['Weight', (f) => f.weight || '—'],
      ['Kinds', (f) => f.kinds],
      ['Other names', (f) => f.names || '—'],
    ];
    const base = facts[ids[0]];
    table.innerHTML =
      `<thead><tr><th class="sticky left-0 bg-surface z-10"><span class="sr-only">Detail</span></th>${ids.map((id) => `<th class="text-sm"><a class="link font-mono" href="/${id}">${esc(facts[id].name)}</a></th>`).join('')}</tr></thead><tbody>` +
      rows.map(([label, get]) => `<tr><td class="sticky left-0 bg-surface z-10 text-ink-2 font-semibold font-sans">${label}</td>${ids.map((id) => `<td>${esc(get(facts[id]))}</td>`).join('')}</tr>`).join('') +
      `<tr><td class="sticky left-0 bg-surface z-10 text-ink-2 font-semibold font-sans">Compared with the ${esc(base.name)}</td>${ids.map((id) => `<td>${esc(difference(facts[id], base))}</td>`).join('')}</tr></tbody>`;
  }

  picked.addEventListener('click', (e) => {
    const id = (e.target as HTMLElement).closest('[data-remove]')?.getAttribute('data-remove');
    if (id) { ids = ids.filter((x) => x !== id); draw(); }
  });
  document.querySelectorAll('[data-preset]').forEach((b) => b.addEventListener('click', () => { ids = (b as HTMLElement).dataset.preset!.split(',').filter((id) => specs[id]); draw(); }));

  let sel = 0;
  let res: ReturnType<typeof rank> = [];
  const renderList = () => {
    res = add.value.trim() ? rank(index, add.value, 8).filter((r) => !ids.includes(r.e.id)) : [];
    list.classList.toggle('hidden', !res.length);
    add.setAttribute('aria-expanded', String(!!res.length));
    list.innerHTML = res.map((r, i) => `<li role="option" aria-selected="${i === sel}" data-id="${r.e.id}" class="px-3 py-2 min-h-11 cursor-pointer flex gap-3 items-center"><span class="dot" style="background:${r.e.col}"></span><strong class="font-mono text-base">${esc(r.e.n)}</strong><span class="text-ink-2 text-sm">${esc(r.e.s)}</span>${r.why ? `<span class="chip ml-auto">${esc(r.why)}</span>` : ''}</li>`).join('');
  };
  const pick = (id: string) => { if (!ids.includes(id) && ids.length < 12) ids.push(id); add.value = ''; renderList(); draw(); };
  add.addEventListener('input', () => { sel = 0; renderList(); });
  add.addEventListener('keydown', (e) => {
    if (e.key === 'ArrowDown') { sel = Math.min(sel + 1, res.length - 1); renderList(); e.preventDefault(); }
    if (e.key === 'ArrowUp') { sel = Math.max(sel - 1, 0); renderList(); e.preventDefault(); }
    if (e.key === 'Enter' && res[sel]) { e.preventDefault(); pick(res[sel].e.id); }
    if (e.key === 'Escape') { add.value = ''; renderList(); }
  });
  list.addEventListener('mousedown', (e) => { const id = (e.target as HTMLElement).closest('[data-id]')?.getAttribute('data-id'); if (id) { e.preventDefault(); pick(id); } });
  add.addEventListener('blur', () => setTimeout(() => list.classList.add('hidden'), 100));
  draw();
</script>
