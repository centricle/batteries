---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Not found | batteries.fyi" description="The requested page could not be found." noindex>
  <section class="wrap py-20 max-w-xl text-center">
    <!-- The mark again, in a circuit with its switch open. -->
    <figure class="mb-8">
      <svg viewBox="0 0 320 96" class="w-full max-w-[20rem] mx-auto block text-ink" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
        <path d="M0 48H121M147 48H226" />
        <rect x="120" y="16" width="3" height="64" fill="currentColor" stroke="none" />
        <rect x="140" y="32" width="8" height="32" fill="currentColor" stroke="none" />
        <path d="M98 20h12M104 14v12" stroke="var(--accent)" />
        <circle cx="230" cy="48" r="4" fill="var(--bg)" />
        <path d="M233.5 46 265 27" />
        <circle cx="274" cy="48" r="4" fill="var(--bg)" />
        <path d="M278 48H320" />
      </svg>
      <figcaption class="mt-3 text-[0.6rem] text-muted"><span class="font-mono text-ink-2 uppercase tracking-[0.08em] mr-2">Fig. 404</span>Open circuit.</figcaption>
    </figure>
    <p class="eyebrow">404</p>
    <h1 class="text-[2rem] font-semibold tracking-tight mt-1">Nothing at this address</h1>
    <p class="mt-3 text-[0.8rem] text-ink-2">The page may have moved. Most battery codes work as addresses (<a class="link" href="/cr2032">/cr2032</a>, <a class="link" href="/377">/377</a>, <a class="link" href="/lr6">/lr6</a>), and search accepts any of them.</p>
    <div class="mt-6 flex justify-center gap-2">
      <button type="button" class="btn btn-primary" data-search-open>Search</button>
      <a href="/batteries" class="btn">Browse all sizes</a>
    </div>
  </section>
</BaseLayout>
