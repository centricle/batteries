---
import BaseLayout from '../layouts/BaseLayout.astro';

const common = [
  { href: '/aa', name: 'AA' },
  { href: '/aaa', name: 'AAA' },
  { href: '/c', name: 'C' },
  { href: '/d', name: 'D' },
  { href: '/9v', name: '9V' },
  { href: '/cr2032', name: 'CR2032' },
];
---

<BaseLayout title="Page not found | batteries.fyi" description="This page is not here. Search for a battery by the name printed on it, or the device it goes in." noindex>
  <section class="wrap py-16 sm:py-20">
    <div class="measure">
      <h1 class="text-2xl sm:text-3xl font-semibold">That page is not here</h1>
      <p class="lede mt-4">Search for the battery by the name printed on it or the device it goes in, or pick one of the common sizes below.</p>
      <button type="button" class="btn btn-primary mt-6" data-search-open>
        <svg class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="11" cy="11" r="7" /><path d="m21 21-4.3-4.3" /></svg>
        Search
      </button>
      <h2 class="label mt-10 mb-3">Common sizes</h2>
      <ul class="flex flex-wrap gap-2">
        {common.map((b) => <li><a class="btn min-w-20" href={b.href}>{b.name} battery</a></li>)}
      </ul>
    </div>
  </section>
</BaseLayout>
