---
import BaseLayout from '../layouts/BaseLayout.astro';
import { searchIndex } from '../lib/data';
---

<BaseLayout title="Search batteries by name, code or size | batteries.fyi" description="Search every battery size by name, IEC, ANSI or brand code, voltage, or dimensions written as diameter × height.">
  <section class="wrap pt-8 max-w-3xl">
    <h1 class="text-[2rem] font-[750] tracking-tight">Search</h1>
    <form class="mt-4" role="search" onsubmit="return false">
      <label for="q" class="sr-only">Search</label>
      <input id="q" name="q" class="input h-12 text-[0.9rem]" placeholder="CR2032, 377, LR6, 18650, 20 x 3.2, 3V" autocomplete="off" autofocus />
    </form>
    <p class="mt-2 text-[0.62rem] text-muted">Matches names, every standard and manufacturer code, aliases, voltages (<span class="mono">3V</span>) and sizes (<span class="mono">20 x 3.2</span>). No match? <a class="link" href="/identify">Identify by measurement</a> or <a class="link" href="/decode">decode the code</a>.</p>
    <ul id="results" class="mt-6 card divide-y divide-[var(--line)]" aria-live="polite"></ul>
  </section>
  <script type="application/json" id="idx" set:html={JSON.stringify(searchIndex())} />
</BaseLayout>

<script>
  import { rank, type Entry } from '../lib/search';
  const index: Entry[] = JSON.parse(document.getElementById('idx')!.textContent!);
  const q = document.getElementById('q') as HTMLInputElement;
  const out = document.getElementById('results')!;
  const esc = (s: string) => s.replace(/[&<>"]/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' })[c]!);
  const run = () => {
    const v = q.value.trim();
    const u = new URL(location.href);
    if (v) u.searchParams.set('q', v); else u.searchParams.delete('q');
    history.replaceState(null, '', u);
    if (!v) { out.innerHTML = ''; out.hidden = true; return; }
    const r = rank(index, v, 40);
    out.hidden = false;
    out.innerHTML = r.length
      ? r.map(({ e, why }) => `<li><a href="/${e.id}" class="flex items-center gap-3 p-3 hover:bg-surface-2"><span class="dot" style="background:${e.col}"></span><span class="font-semibold w-28 shrink-0">${esc(e.n)}</span><span class="text-[0.65rem] text-muted">${esc(e.c)} · ${esc(e.s)} · ${esc(e.v)} V · ${esc(e.x.join(', '))}</span>${why ? `<span class="chip ml-auto">${esc(why)}</span>` : ''}</a></li>`).join('')
      : `<li class="p-6 text-center text-[0.72rem] text-muted">No match for “${esc(v)}”.</li>`;
  };
  q.value = new URLSearchParams(location.search).get('q') ?? '';
  q.addEventListener('input', run);
  run();
</script>
