---
import BaseLayout from '../layouts/BaseLayout.astro';
import { batteries, categoryById, chem, fmt, primaryVariant, sizeLabel, voltages, stats } from '../lib/data';

/** Nearest 1/16 in, no unit: "2", "9/16", "1 3/8". */
const frac = (mm: number) => {
  const s = Math.round((mm / 25.4) * 16);
  if (s === 0) return '1/16';
  const whole = Math.floor(s / 16);
  let num = s % 16, den = 16;
  while (num && num % 2 === 0) { num /= 2; den /= 2; }
  return `${whole || ''}${whole && num ? ' ' : ''}${num ? `${num}/${den}` : ''}`;
};
const orList = (xs: string[]) => (xs.length < 2 ? xs.join('') : `${xs.slice(0, -1).join(', ')} or ${xs[xs.length - 1]}`);

// Compact index with tolerances: [min, max] per dimension, nominal when unpublished.
const tol = (x?: { nominal: number; min?: number; max?: number }) => (x ? [x.min ?? x.nominal, x.max ?? x.nominal] : null);
const items = batteries().map((b) => {
  const d = b.dimensions;
  const cls = b.form === 'disc' ? 'disc' : b.form === 'cylinder' || (b.form === 'twin' && d.diameter && !d.width) ? 'cylinder' : 'box';
  const sides = d.diameter && !d.width ? [d.diameter.nominal, d.height.nominal] : [d.width!.nominal, d.depth!.nominal, d.height.nominal];
  return {
    id: b.id,
    n: b.name,
    c: categoryById[b.category].short,
    cls,
    s: `${sizeLabel(b)} (about ${sides.map(frac).join(' × ')} in)`,
    d: d.diameter?.nominal ?? null,
    h: d.height.nominal,
    w: d.width?.nominal ?? null,
    p: d.depth?.nominal ?? null,
    td: tol(d.diameter),
    th: tol(d.height),
    tw: tol(d.width),
    tp: tol(d.depth),
    v: voltages(b),
    vw: `${orList(voltages(b).map((x) => fmt(x, 2)))} V`,
    col: chem(primaryVariant(b).chemistry).color,
  };
});
const s = stats();
const jsonld = {
  '@context': 'https://schema.org',
  '@type': 'WebApplication',
  name: 'Identify a battery by its size',
  url: 'https://batteries.fyi/identify',
  applicationCategory: 'UtilitiesApplication',
  operatingSystem: 'Any',
  browserRequirements: 'Requires JavaScript',
  isAccessibleForFree: true,
  description: 'Enter how wide and how long a battery is, in millimeters or inches, and optionally its voltage, to see which standard sizes match most closely.',
};
const examples = [
  { label: '14.5 mm across, 50.5 mm long', q: 'shape=cylinder&d=14.5&h=50.5' },
  { label: '18.4 mm across, 65.1 mm long', q: 'shape=cylinder&d=18.4&h=65.1' },
  { label: '20 mm across, 3.2 mm thick', q: 'shape=disc&d=20&h=3.2' },
  { label: '11.6 mm across, 5.4 mm thick', q: 'shape=disc&d=11.6&h=5.4' },
  { label: '26.5 by 17.5 by 48.5 mm', q: 'shape=box&d=26.5&p=17.5&h=48.5' },
];
---

<BaseLayout title="Identify a battery by its size: measure it, find the match | batteries.fyi" description="Measure a battery with a ruler, enter how wide and how long it is in millimeters or inches, and see which standard sizes match, with the difference for each." jsonld={jsonld}>
  <section class="wrap pt-8">
    <h1 class="text-2xl sm:text-3xl font-semibold">Identify a battery by its size</h1>
    <p class="lede measure mt-3">Measure your battery and enter the numbers. A ruler is enough. The closest sizes appear as you type, with how much each one differs from yours.</p>
    <ol class="mt-4 text-base text-ink-2 measure list-decimal pl-6 space-y-1">
      <li>Pick the shape that looks like yours.</li>
      <li>Enter how wide it is and how long or thick it is, in millimeters or inches.</li>
      <li>If you know the voltage, add it. It narrows the list.</li>
    </ol>
  </section>

  <section class="wrap mt-6 grid gap-6 lg:grid-cols-[minmax(0,24rem)_minmax(0,1fr)] items-start [&>*]:min-w-0">
    <form id="id-form" class="card p-4 sm:p-5 space-y-5" novalidate>
      <fieldset>
        <legend class="label mb-2">Shape</legend>
        <div class="grid gap-2" role="group" aria-label="Shape">
          <button type="button" class="btn justify-start text-left whitespace-normal" data-shape="cylinder" aria-pressed="true">Round, like an AA</button>
          <button type="button" class="btn justify-start text-left whitespace-normal" data-shape="disc" aria-pressed="false">Flat and round, like a coin</button>
          <button type="button" class="btn justify-start text-left whitespace-normal" data-shape="box" aria-pressed="false">Rectangular, like a 9V</button>
        </div>
      </fieldset>
      <fieldset>
        <legend class="label mb-2">Units</legend>
        <div class="flex flex-wrap gap-2" role="group" aria-label="Units">
          <button type="button" class="btn" data-unit="mm" aria-pressed="true">Millimeters</button>
          <button type="button" class="btn" data-unit="in" aria-pressed="false">Inches</button>
        </div>
        <p class="mt-1 text-sm text-ink-2">Switching converts what you typed. This browser remembers your choice.</p>
      </fieldset>
      <div class="grid grid-cols-2 gap-4">
        <div>
          <label for="id-d" class="label block mb-1" id="id-d-label">How wide</label>
          <div class="relative">
            <input id="id-d" class="input pr-12 tabular" type="number" inputmode="decimal" min="0" step="any" aria-describedby="id-d-hint" />
            <span class="unit absolute right-3 top-1/2 -translate-y-1/2 text-sm text-ink-2 pointer-events-none">mm</span>
          </div>
          <p id="id-d-hint" class="text-sm text-ink-2 mt-1">Across the widest part</p>
        </div>
        <div>
          <label for="id-h" class="label block mb-1" id="id-h-label">How long</label>
          <div class="relative">
            <input id="id-h" class="input pr-12 tabular" type="number" inputmode="decimal" min="0" step="any" aria-describedby="id-h-hint" />
            <span class="unit absolute right-3 top-1/2 -translate-y-1/2 text-sm text-ink-2 pointer-events-none">mm</span>
          </div>
          <p id="id-h-hint" class="text-sm text-ink-2 mt-1">End to end, including the bump on the + end</p>
        </div>
        <div id="id-p-wrap" hidden>
          <label for="id-p" class="label block mb-1">Depth <span class="font-normal">(if you have it)</span></label>
          <div class="relative">
            <input id="id-p" class="input pr-12 tabular" type="number" inputmode="decimal" min="0" step="any" />
            <span class="unit absolute right-3 top-1/2 -translate-y-1/2 text-sm text-ink-2 pointer-events-none">mm</span>
          </div>
        </div>
        <div>
          <label for="id-v" class="label block mb-1">Voltage <span class="font-normal">(if you know it)</span></label>
          <div class="relative">
            <input id="id-v" class="input pr-10 tabular" type="number" inputmode="decimal" min="0" step="any" aria-describedby="id-v-hint" />
            <span class="absolute right-3 top-1/2 -translate-y-1/2 text-sm text-ink-2 pointer-events-none">V</span>
          </div>
          <p id="id-v-hint" class="text-sm text-ink-2 mt-1">Printed on it, or read with a meter</p>
        </div>
      </div>
      <div class="flex flex-wrap gap-2">
        <button type="reset" class="btn">Clear</button>
      </div>
      <div class="callout info">
        <p class="font-semibold text-ink">Tips for measuring</p>
        <ul class="mt-2 space-y-2 list-disc pl-5 text-ink-2">
          <li>Length includes the bump on the positive (+) end. Measure from the flat end to the tip of the bump.</li>
          <li>Rechargeable lithium-ion batteries with a built-in protection board are often 2 to 5 mm longer than the plain battery: a protected 18650 can measure 67 to 70 mm.</li>
          <li>On a coin battery the name gives the size: a CR2032 is 20 mm across and 3.2 mm thick. Button batteries work the same way: an SR626 is 6.8 mm across and 2.6 mm thick.</li>
          <li>A label or plastic wrap adds a few tenths of a millimeter. Measure the metal if you can.</li>
        </ul>
      </div>
    </form>

    <div>
      <div id="id-warn" class="callout warn mb-3" hidden></div>
      <div id="id-empty" class="card p-5">
        <p class="text-base text-ink-2">Enter at least one measurement to see matches. Or try one of these:</p>
        <ul class="mt-3 flex flex-wrap gap-2">
          {examples.map((e) => <li><a class="chip whitespace-normal" href={`/identify?${e.q}`} data-example={e.q}>{e.label}</a></li>)}
        </ul>
      </div>
      <div id="id-results" hidden>
        <h2 class="section-title">Closest sizes</h2>
        <ol id="id-list" class="grid gap-3 [&>*]:min-w-0" aria-live="polite"></ol>
        <p class="mt-3 text-sm text-ink-2 measure">Each line compares the listed battery with your numbers: "0.3 mm wider" means that battery is 0.3 mm wider than what you measured. A measurement inside the maker's allowed range counts as a match.</p>
      </div>
    </div>
  </section>

  <section class="wrap mt-12">
    <h2 class="section-title" id="how">How the matching works</h2>
    <div class="prose">
      <p>Your numbers are compared with the published sizes of all {s.batteries} batteries on this site, only within the shape you picked: round (AA, 18650, CR123A), flat and round (CR2032, LR44, hearing aid batteries), and rectangular (9V, lantern batteries and two-battery camera packs).</p>
      <p>For round shapes the distance is <span class="mono">√((Δd ÷ d)² + (0.6 × Δh ÷ h)²)</span>, where <span class="mono">d</span> and <span class="mono">h</span> are the listed width across and length, and <span class="mono">Δ</span> is how far your measurement falls outside the published tolerance range (zero when it falls inside). Length counts at 0.6 because it is the less reliable measurement: terminals, protection boards and caps change it. For rectangular batteries the three sides are sorted largest first, so the order you enter them in does not matter, and the distance is <span class="mono">√(Σ (Δ ÷ listed size)²)</span> over the sides you entered.</p>
      <p>A voltage within 12% of one of the battery's rated voltages adds nothing. Further away, it adds <span class="mono">0.5 × (|ln(V ÷ rated)| − 0.12)</span>. A fresh battery reads above its rated voltage and a used one below, which is why the margin is wide.</p>
      <p>The match percentage is <span class="mono">100 × e^(−(distance ÷ 0.1)²)</span>: an exact match is 100%, a 5% difference about 78%, a 10% difference about 37%.</p>
      <p>Sizes come from each battery's cited sources: IEC 60086-2 and ANSI C18 tables where they exist, otherwise the makers' datasheets. See <a href="/sources">sources</a>. To read a size from the name printed on a battery instead, see <a href="/decode">what the letters and numbers mean</a>.</p>
    </div>
  </section>

  <script type="application/json" id="id-data" set:html={JSON.stringify(items)} />
</BaseLayout>

<script>
  interface Item {
    id: string; n: string; c: string; cls: 'cylinder' | 'disc' | 'box'; s: string;
    d: number | null; h: number; w: number | null; p: number | null;
    td: [number, number] | null; th: [number, number] | null; tw: [number, number] | null; tp: [number, number] | null;
    v: number[]; vw: string; col: string;
  }
  type Shape = 'cylinder' | 'disc' | 'box';
  type Unit = 'mm' | 'in';
  const items: Item[] = JSON.parse(document.getElementById('id-data')!.textContent!);
  const $ = <T extends HTMLElement>(id: string) => document.getElementById(id) as T;
  const form = $<HTMLFormElement>('id-form');
  const inD = $<HTMLInputElement>('id-d');
  const inH = $<HTMLInputElement>('id-h');
  const inP = $<HTMLInputElement>('id-p');
  const inV = $<HTMLInputElement>('id-v');
  const pWrap = $('id-p-wrap');
  const list = $('id-list');
  const results = $('id-results');
  const empty = $('id-empty');
  const warn = $('id-warn');
  const shapeBtns = [...document.querySelectorAll<HTMLButtonElement>('[data-shape]')];
  const unitBtns = [...document.querySelectorAll<HTMLButtonElement>('[data-unit]')];

  // Shared with /actual-size: one remembered choice of units for the site.
  const UNIT_KEY = 'batteries:units';
  const stored = (): Unit | null => {
    try { const v = localStorage.getItem(UNIT_KEY); return v === 'in' || v === 'mm' ? v : null; } catch { return null; }
  };
  const remember = (u: Unit) => { try { localStorage.setItem(UNIT_KEY, u); } catch {} };

  let shape: Shape = 'cylinder';
  let unit: Unit = 'mm';
  const esc = (s: string) => String(s).replace(/[&<>"]/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' })[c]!);
  const num = (el: HTMLInputElement) => {
    const x = parseFloat(el.value);
    return isFinite(x) && x > 0 ? x : null;
  };
  const toMM = (x: number | null) => (x === null ? null : unit === 'in' ? x * 25.4 : x);
  /** A difference in both units, millimeters first. */
  const show = (mm: number) => `${Number(mm.toFixed(2))} mm (${(mm / 25.4).toFixed(mm < 2.54 ? 3 : 2)} in)`;

  const LABELS: Record<Shape, { d: string; h: string; dh: string; hh: string }> = {
    cylinder: { d: 'How wide', h: 'How long', dh: 'Across the widest part', hh: 'End to end, including the bump on the + end' },
    disc: { d: 'How wide', h: 'How thick', dh: 'Across the flat side', hh: 'From one flat side to the other' },
    box: { d: 'Width', h: 'Height', dh: 'The widest side', hh: 'Including the terminals on top' },
  };

  function setShape(s: Shape) {
    shape = s;
    shapeBtns.forEach((b) => b.setAttribute('aria-pressed', String(b.dataset.shape === s)));
    $('id-d-label').textContent = LABELS[s].d;
    $('id-h-label').textContent = LABELS[s].h;
    $('id-d-hint').textContent = LABELS[s].dh;
    $('id-h-hint').textContent = LABELS[s].hh;
    pWrap.hidden = s !== 'box';
  }
  function setUnit(u: Unit, convert = true) {
    if (u === unit) return;
    if (convert) {
      for (const el of [inD, inH, inP]) {
        const x = num(el);
        if (x !== null) el.value = String(u === 'in' ? Number((x / 25.4).toFixed(4)) : Number((x * 25.4).toFixed(2)));
      }
    }
    unit = u;
    unitBtns.forEach((b) => b.setAttribute('aria-pressed', String(b.dataset.unit === u)));
    document.querySelectorAll('.unit').forEach((el) => (el.textContent = u === 'in' ? 'in' : 'mm'));
  }

  /** How far x falls outside [lo, hi], or 0 inside. */
  const gap = (x: number, t: [number, number] | null, nominal: number) => {
    const [lo, hi] = t ?? [nominal, nominal];
    // 0.01 mm of slack absorbs rounding from inch conversion.
    return x < lo - 0.01 ? x - lo : x > hi + 0.01 ? x - hi : 0;
  };
  const WORDS: Record<string, [string, string, string]> = {
    diameter: ['wider', 'narrower', 'same width'],
    length: ['longer', 'shorter', 'same length'],
    thickness: ['thicker', 'thinner', 'same thickness'],
    width: ['wider', 'narrower', 'same width'],
    depth: ['deeper', 'shallower', 'same depth'],
    height: ['taller', 'shorter', 'just as tall'],
  };
  const deltaText = (label: string, mm: number) => {
    const [more, less, same] = WORDS[label];
    if (Math.abs(mm) < 0.05) return same;
    return `${show(Math.abs(mm))} ${mm > 0 ? more : less}`;
  };

  function score(it: Item, D: number | null, H: number | null, P: number | null, V: number | null) {
    let dist = 0;
    const deltas: string[] = [];
    let inside = true;
    let tol = false; // any compared dimension with a published min/max range
    const spread = (t: [number, number] | null) => !!t && t[1] - t[0] > 0.001;
    if (shape !== 'box') {
      const hLabel = shape === 'disc' ? 'thickness' : 'length';
      let sum = 0;
      if (D !== null && it.d) {
        const g = gap(D, it.td, it.d);
        sum += (g / it.d) ** 2;
        if (g) inside = false;
        tol ||= spread(it.td);
        deltas.push(deltaText('diameter', it.d - D));
      }
      if (H !== null) {
        const g = gap(H, it.th, it.h);
        sum += ((0.6 * g) / it.h) ** 2;
        if (g) inside = false;
        tol ||= spread(it.th);
        deltas.push(deltaText(hLabel, it.h - H));
      }
      dist = Math.sqrt(sum);
    } else {
      // Orientation-free: sort both sides of the comparison largest first.
      const sides = [
        { label: 'width', v: it.w ?? 0, t: it.tw },
        { label: 'depth', v: it.p ?? 0, t: it.tp },
        { label: 'height', v: it.h, t: it.th },
      ].sort((a, b) => b.v - a.v);
      const meas = [D, P, H].filter((x): x is number => x !== null).sort((a, b) => b - a);
      // Choose which of the entry's sides the measurements correspond to.
      const combos: number[][] = meas.length === 3 ? [[0, 1, 2]] : meas.length === 2 ? [[0, 1], [0, 2], [1, 2]] : [[0], [1], [2]];
      let best = { sum: Infinity, combo: combos[0] };
      for (const c of combos) {
        let sum = 0;
        c.forEach((si, i) => (sum += (gap(meas[i], sides[si].t, sides[si].v) / sides[si].v) ** 2));
        if (sum < best.sum) best = { sum, combo: c };
      }
      dist = Math.sqrt(best.sum);
      best.combo.forEach((si, i) => {
        if (gap(meas[i], sides[si].t, sides[si].v)) inside = false;
        tol ||= spread(sides[si].t);
        deltas.push(deltaText(sides[si].label, sides[si].v - meas[i]));
      });
    }
    let vNote = '';
    let vMatch: boolean | null = null;
    if (V !== null && it.v.length) {
      const off = Math.min(...it.v.map((n) => Math.abs(Math.log(V / n))));
      vMatch = off <= 0.12;
      if (!vMatch) dist += 0.5 * (off - 0.12);
      vNote = vMatch ? 'voltage matches' : 'voltage is different';
    }
    return { it, dist, deltas, inside, tol, vNote, vMatch };
  }

  function thumb(it: Item, D: number | null, H: number | null, P: number | null) {
    // Entry outline (filled) with the measurement (dashed) at one scale.
    let bw: number, bh: number, mw: number | null, mh: number | null, round = false;
    if (shape === 'disc') {
      bw = bh = it.d ?? 0;
      mw = mh = D;
      round = true;
    } else if (shape === 'cylinder') {
      bw = it.d ?? 0; bh = it.h; mw = D; mh = H;
    } else {
      const sides = [it.w ?? 0, it.p ?? 0, it.h].sort((a, b) => b - a);
      const meas = [D, P, H].filter((x): x is number => x !== null).sort((a, b) => b - a);
      bh = sides[0]; bw = sides[1]; mh = meas[0] ?? null; mw = meas[1] ?? null;
    }
    const W = Math.max(bw, mw ?? 0), Hh = Math.max(bh, mh ?? 0);
    const pad = Math.max(W, Hh) * 0.06;
    const vb = `${-W / 2 - pad} ${-Hh - pad} ${W + 2 * pad} ${Hh + 2 * pad}`;
    const sw = Math.max(W, Hh) * 0.025;
    const cy = -Hh / 2;
    const body = round
      ? `<circle cx="0" cy="${cy}" r="${bw / 2}" fill="${it.col}" fill-opacity="0.85" />`
      : `<rect x="${-bw / 2}" y="${-bh}" width="${bw}" height="${bh}" fill="${it.col}" fill-opacity="0.85" />`;
    let meas = '';
    if (mw && mh) {
      meas = round
        ? `<circle cx="0" cy="${cy}" r="${mw / 2}" fill="none" stroke="currentColor" stroke-width="${sw}" stroke-dasharray="${sw * 2} ${sw * 1.5}" />`
        : `<rect x="${-mw / 2}" y="${-mh}" width="${mw}" height="${mh}" fill="none" stroke="currentColor" stroke-width="${sw}" stroke-dasharray="${sw * 2} ${sw * 1.5}" />`;
    }
    return `<svg viewBox="${vb}" class="w-full h-full text-ink" preserveAspectRatio="xMidYMax meet" aria-hidden="true">${body}${meas}</svg>`;
  }

  function writeURL(D: number | null, H: number | null, P: number | null, V: number | null) {
    const q = new URLSearchParams();
    if (D !== null || H !== null || P !== null || V !== null) q.set('shape', shape);
    if (inD.value) q.set('d', inD.value);
    if (inH.value) q.set('h', inH.value);
    if (shape === 'box' && inP.value) q.set('p', inP.value);
    if (inV.value) q.set('v', inV.value);
    if (unit === 'in' && (inD.value || inH.value || inP.value)) q.set('u', 'in');
    const s = q.toString();
    history.replaceState(null, '', s ? `?${s}` : location.pathname);
  }

  function run() {
    const D = toMM(num(inD)), H = toMM(num(inH)), P = shape === 'box' ? toMM(num(inP)) : null, V = num(inV);
    writeURL(D, H, P, V);
    warn.hidden = true;
    if (shape === 'cylinder' && D && H && H < D) {
      warn.hidden = false;
      warn.innerHTML = `The length is less than the width. Flat round batteries are matched separately. <button type="button" class="link" data-switch="disc">Match it as a coin or button battery</button>`;
    } else if (shape === 'disc' && D && H && H > D) {
      warn.hidden = false;
      warn.innerHTML = `It is thicker than it is wide. <button type="button" class="link" data-switch="cylinder">Match it as a round battery</button>`;
    }
    if (D === null && H === null && P === null) {
      results.hidden = true;
      empty.hidden = false;
      return;
    }
    empty.hidden = true;
    results.hidden = false;
    const ranked = items
      .filter((it) => it.cls === shape)
      .map((it) => score(it, D, H, P, V))
      .sort((a, b) => a.dist - b.dist)
      .slice(0, 8);
    list.innerHTML = ranked
      .map((r, i) => {
        const q = Math.round(100 * Math.exp(-((r.dist / 0.1) ** 2)));
        const chips = [
          r.inside ? (r.tol ? 'inside the maker’s allowed range' : 'matches the listed size') : '',
          r.vNote,
        ].filter(Boolean);
        return `<li class="card p-4 flex gap-4 items-center">
          <div class="w-14 h-16 shrink-0 bg-surface-2 p-1 flex items-end justify-center">${thumb(r.it, D, H, P)}</div>
          <div class="min-w-0 flex-1">
            <p class="flex items-baseline gap-x-3 flex-wrap">
              <span class="text-sm text-ink-2 font-mono">${i + 1}.</span>
              <a href="/${r.it.id}" class="link font-mono font-semibold text-lg">${esc(r.it.n)}</a>
              <span class="text-sm text-ink-2">${esc(r.it.c)}, ${esc(r.it.s)}, ${esc(r.it.vw)}</span>
            </p>
            <p class="mt-1 text-base text-ink">${esc(r.deltas.join(', '))}</p>
            ${chips.length ? `<p class="mt-1 flex flex-wrap gap-2">${chips.map((c) => `<span class="chip whitespace-normal">${esc(c)}</span>`).join('')}</p>` : ''}
            <div class="mt-2 flex items-center gap-3">
              <div class="h-2 flex-1 max-w-[12rem] bg-surface-3 overflow-hidden" aria-hidden="true"><div class="h-full bg-accent" style="width:${q}%"></div></div>
              <span class="text-sm text-ink-2 tabular" title="distance ${r.dist.toFixed(3)}">${q}% match</span>
            </div>
          </div>
        </li>`;
      })
      .join('');
  }

  shapeBtns.forEach((b) => b.addEventListener('click', () => { setShape(b.dataset.shape as Shape); run(); }));
  unitBtns.forEach((b) => b.addEventListener('click', () => { const u = b.dataset.unit as Unit; setUnit(u); remember(u); run(); }));
  [inD, inH, inP, inV].forEach((el) => el.addEventListener('input', run));
  form.addEventListener('submit', (e) => e.preventDefault());
  form.addEventListener('reset', () => setTimeout(run, 0));
  warn.addEventListener('click', (e) => {
    const t = (e.target as HTMLElement).closest('[data-switch]') as HTMLElement | null;
    if (t) { setShape(t.dataset.switch as Shape); run(); }
  });

  function load(qs: string) {
    const q = new URLSearchParams(qs);
    const sh = (q.get('shape') ?? '').toLowerCase();
    const alias: Record<string, Shape> = { cylinder: 'cylinder', round: 'cylinder', disc: 'disc', coin: 'disc', button: 'disc', box: 'box', rect: 'box', rectangular: 'box' };
    setShape(alias[sh] ?? 'cylinder');
    // Values in a link are millimeters unless it says u=in. Show them in the
    // visitor's remembered units, else the link's, else millimeters.
    const linkUnit: Unit = q.get('u') === 'in' ? 'in' : 'mm';
    setUnit(linkUnit, false);
    inD.value = q.get('d') ?? q.get('w') ?? '';
    inH.value = q.get('h') ?? '';
    inP.value = q.get('p') ?? '';
    inV.value = q.get('v') ?? '';
    setUnit(stored() ?? linkUnit);
    run();
  }
  document.querySelectorAll<HTMLAnchorElement>('[data-example]').forEach((a) =>
    a.addEventListener('click', (e) => { e.preventDefault(); load(a.dataset.example!); inD.focus(); }),
  );
  load(location.search);
</script>
