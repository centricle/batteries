---
import BaseLayout from '../layouts/BaseLayout.astro';
const tools = [
  { href: '/identify', title: 'Identify a battery by its size', body: 'Measure a battery with a ruler and find the sizes that match.' },
  { href: '/actual-size', title: 'See a battery at actual size', body: 'Set your screen with a bank card, then hold a battery up to its real-size drawing. It prints at actual size too.' },
  { href: '/decode', title: 'What the letters and numbers mean', body: 'What each letter and number in a battery name tells you.' },
  { href: '/equivalents', title: 'Other names for every battery', body: 'Every name each battery is sold under, on one page.' },
  { href: '/compare', title: 'Compare battery sizes', body: 'Put any batteries side by side at their real sizes, in 3D, with a table of the differences.' },
  { href: '/devices', title: 'What battery does it take?', body: 'Look up a device to see the battery its maker says it takes.' },
  { href: '/calculators', title: 'Battery calculators', body: 'Energy in watt-hours, how long a battery will run, batteries in series and parallel, and airline limits.' },
  { href: '/search', title: 'Search', body: 'Search by the name on the battery, what it goes in, its voltage or its size.' },
  { href: '/data', title: 'Data, 3D models and API', body: 'All the data as JSON and CSV, and a 3D model of every battery to download.' },
];
---

<BaseLayout title="Battery tools: identify, compare, read the name, calculate | batteries.fyi" description="Free battery tools: identify a battery by measuring it, see one at actual size, read what a battery name means, find its other names, compare sizes in 3D, and calculators.">
  <section class="wrap pt-8">
    <h1 class="text-2xl sm:text-3xl font-semibold">Battery tools</h1>
    <p class="lede measure mt-3">Ways to find, measure and compare batteries. If you are holding a battery and do not know what it is, start with the first one.</p>
    <p class="mt-2 text-base text-ink-2 measure">Each tool runs in your browser on the same data as the battery pages.</p>
  </section>
  <section class="wrap mt-6">
    <ul class="grid gap-3 sm:grid-cols-2">
      {tools.map((t) => (
        <li><a href={t.href} class="tile card block h-full">
          <span class="block font-mono text-lg font-semibold">{t.title}</span>
          <span class="block text-base text-ink-2 mt-1">{t.body}</span>
        </a></li>
      ))}
    </ul>
  </section>
</BaseLayout>
