---
import BaseLayout from '../layouts/BaseLayout.astro';
import { batteries, chem, primaryVariant, searchIndex, sizeLabel } from '../lib/data';

// What the client needs to rebuild each outline with the same parametric
// model the silhouettes and 3D viewer use: nominal dimensions and geometry hints.
const nom = (x?: { nominal: number }) => (x ? { nominal: x.nominal } : undefined);
const specs = Object.fromEntries(
  batteries().map((b) => [
    b.id,
    {
      id: b.id,
      name: b.name,
      form: b.form,
      category: b.category,
      size: sizeLabel(b, false),
      dimensions: { diameter: nom(b.dimensions.diameter), height: nom(b.dimensions.height)!, width: nom(b.dimensions.width), depth: nom(b.dimensions.depth) },
      geometry: b.geometry ?? {},
      col: chem(primaryVariant(b).chemistry).color,
    },
  ]),
);
const jsonld = {
  '@context': 'https://schema.org',
  '@type': 'WebApplication',
  name: 'Batteries at actual size',
  url: 'https://batteries.fyi/actual-size',
  applicationCategory: 'UtilitiesApplication',
  operatingSystem: 'Any',
  browserRequirements: 'Requires JavaScript',
  isAccessibleForFree: true,
  description: 'Calibrate the screen against a bank card, then see batteries drawn at their true physical size on a millimeter ruler, or print them at actual size.',
};
---

<BaseLayout title="Batteries at actual size: calibrated on-screen and printable | batteries.fyi" description="See AA, AAA, CR2032, LR44, 9V, 18650 and any other battery at true physical size. Calibrate your screen with a bank card, or print the page at 100% scale." jsonld={jsonld}>
  <div id="as-screen" class="print:hidden">
    <section class="wrap pt-8">
      <p class="eyebrow">Tool</p>
      <h1 class="text-[2rem] font-semibold tracking-tight mt-1">Batteries at actual size</h1>
      <p class="mt-2 text-[0.8rem] text-ink-2 max-w-2xl">This page draws batteries at their real physical size, so you can hold one against the screen and compare. Screens differ in pixel density, so first match the outline below to a bank card, driver's license or any other ID-1 card (85.60 × 53.98 mm). The setting is saved in this browser. For a sheet you can measure with a ruler, print the page at 100% scale; print sizes are exact without calibration.</p>
    </section>

    <section class="wrap mt-6" aria-labelledby="cal-h">
      <div class="card overflow-hidden">
        <div class="p-4 sm:p-5 border-b border-line">
          <h2 id="cal-h" class="text-[0.95rem] font-semibold">1. Calibrate</h2>
          <p class="mt-1 text-[0.7rem] text-ink-2">Hold a card flat against the screen with its corner at the top left of the outline. Move the slider until the outline's edges meet the card's edges.</p>
          <div class="mt-3 flex flex-wrap items-center gap-2">
            <label for="cal-k" class="text-[0.68rem] font-semibold">Card size</label>
            <button type="button" class="btn btn-sm w-9" id="cal-minus" aria-label="Make the outline smaller">−</button>
            <input id="cal-k" type="range" min="2" max="10" step="0.01" class="w-48 sm:w-72 accent-[var(--accent)]" aria-describedby="cal-read" />
            <button type="button" class="btn btn-sm w-9" id="cal-plus" aria-label="Make the outline larger">+</button>
            <button type="button" class="btn btn-sm" id="cal-reset">Reset</button>
          </div>
          <p class="mt-2 text-[0.62rem] text-muted tabular" id="cal-read" aria-live="polite"></p>
        </div>
        <div class="grid-paper p-0 overflow-x-auto" id="cal-stage"></div>
      </div>
    </section>

    <section class="wrap mt-8" aria-labelledby="pick-h">
      <h2 id="pick-h" class="text-[0.95rem] font-semibold">2. Choose batteries</h2>
      <div class="mt-3 flex flex-wrap items-center gap-2" id="as-picked" aria-live="polite"></div>
      <div class="mt-3 flex flex-wrap gap-2 items-start">
        <div class="relative w-full max-w-md">
          <label for="as-add" class="sr-only">Add a battery</label>
          <input id="as-add" class="input" placeholder="Add a battery: name or any code" autocomplete="off" role="combobox" aria-expanded="false" aria-controls="as-list" aria-autocomplete="list" />
          <ul id="as-list" class="card absolute z-20 left-0 right-0 mt-1 max-h-72 overflow-y-auto hidden" role="listbox" aria-label="Matching batteries"></ul>
        </div>
        <button type="button" class="btn" id="as-default">Default set</button>
        <button type="button" class="btn btn-primary" id="as-print">Print at actual size</button>
      </div>
    </section>

    <section class="wrap mt-6" aria-labelledby="stage-h">
      <h2 id="stage-h" class="sr-only">Batteries at actual size</h2>
      <div class="card grid-paper p-3 sm:p-4 overflow-x-auto" id="as-stage"></div>
      <p class="mt-2 text-[0.62rem] text-muted">Nominal dimensions, drawn at the calibrated scale on a millimeter ruler. Cylinders and packs stand upright with the positive end up. Coin and button cells appear twice: face-on, then edge-on.</p>
    </section>

    <section class="wrap mt-12">
      <h2 class="section-title" id="how">How it works</h2>
      <div class="prose">
        <p>A CSS pixel has no fixed physical size; it depends on the screen. Calibration finds the number of CSS pixels per millimeter, <span class="mono">k</span>, from the card: <span class="mono">k = outline width in pixels ÷ 85.60 mm</span>. Every shape is then drawn with <span class="mono">pixels = millimeters × k</span>. Before calibration the page assumes the CSS reference of 96 pixels per inch, <span class="mono">96 ÷ 25.4 = 3.78</span> pixels per millimeter, which is right on few screens. Zooming the browser changes the drawing; calibrate again at the zoom you use.</p>
        <p>Printing uses CSS millimeter units instead, which printers honor exactly at 100% scale. Turn off "Fit to page" or "Shrink to fit" in the print dialog, then check the 50 mm bar on the sheet with a ruler.</p>
        <p>The card size, 85.60 × 53.98 mm, is the ID-1 format of ISO/IEC 7810, used by bank cards and most driver's licenses. Outlines come from the same parametric model as the site's 3D views, built from each entry's published nominal dimensions; terminal proportions that datasheets do not give are drawn with typical values. See each battery's page for dimensions, tolerances and sources.</p>
      </div>
    </section>
  </div>

  <div id="print-sheet" class="hidden print:block">
    <p style="font: 600 12pt system-ui, sans-serif; margin: 0 0 2mm">batteries.fyi: batteries at actual size</p>
    <p style="font: 9pt system-ui, sans-serif; margin: 0 0 4mm">Printed at 100% scale, the bar below measures exactly 50 mm. If it does not, turn off "Fit to page" and print again. Nominal dimensions.</p>
    <div id="print-rows"></div>
  </div>

  <script type="application/json" id="as-specs" set:html={JSON.stringify(specs)} />
  <script type="application/json" id="as-index" set:html={JSON.stringify(searchIndex())} />
</BaseLayout>

<style>
  @media print {
    @page { margin: 12mm; }
    :global(#print-sheet) { color: #000; -webkit-print-color-adjust: exact; print-color-adjust: exact; }
    :global(#print-sheet svg) { break-inside: avoid; page-break-inside: avoid; margin-bottom: 6mm; }
    :global(#print-sheet .as-text) { fill: #000; }
    :global(#print-sheet .as-muted) { fill: #444; }
    :global(#print-sheet .as-tick) { stroke: #000; }
  }
  :global(#as-list li[aria-selected="true"]) { background: var(--accent-soft); }
  :global(.as-text) { fill: var(--ink); font-family: var(--font-sans); }
  :global(.as-muted) { fill: var(--muted); font-family: var(--font-sans); }
  :global(.as-tick) { stroke: var(--ink-2); }
  :global(.as-card) { fill: color-mix(in oklch, var(--accent) 12%, transparent); stroke: var(--accent-ink); }
</style>

<script>
  // @ts-ignore: plain JS module shared with the 3D viewer
  import { describe, MATERIALS } from '../lib/geometry/model.js';
  import { rank, type Entry } from '../lib/search';

  interface Spec { id: string; name: string; form: string; category: string; size: string; dimensions: any; geometry: any; col: string }
  const specs: Record<string, Spec> = JSON.parse(document.getElementById('as-specs')!.textContent!);
  const index: Entry[] = JSON.parse(document.getElementById('as-index')!.textContent!);
  const DEFAULT = ['aa', 'aaa', 'cr2032', 'lr44', '9v', '18650'];
  const CARD = { w: 85.6, h: 53.98, r: 3.18 };
  const KEY = 'batteries:px-per-mm';
  const BASE = 96 / 25.4;

  const $ = <T extends HTMLElement>(id: string) => document.getElementById(id) as T;
  const slider = $<HTMLInputElement>('cal-k');
  const read = $('cal-read');
  const calStage = $('cal-stage');
  const stage = $('as-stage');
  const picked = $('as-picked');
  const add = $<HTMLInputElement>('as-add');
  const list = $('as-list');
  const esc = (s: string) => String(s).replace(/[&<>"]/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' })[c]!);
  const n2 = (x: number) => Number(x.toFixed(3));

  // ---------------------------------------------------------- calibration
  let k = BASE;
  try {
    const v = parseFloat(localStorage.getItem(KEY) ?? '');
    if (isFinite(v) && v >= 2 && v <= 10) k = v;
  } catch {}
  slider.value = String(k);

  function setK(v: number, save = true) {
    k = Math.min(10, Math.max(2, v));
    slider.value = String(k);
    if (save) {
      try { localStorage.setItem(KEY, String(k)); } catch {}
    }
    drawCard();
    drawStage();
  }

  function drawCard() {
    const avail = calStage.clientWidth - 2;
    const portrait = CARD.w * k > avail && CARD.h * k <= avail;
    const w = portrait ? CARD.h : CARD.w;
    const h = portrait ? CARD.w : CARD.h;
    const pad = 2;
    calStage.innerHTML = `<svg width="${(w + pad * 2) * k}" height="${(h + pad * 2) * k}" viewBox="${-pad} ${-pad} ${w + pad * 2} ${h + pad * 2}" role="img" aria-label="Card outline, ${portrait ? 'portrait' : 'landscape'}, 85.60 by 53.98 millimeters at the current scale">
      <rect x="0" y="0" width="${w}" height="${h}" rx="${CARD.r}" class="as-card" stroke-width="${1.5 / k}" />
      <text x="${w / 2}" y="${h / 2}" text-anchor="middle" dominant-baseline="middle" class="as-muted" font-size="${12 / k}">ID-1 card, 85.60 × 53.98 mm</text>
    </svg>`;
    const dpi = k * 25.4;
    read.textContent = `${n2(k)} pixels per millimeter (${dpi.toFixed(1)} pixels per inch). Outline width ${(CARD.w * k).toFixed(1)} px = 85.60 mm × ${n2(k)}.${portrait ? ' Shown upright to fit the screen.' : ''}${Math.abs(k - BASE) < 0.005 ? ' Not yet calibrated: this is the 96 dpi default.' : ''}`;
  }

  slider.addEventListener('input', () => setK(parseFloat(slider.value)));
  $('cal-minus').addEventListener('click', () => setK(k - 0.01));
  $('cal-plus').addEventListener('click', () => setK(k + 0.01));
  $('cal-reset').addEventListener('click', () => {
    try { localStorage.removeItem(KEY); } catch {}
    setK(BASE, false);
  });

  // -------------------------------------------------------------- shapes
  interface View { kind: 'front' | 'face' | 'edge'; w: number; h: number; x0: number; svg: (x: number, gid: string) => string }
  interface Group { id: string; name: string; size: string; views: View[]; w: number; h: number }
  const cache = new Map<string, Group>();
  const ORDER = ['wrap', 'cap-plastic', 'can', 'gasket', 'steel', 'insulator', 'ring', 'brass', 'spring', 'tab'];
  const VIEW_GAP = 3;

  function fillFor(s: Spec, mat: string) {
    if (mat === 'wrap') return s.col;
    if (mat === 'tab' && s.geometry?.tab_color) return s.geometry.tab_color;
    return (MATERIALS as any)[mat]?.color ?? '#999';
  }

  function group(id: string): Group | null {
    if (cache.has(id)) return cache.get(id)!;
    const s = specs[id];
    if (!s) return null;
    const m = describe(s as any);
    const parts = [...m.parts].sort((a: any, c: any) => ORDER.indexOf(a.material) - ORDER.indexOf(c.material));
    const [bx0, by0] = m.bounds.min;
    const [bx1, by1] = m.bounds.max;
    const front: View = {
      kind: s.form === 'disc' ? 'edge' : 'front',
      w: bx1 - bx0,
      h: by1 - by0,
      x0: bx0,
      svg: (x, gid) =>
        parts
          .map((p: any) => {
            const d = 'M' + p.front.map(([px, py]: number[]) => `${(x + px - bx0).toFixed(3)} ${(-(py - by0)).toFixed(3)}`).join('L') + 'Z';
            return `<path d="${d}" fill="${fillFor(s, p.material)}" />${p.material !== 'tab' ? `<path d="${d}" fill="url(#${gid})" />` : ''}`;
          })
          .join(''),
    };
    const views: View[] = [];
    if (s.form === 'disc') {
      const R = s.dimensions.diameter.nominal / 2;
      views.push({
        kind: 'face',
        w: 2 * R,
        h: 2 * R,
        x0: -R,
        svg: (x, gid) => {
          const cx = x + R, cy = -R;
          let o = `<circle cx="${cx}" cy="${cy}" r="${R}" fill="${fillFor(s, 'can')}" /><circle cx="${cx}" cy="${cy}" r="${R}" fill="url(#${gid}-r)" />`;
          o += `<circle cx="${cx}" cy="${cy}" r="${R * 0.9}" fill="none" stroke="#000" stroke-opacity="0.15" stroke-width="${R * 0.02}" />`;
          if (s.category === 'hearing-aid') o += `<circle cx="${cx}" cy="${cy}" r="${R * 0.93}" fill="${fillFor(s, 'tab')}" />`;
          return o;
        },
      });
    }
    views.push(front);
    const w = views.reduce((a, v) => a + v.w, 0) + VIEW_GAP * (views.length - 1);
    const g = { id, name: s.name, size: s.size, views, w, h: Math.max(...views.map((v) => v.h)) };
    cache.set(id, g);
    return g;
  }

  /** Greedy row packing in millimeters. */
  /** Width a group needs: its drawings, or its label if that is wider. */
  const slot = (g: Group, px: number) => Math.max(g.w, g.name.length * 11 * px * 0.62, g.size.length * 9 * px * 0.56);

  function pack(groups: Group[], avail: number, gap: number, px: number) {
    const rows: Group[][] = [];
    let row: Group[] = [];
    let used = 0;
    for (const g of groups) {
      const need = (row.length ? gap : 0) + slot(g, px);
      if (row.length && used + need > avail) {
        rows.push(row);
        row = [];
        used = 0;
      }
      used += (row.length ? gap : 0) + slot(g, px);
      row.push(g);
    }
    if (row.length) rows.push(row);
    return rows;
  }

  /**
   * One row as SVG. `unit` sets the outer size: 'px' scales mm by k for the
   * screen; 'mm' writes CSS millimeters for print. `px` is the size of one
   * screen pixel in mm, used to keep strokes and text legible.
   */
  function rowSVG(row: Group[], gap: number, unit: 'px' | 'mm', px: number, ri: number) {
    const margin = 3;
    const width = row.reduce((a, g) => a + slot(g, px), 0) + gap * (row.length - 1);
    const rulerLen = Math.ceil((width + margin) / 10) * 10;
    const top = Math.max(...row.map((g) => g.h)) + 13 * px + 2;
    const rulerH = 6;
    const labelH = 32 * px;
    const totalW = rulerLen + margin * 2 + Math.max(36 * px, 8);
    const totalH = top + rulerH + labelH;
    const gid = `asg-${unit}-${ri}`;
    let body = '';
    let x = margin;
    for (const g of row) {
      const sw = slot(g, px);
      let vx = x + (sw - g.w) / 2;
      for (const v of g.views) {
        body += v.svg(vx, gid);
        if (g.views.length > 1) body += `<text x="${vx + v.w / 2}" y="${-v.h - 4 * px}" text-anchor="middle" class="as-muted" font-size="${9 * px}">${v.kind}</text>`;
        vx += v.w + VIEW_GAP;
      }
      const cx = x + sw / 2;
      body += `<text x="${cx}" y="${rulerH + 13 * px}" text-anchor="middle" class="as-text" font-weight="650" font-size="${11 * px}">${esc(g.name)}</text>`;
      body += `<text x="${cx}" y="${rulerH + 26 * px}" text-anchor="middle" class="as-muted" font-size="${9 * px}">${esc(g.size)}</text>`;
      x += sw + gap;
    }
    // Ruler: baseline at y = 0, ticks every millimeter below it.
    let ruler = `<line x1="0" y1="0" x2="${rulerLen}" y2="0" class="as-tick" stroke-width="${Math.max(px, 0.12)}" transform="translate(${margin} 0)" />`;
    for (let i = 0; i <= rulerLen; i++) {
      const len = i % 10 === 0 ? 3.2 : i % 5 === 0 ? 2.2 : 1.2;
      ruler += `<line x1="${margin + i}" y1="0" x2="${margin + i}" y2="${len}" class="as-tick" stroke-width="${Math.max(px * 0.9, 0.1)}" />`;
      if (i % 10 === 0) ruler += `<text x="${margin + i + 0.6}" y="${rulerH - 0.4}" class="as-muted" font-size="${Math.max(8 * px, 1.8)}">${i}${i === rulerLen ? ' mm' : ''}</text>`;
    }
    const outerW = unit === 'px' ? `${(totalW / px).toFixed(2)}` : `${totalW}mm`;
    const outerH = unit === 'px' ? `${(totalH / px).toFixed(2)}` : `${totalH}mm`;
    const defs = `<defs>
      <linearGradient id="${gid}" x1="0" x2="1" y1="0" y2="0"><stop offset="0" stop-color="#000" stop-opacity="0.22" /><stop offset="0.35" stop-color="#fff" stop-opacity="0.18" /><stop offset="0.6" stop-color="#fff" stop-opacity="0" /><stop offset="1" stop-color="#000" stop-opacity="0.28" /></linearGradient>
      <radialGradient id="${gid}-r" cx="0.38" cy="0.35" r="0.75"><stop offset="0" stop-color="#fff" stop-opacity="0.35" /><stop offset="1" stop-color="#000" stop-opacity="0.2" /></radialGradient>
    </defs>`;
    const names = row.map((g) => g.name).join(', ');
    return `<svg width="${outerW}" height="${outerH}" viewBox="0 ${-top} ${totalW} ${totalH}" role="img" aria-label="${esc(names)} at actual size on a millimeter ruler" style="display:block;overflow:visible">${defs}${body}${ruler}</svg>`;
  }

  // --------------------------------------------------------------- state
  const params = new URLSearchParams(location.search);
  let ids = (params.get('ids') ?? DEFAULT.join(',')).split(',').map((s) => s.trim().toLowerCase()).filter((id, i, a) => specs[id] && a.indexOf(id) === i);
  if (!params.get('ids') && !ids.length) ids = [...DEFAULT];

  function drawStage() {
    const groups = ids.map(group).filter(Boolean) as Group[];
    if (!groups.length) {
      stage.innerHTML = '<p class="text-[0.72rem] text-muted p-2">Nothing selected. Add a battery above.</p>';
    } else {
      const px = 1 / k;
      // Leave room for margins, ruler rounding (up to 10 mm) and the unit label.
      const avail = (stage.clientWidth - 40) * px - 16 - Math.max(36 * px, 8);
      stage.innerHTML = `<div class="space-y-6">${pack(groups, Math.max(avail, 10), 8, px).map((r, i) => rowSVG(r, 8, 'px', px, i)).join('')}</div>`;
    }
    // Print sheet: CSS millimeters, about 180 mm of usable width on A4 and Letter.
    $('print-rows').innerHTML =
      `<svg width="70mm" height="8mm" viewBox="0 0 70 8" style="display:block;margin-bottom:6mm"><rect x="0" y="2" width="50" height="3" fill="#000" /><text x="51.5" y="5" font-size="3" font-family="system-ui, sans-serif">50 mm</text></svg>` +
      (groups.length ? pack(groups, 165, 8, 0.3).map((r, i) => rowSVG(r, 8, 'mm', 0.3, i)).join('') : '');
  }

  function renderPicked() {
    history.replaceState(null, '', ids.join(',') === DEFAULT.join(',') ? location.pathname : `?ids=${ids.join(',')}`);
    picked.innerHTML = ids.length
      ? ids
          .map((id) => `<span class="chip text-[0.7rem] py-1 pl-2.5 pr-1"><a href="/${id}" class="font-semibold">${esc(specs[id].name)}</a><button type="button" data-remove="${id}" class="w-5 h-5 hover:bg-surface-2" aria-label="Remove ${esc(specs[id].name)}">×</button></span>`)
          .join('')
      : '<span class="text-[0.7rem] text-muted">Nothing selected.</span>';
    drawStage();
  }

  picked.addEventListener('click', (e) => {
    const b = (e.target as HTMLElement).closest('[data-remove]') as HTMLElement | null;
    if (!b) return;
    ids = ids.filter((x) => x !== b.dataset.remove);
    renderPicked();
    add.focus();
  });
  $('as-default').addEventListener('click', () => {
    ids = [...DEFAULT];
    renderPicked();
  });
  $('as-print').addEventListener('click', () => window.print());

  // Picker: ranked suggestions, arrow keys, Enter to add.
  let results: ReturnType<typeof rank> = [];
  let sel = 0;
  function suggest() {
    const q = add.value.trim();
    results = q ? rank(index, q, 8).filter((r) => !ids.includes(r.e.id)) : [];
    sel = 0;
    list.innerHTML = results
      .map(({ e, why }, i) => `<li role="option" id="as-opt-${i}" aria-selected="${i === sel}" data-id="${e.id}" class="flex items-center gap-2 px-3 py-2 cursor-pointer text-[0.72rem]"><span class="dot" style="background:${esc(e.col)}"></span><span class="font-semibold">${esc(e.n)}</span><span class="text-muted text-[0.62rem] truncate">${esc(e.s)}</span>${why ? `<span class="chip ml-auto">${esc(why)}</span>` : ''}</li>`)
      .join('');
    const open = results.length > 0;
    list.classList.toggle('hidden', !open);
    add.setAttribute('aria-expanded', String(open));
    add.setAttribute('aria-activedescendant', open ? `as-opt-${sel}` : '');
  }
  function highlight() {
    list.querySelectorAll('li').forEach((li, i) => li.setAttribute('aria-selected', String(i === sel)));
    add.setAttribute('aria-activedescendant', `as-opt-${sel}`);
  }
  function choose(id: string) {
    if (!ids.includes(id)) ids.push(id);
    add.value = '';
    suggest();
    renderPicked();
  }
  add.addEventListener('input', suggest);
  add.addEventListener('keydown', (e) => {
    if (e.key === 'ArrowDown' && results.length) { sel = Math.min(sel + 1, results.length - 1); highlight(); e.preventDefault(); }
    else if (e.key === 'ArrowUp' && results.length) { sel = Math.max(sel - 1, 0); highlight(); e.preventDefault(); }
    else if (e.key === 'Enter') { e.preventDefault(); if (results[sel]) choose(results[sel].e.id); }
    else if (e.key === 'Escape') { add.value = ''; suggest(); }
  });
  list.addEventListener('mousedown', (e) => {
    const li = (e.target as HTMLElement).closest('li[data-id]') as HTMLElement | null;
    if (li) { e.preventDefault(); choose(li.dataset.id!); }
  });
  add.addEventListener('blur', () => setTimeout(() => { list.classList.add('hidden'); add.setAttribute('aria-expanded', 'false'); }, 100));

  let rt: number | undefined;
  window.addEventListener('resize', () => {
    clearTimeout(rt);
    rt = window.setTimeout(() => { drawCard(); drawStage(); }, 120);
  });

  drawCard();
  renderPicked();
</script>
