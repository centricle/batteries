---
// "Where do I get one": a retailer search for the exact size, or for loose
// lithium-ion batteries the sourced capacity ceiling instead. Rules in
// src/lib/buy.ts.
import { amazonUrl, capacityCeiling, paid, sellable, shopQuery } from '../lib/buy';
import { fmt, type Battery } from '../lib/data';

interface Props { battery: Battery; context: 'battery' | 'device'; class?: string }
const { battery: b, context, class: cls = '' } = Astro.props;
const ceiling = sellable(b) ? null : capacityCeiling(b);
---

{sellable(b) ? (
  <p class={`text-sm text-ink-2 flex flex-wrap items-baseline gap-x-2 gap-y-1 ${cls}`}>
    <span class="label">Need one?</span>
    <a class="link" href={amazonUrl(shopQuery(b))} rel={paid ? 'sponsored noopener' : 'nofollow noopener'} target="_blank" data-buy={b.id} data-retailer="amazon" data-ctx={context}>Search Amazon for {b.name} batteries</a>
    <span>{paid ? `Paid link: a sale may earn batteries.fyi a commission. Any brand sold as ${b.name} is the same size.` : `Any brand sold as ${b.name} is the same size.`}</span>
  </p>
) : ceiling ? (
  <p class={`callout ${cls}`}>
    <strong class="text-ink">Buying {b.name} batteries.</strong> The highest capacity any source on this page gives for the {b.name} is {fmt(ceiling, 0)} mAh. A battery sold as larger claims more than any maker listed here publishes. <a class="link" href="/reference/lithium-ion-safety">Lithium-ion safety</a>
  </p>
) : null}
