---
// One type of battery (household, coin, button...): every size in it, the
// common ones first, then the same sizes in one table.
import BaseLayout from '../layouts/BaseLayout.astro';
import Silhouette from './Silhouette.astro';
import Viewer from './Viewer.astro';
import { batteries, CATEGORY_META, categoryById, chem, primaryVariant, sizeLabel, voltages, fmt, capacityLabel, chemistryGroups } from '../lib/data';
import { byCommon, list as listWords, tileFacts } from '../lib/plain';

interface Props { id: string }
const { id } = Astro.props;
const cat = categoryById[id];
const bySize = batteries().filter((b) => b.category === id);
const list = [...bySize].sort(byCommon);
const ref = (b: (typeof list)[number]) => (b.form === 'disc' ? b.dimensions.diameter!.nominal : b.dimensions.height.nominal);
const scale = Math.max(...list.map(ref));
// A lineup for the top of the page: up to 9 sizes spread from smallest to largest.
const step = Math.max(1, Math.ceil(bySize.length / 9));
const lineup = bySize.filter((_, i) => i % step === 0).slice(0, 9);
const voltsCell = (b: (typeof list)[number]) => `${listWords([...new Set(voltages(b))].sort((x, y) => x - y).map((v) => fmt(v, 2)))} V`;
const jsonld = {
  '@context': 'https://schema.org',
  '@type': 'CollectionPage',
  name: cat.name,
  description: cat.description,
  url: `https://batteries.fyi/${cat.slug}`,
  mainEntity: { '@type': 'ItemList', itemListElement: list.map((b, i) => ({ '@type': 'ListItem', position: i + 1, url: `https://batteries.fyi/${b.id}`, name: b.name })) },
};
---

<BaseLayout title={`${cat.name}: sizes, other names and what fits | batteries.fyi`} description={`${cat.description} ${list.length} sizes, each with its size, other names and what else fits.`} jsonld={jsonld}>
  <section class="wrap pt-8 pb-6">
    <nav aria-label="Types of battery">
      <ul class="flex flex-wrap gap-2 mb-6">
        {CATEGORY_META.map((c) => (
          <li>
            <a href={`/${c.slug}`} class:list={['chip link', c.id === id && 'font-semibold']} aria-current={c.id === id ? 'page' : undefined}>
              {c.name}
            </a>
          </li>
        ))}
      </ul>
    </nav>
    <h1 class="text-2xl sm:text-3xl font-semibold">{cat.name}</h1>
    <p class="lede measure mt-3">{cat.description}</p>
    <p class="mt-2 text-base text-ink-2 measure">There are {list.length} sizes on this page, the most common first.</p>
  </section>

  {lineup.length > 1 && (
    <section class="wrap">
      <Viewer batteries={lineup} mode="lineup" height="22rem" controls={false} />
    </section>
  )}

  <section class="wrap mt-8">
    <ul class="grid gap-3 grid-cols-1 min-[26rem]:grid-cols-2 sm:grid-cols-3 lg:grid-cols-4">
      {list.map((b) => {
        const f = tileFacts(b);
        return (
          <li>
            <a href={`/${b.id}`} class="tile card group flex flex-col h-full p-4">
              <span class="h-28 flex items-end justify-center mb-3">
                <Silhouette battery={b} scaleTo={scale} class="max-w-full" />
              </span>
              <span class="font-mono font-semibold text-lg text-ink group-hover:underline">{b.name}</span>
              <span class="mt-1 font-sans text-sm text-ink-2">{f.size}</span>
              <span class="font-sans text-sm text-ink-2">{f.volts}</span>
              {f.names.length > 0 && <span class="mt-1 font-sans text-sm text-ink-2">Also called {listWords(f.names)}</span>}
            </a>
          </li>
        );
      })}
    </ul>
    <p class="mt-3 text-sm text-ink-2">The drawings share one scale on this page{list.some((b) => b.form === 'disc') ? '. Flat round batteries are shown face on' : ''}.</p>
  </section>

  <section class="wrap mt-10">
    <h2 class="section-title">All {cat.name.toLowerCase()} at a glance</h2>
    <div class="card table-scroll">
      <table class="table min-w-[44rem]" data-sortable>
        <thead>
          <tr><th>Name</th><th class="n">Size (mm)</th><th class="n">Voltage</th><th class="n">Capacity</th><th>Kinds</th><th>Other names</th></tr>
        </thead>
        <tbody>
          {list.map((b) => {
            const pv = primaryVariant(b);
            return (
              <tr>
                <td class="font-semibold"><a href={`/${b.id}`} class="link">{b.name}</a></td>
                <td class="n">{sizeLabel(b, false)}</td>
                <td class="n">{voltsCell(b)}</td>
                <td class="n">{capacityLabel(pv).replace('–', ' to ') || '—'}</td>
                <td class="font-sans">{chemistryGroups(b).map((g) => chem(g.chem.id).plainName).join(', ')}</td>
                <td>{[...new Set(b.codes.map((c) => c.code))].filter((c) => c !== b.name).slice(0, 6).join(', ')}</td>
              </tr>
            );
          })}
        </tbody>
      </table>
    </div>
  </section>
</BaseLayout>
