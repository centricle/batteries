---
// 3D viewer for one battery or a lineup. Renders a static silhouette first
// (no JS, no WebGL, print), then swaps in three.js when scrolled into view.
// It never takes the page's scroll wheel or a vertical swipe; how, and why it
// is safe with OrbitControls, is in src/lib/viewer.ts.
//
// The control row sits under the stage, not on top of it, so large text and
// long kind names never cover the model.
import Silhouette from './Silhouette.astro';
import type { Battery } from '../lib/data';
import { chemistryById, modelSpec } from '../lib/data';

interface Props {
  batteries: Battery[];
  mode?: 'single' | 'lineup';
  class?: string;
  /** The row under the stage: kinds, Take apart, Spin, Reset, Full screen, zoom. */
  controls?: boolean;
  /** Drag to turn and nothing else (no zoom, no pan). On by default when there is no control row, as on the home and category lineups. */
  turnOnly?: boolean;
  /** Ignored. The GLB and STL downloads live under "Full specifications" on the battery page. */
  downloads?: boolean;
  height?: string;
  autoRotate?: boolean;
}
const { batteries, mode = batteries.length > 1 ? 'lineup' : 'single', class: cls = '', controls = true, turnOnly = !controls, height = '28rem', autoRotate } = Astro.props;
const specs = batteries.map(modelSpec);
const single = batteries.length === 1 ? batteries[0] : null;
const chems = specs[0]?.chemistries ?? [];
// The plain kind name ("Rechargeable (NiMH)") once the chemistry data has one.
// Up to three kinds are buttons; a size sold in more (an AA comes in eight)
// gets a list instead, so the kinds do not bury the model's own controls.
const kindName = (c: { id: string; short: string }) => ((chemistryById(c.id) as { plain_name?: string } | undefined)?.plain_name ?? c.short);
const names = batteries.map((b) => b.name);
const listed = names.length > 1 ? `${names.slice(0, -1).join(', ')} and ${names[names.length - 1]}` : names[0];
const zoomButtons = controls && !turnOnly;
const srText = `${single ? `3D model of the ${single.name} battery` : `3D models of the ${listed} batteries, side by side at the same scale`}, drawn from the published dimensions. Drag to turn.${zoomButtons ? ' Use the plus and minus buttons to zoom.' : ''}`;

// iOS AR Quick Look needs an anchor whose only child is an image, so the
// badge text is drawn into the image. textLength pins the width whatever
// system font renders it.
const arLabel = 'View in AR at actual size';
const arBadge = `<svg xmlns="http://www.w3.org/2000/svg" width="290" height="44" viewBox="0 0 290 44"><rect x="0.5" y="0.5" width="289" height="43" fill="#171b22" stroke="#f8f5f0" stroke-opacity="0.35"/><g fill="none" stroke="#f8f5f0" stroke-width="1.8" stroke-linejoin="round"><path d="M22 12l7 4v8l-7 4-7-4v-8z"/><path d="M15 16l7 4 7-4M22 20v8"/></g><text x="40" y="28" font-family="-apple-system,system-ui,Helvetica,Arial,sans-serif" font-size="17" font-weight="600" fill="#f8f5f0" textLength="236" lengthAdjust="spacingAndGlyphs">${arLabel}</text></svg>`;
---

<battery-viewer data-specs={JSON.stringify(specs)} data-mode={mode} data-turn-only={String(turnOnly)} data-autorotate={autoRotate === undefined ? '' : String(autoRotate)} class:list={['viewer block border border-line-2', cls]}>
  <div class="viewer-stage relative overflow-hidden" style={`height:${height}`}>
    <div class="viewer-fallback absolute inset-0 flex items-end justify-center gap-[3%] p-[8%]" aria-hidden="true">
      {batteries.map((b) => <Silhouette battery={b} class="h-full max-w-full" scaleTo={Math.max(...batteries.map((x) => x.form === 'disc' ? x.dimensions.diameter!.nominal : x.dimensions.height.nominal))} />)}
    </div>
    <div class="viewer-labels absolute inset-0 pointer-events-none" aria-hidden="true"></div>
    <p class="sr-only">{srText}</p>
    <div class="absolute top-2 left-3 right-3 flex flex-col items-start gap-2 no-print pointer-events-none">
      <p class="viewer-grid-note text-sm text-muted">Each square is 1 cm</p>
      {single && (
        <div class="pointer-events-auto" data-ar hidden>
          <a rel="ar" data-ar-ios hidden href={`/models/${single.id}.usdz#allowsContentScaling=0`} class="block">
            <img src={`data:image/svg+xml,${encodeURIComponent(arBadge)}`} width="290" height="44" alt={`View the ${single.name} battery in AR at actual size`} />
          </a>
          <a data-ar-android hidden class="btn btn-primary" href="#">{arLabel}</a>
        </div>
      )}
    </div>
  </div>

  {controls && (
    <div class="viewer-controls no-print flex flex-wrap items-center gap-x-3 gap-y-2 p-2 border-t border-line bg-surface">
      {single && chems.length > 1 && chems.length <= 3 && (
        <div class="flex flex-wrap gap-1.5" role="group" aria-label="Kind">
          {chems.map((c, i) => (
            <button type="button" class="btn btn-sm" data-chem={i} aria-pressed={i === 0 ? 'true' : 'false'}>
              <span class="dot" style={`background:${c.color}`}></span>{kindName(c)}
            </button>
          ))}
        </div>
      )}
      {single && chems.length > 3 && (
        <label class="flex items-center gap-2 min-w-0 max-w-full">
          <span class="label">Kind</span>
          <select class="viewer-kind min-w-0 max-w-full" data-chem-select>
            {chems.map((c, i) => <option value={i}>{kindName(c)}</option>)}
          </select>
        </label>
      )}
      <div class="ml-auto flex flex-wrap gap-1.5">
        <button type="button" class="btn btn-sm" data-act="explode" aria-pressed="false">Take apart</button>
        <button type="button" class="btn btn-sm" data-act="rotate" aria-pressed="true">Spin</button>
        <button type="button" class="btn btn-sm" data-act="reset">Reset</button>
        <button type="button" class="btn btn-sm" data-act="full">Full screen</button>
        {zoomButtons && (
          <span class="flex gap-1.5">
            <button type="button" class="btn btn-sm text-lg w-[2.25rem] px-0" data-act="zoom-in" aria-label="Zoom in">+</button>
            <button type="button" class="btn btn-sm text-lg w-[2.25rem] px-0" data-act="zoom-out" aria-label="Zoom out">−</button>
          </span>
        )}
      </div>
    </div>
  )}
</battery-viewer>

<style>
  /* In the components layer, so a page can still pass bg-transparent or
     border-0 as utilities. */
  @layer components {
    .viewer { background: var(--stage); }
  }
  battery-viewer[data-live] .viewer-fallback { opacity: 0; transition: opacity 0.4s; }
  /* The grid only exists once the 3D floor is drawn. */
  battery-viewer:not([data-live]) .viewer-grid-note { display: none; }
  battery-viewer:fullscreen { display: flex; flex-direction: column; width: 100%; height: 100%; border: 0; background: var(--stage); }
  battery-viewer:fullscreen .viewer-stage { flex: 1 1 auto; height: auto !important; }
  :global(.viewer-label) {
    position: absolute; transform: translate(-50%, 0);
    display: inline-flex; align-items: center;
    min-height: 2rem; padding: 0 0.5rem;
    font-family: var(--font-mono); font-size: 0.9rem; font-weight: 600; line-height: 1;
    color: var(--ink);
    background: var(--surface);
    border: 1px solid var(--line-2); border-radius: 0;
    white-space: nowrap; pointer-events: auto;
    text-decoration: underline; text-decoration-thickness: 1px; text-underline-offset: 0.18em;
    text-decoration-color: color-mix(in oklch, currentColor 40%, transparent);
  }
  :global(.viewer-label:hover) { border-color: var(--ink); text-decoration-color: currentColor; }
  .viewer-kind {
    min-height: 2rem; padding: 0.2rem 0.5rem;
    border: 1px solid var(--ink-2); border-radius: 0;
    background: var(--surface); color: var(--ink);
    font-family: var(--font-mono); font-size: 0.9rem;
  }
</style>

<script>
  const fullscreenEl = () => document.fullscreenElement ?? (document as any).webkitFullscreenElement ?? null;
  const canFullscreen = () => !!(document.fullscreenEnabled || (document as any).webkitFullscreenEnabled);

  class BatteryViewer extends HTMLElement {
    api: any;
    onFull?: () => void;
    /** Reveal "View in AR" on phones that can place the model at true scale. */
    setupAR() {
      const box = this.querySelector('[data-ar]') as HTMLElement | null;
      if (!box) return;
      const spec = JSON.parse(this.dataset.specs!)[0];
      const ios = (document.createElement('a').relList as DOMTokenList | undefined)?.supports?.('ar');
      if (ios) {
        (box.querySelector('[data-ar-ios]') as HTMLElement).hidden = false;
        box.hidden = false;
      } else if (/android/i.test(navigator.userAgent)) {
        const glb = new URL(`/models/${spec.id}.glb`, location.href).href;
        const params = `file=${encodeURIComponent(glb)}&mode=ar_preferred&resizable=false&title=${encodeURIComponent(spec.name)}`;
        const a = box.querySelector('[data-ar-android]') as HTMLAnchorElement;
        a.href = `intent://arvr.google.com/scene-viewer/1.2?${params}#Intent;scheme=https;package=com.google.android.googlequicksearchbox;action=android.intent.action.VIEW;S.browser_fallback_url=${encodeURIComponent(location.href)};end;`;
        a.hidden = false;
        box.hidden = false;
      }
    }

    /** iPhone Safari has no element full screen; hide the button there. */
    setupFullscreen() {
      const btn = this.querySelector('[data-act="full"]') as HTMLButtonElement | null;
      if (!btn) return;
      if (!canFullscreen()) {
        btn.hidden = true;
        return;
      }
      this.onFull = () => {
        btn.textContent = fullscreenEl() === this ? 'Exit full screen' : 'Full screen';
      };
      document.addEventListener('fullscreenchange', this.onFull);
      document.addEventListener('webkitfullscreenchange', this.onFull);
    }

    toggleFullscreen() {
      if (fullscreenEl()) (document.exitFullscreen ?? (document as any).webkitExitFullscreen)?.call(document);
      else (this.requestFullscreen ?? (this as any).webkitRequestFullscreen)?.call(this);
    }

    connectedCallback() {
      this.setupAR();
      this.setupFullscreen();
      const start = async () => {
        if (this.api) return;
        const canvas = document.createElement('canvas');
        const gl = canvas.getContext('webgl2');
        if (!gl) return; // keep the static silhouette
        const { mountViewer } = await import('../lib/viewer');
        const specs = JSON.parse(this.dataset.specs!);
        const mode = this.dataset.mode as 'single' | 'lineup';
        const stage = this.querySelector('.viewer-stage') as HTMLElement;
        const labelsEl = this.querySelector('.viewer-labels') as HTMLElement;
        const ar = this.dataset.autorotate;
        const labelEls = new Map<string, HTMLAnchorElement>();
        const host = document.createElement('div');
        host.className = 'absolute inset-0';
        stage.prepend(host);
        this.api = mountViewer(host, specs, {
          mode,
          autoRotate: ar === '' ? undefined : ar === 'true',
          turnOnly: this.dataset.turnOnly === 'true',
          onSpinStop: () => this.querySelector('[data-act="rotate"]')?.setAttribute('aria-pressed', 'false'),
          onLabels:
            mode === 'lineup'
              ? (labels) => {
                  for (const l of labels) {
                    let a = labelEls.get(l.id);
                    if (!a) {
                      a = document.createElement('a');
                      a.className = 'viewer-label';
                      a.href = `/${l.id}`;
                      a.textContent = l.name;
                      labelsEl.appendChild(a);
                      labelEls.set(l.id, a);
                    }
                    a.style.left = `${l.x}px`;
                    a.style.top = `${l.y}px`;
                    a.style.display = l.visible ? '' : 'none';
                  }
                }
              : undefined,
        });
        this.setAttribute('data-live', '');
        const fb = this.querySelector('.viewer-fallback') as HTMLElement | null;
        if (fb) fb.style.display = 'none';
        const rot = this.querySelector('[data-act="rotate"]');
        rot?.setAttribute('aria-pressed', String(mode === 'single' && ar !== 'false' && !matchMedia('(prefers-reduced-motion: reduce)').matches));
      };
      const io = new IntersectionObserver(
        (es) => {
          if (es.some((e) => e.isIntersecting)) {
            io.disconnect();
            start();
          }
        },
        { rootMargin: '200px' },
      );
      io.observe(this);

      this.querySelector('[data-chem-select]')?.addEventListener('change', (e) => {
        this.api?.setChemistry(Number((e.target as HTMLSelectElement).value));
      });
      this.addEventListener('click', (e) => {
        const b = (e.target as HTMLElement).closest('button');
        if (!b) return;
        const act = b.dataset.act;
        if (act === 'full') return this.toggleFullscreen();
        if (!this.api) return;
        if (b.dataset.chem) {
          this.querySelectorAll('[data-chem]').forEach((x) => x.setAttribute('aria-pressed', String(x === b)));
          this.api.setChemistry(Number(b.dataset.chem));
        }
        if (act === 'explode' || act === 'rotate') {
          const on = b.getAttribute('aria-pressed') !== 'true';
          b.setAttribute('aria-pressed', String(on));
          if (act === 'explode') this.api.setExplode(on);
          else this.api.setAutoRotate(on);
        }
        if (act === 'zoom-in' || act === 'zoom-out') this.api.zoom(act === 'zoom-in' ? 1 : -1);
        if (act === 'reset') this.api.reset();
      });
    }
    disconnectedCallback() {
      if (this.onFull) {
        document.removeEventListener('fullscreenchange', this.onFull);
        document.removeEventListener('webkitfullscreenchange', this.onFull);
      }
      this.api?.dispose();
    }
  }
  if (!customElements.get('battery-viewer')) customElements.define('battery-viewer', BatteryViewer);
</script>
